<?xml version="1.0" encoding="UTF-8"?>
<addon id="skin.mistuary" name="Mistuary" version="1.0.0" provider-name="wabisabi926">
	<requires>
		<import addon="xbmc.gui" version="5.17.0"/>
	</requires>
	<extension point="xbmc.gui.skin" debugging="false">
		<res width="1920" height="1440" aspect="4:3" default="false" folder="xml" />
		<res width="1920" height="1280" aspect="3:2" default="false" folder="xml" />
		<res width="1920" height="1200" aspect="16:10" default="false" folder="xml" />
		<res width="2040" height="1080" aspect="17:9" default="false" folder="xml" />
		<res width="1920" height="1080" aspect="16:9" default="true" folder="xml" />
		<res width="2560" height="1080" aspect="21:9" default="false" folder="xml" />
		<res width="2338" height="1080" aspect="19.5:9" default="false" folder="xml" />
		<res width="2160" height="1080" aspect="18:9" default="false" folder="xml" />
	</extension>
	<extension point="xbmc.addon.metadata">
		<platform>all</platform>
		<license>CC BY-SA 4.0, GNU GENERAL PUBLIC LICENSE Version 2.0, MIT</license>
		<forum>http://forum.kodi.tv/</forum>
		<source>https://github.com/wabisabi926/skin.mistuary</source>
		<assets>
			<icon>resources/icon.png</icon>
			<fanart>resources/fanart.jpg</fanart>
		</assets>
		<summary lang="zh">雾汐｜轻量透明皮肤，基于 Estuary，支持透黑、透白双模式</summary>
		<summary lang="en">Mistuary - Lightweight transparent skin based on Estuary, with dark &amp; light transparent mode</summary>
		<description lang="zh">简约透明UI，低资源占用，画面优先，内置透黑/透白主题切换</description>
		<description lang="en">Simple transparent UI, lightweight, video-first, built-in transparent dark / light theme switch</description>
		<disclaimer lang="en_GB">Weather, radio and game browsing surfaces are intentionally omitted. The original Estuary skin remains available as a fallback.</disclaimer>
		<disclaimer lang="zh_CN">本皮肤有意省略天气、电台和游戏浏览界面；原版 Estuary 仍可作为备用皮肤。</disclaimer>
	</extension>
</addon>
