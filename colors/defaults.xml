	<!-- 玻璃底色不再有固定别名：所有面板统一走下面的 gl_* 档位，
	     由「页面透明度 / 浮窗透明度 / 播放中透明度」三个设置驱动。 -->

	<!-- ===== 玻璃透明度档位（三个设置共用这一套 gl_*）=====
	     页面透明度   glass_page_op_1..6  → NaraGlassPageTintVar（+ NaraGlassScrimTintVar 遮蔽）
	     浮窗透明度   glass_float_op_1..6 → NaraGlassFloatTintVar
	     播放中透明度 glass_play_op_1..6  → NaraPlaybackDialogTintVar
	     面板 alpha 与遮蔽 alpha **联动**：档位越高面板越实、面板外也压得越重。

	     合成遮盖 = 1 − (1−scrim)·(1−panel)，括号里是设置里显示给用户的百分比：
	       档1  gl_1 32% + sc_1 19% = 45%   极透
	       档2  gl_2 45% + sc_2 27% = 60%   通透
	       档3  gl_3 58% + sc_3 35% = 73%   平衡（页面默认）
	       档4  gl_4 71% + sc_4 43% = 83%   偏实（浮窗默认）
	       档5  gl_5 84% + sc_5 50% = 92%   厚实
	       档6  gl_6 97% + sc_6 58% = 99%   实心
	     相邻档差 13 个点，能明确看出区别。
	     详见 docs/glass-opacity-plan.md -->
	<color name="gl_1">520F0F12</color>
	<color name="gl_2">730F0F12</color>
	<color name="gl_3">940F0F12</color>
	<color name="gl_4">B50F0F12</color>
	<color name="gl_5">D60F0F12</color>
	<color name="gl_6">F70F0F12</color>
	<color name="sc_1">30000000</color>
	<color name="sc_2">45000000</color>
	<color name="sc_3">59000000</color>
	<color name="sc_4">6E000000</color>
	<color name="sc_5">80000000</color>
	<color name="sc_6">94000000</color>

	<!-- ===== 浮窗遮蔽层（scrim）=====
	     与玻璃面板分工：scrim 管「底噪」（把底下的画面压到认不出），
	     玻璃面板管「质感」（中心实、边缘化开）。
	     实际生效的是上面的 sc_1..5 档位；下面这三个是固定用途 / 兼容别名。 -->
	<color name="scrim_dialog">99000000</color>
	<color name="scrim_sheet">8C000000</color>
	<color name="scrim_osd">4D000000</color>

	<!-- 文字底板：只垫在列表 / 长文本区，抬局部对比度（深色版） -->
	<color name="glass_plate">1F000000</color>

