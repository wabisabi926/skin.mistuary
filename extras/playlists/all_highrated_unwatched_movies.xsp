<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="movies">
    <name>High-rated unwatched movies</name>
    <match>all</match>
    <rule field="playcount" operator="is">
        <value>0</value>
    </rule>
    <rule field="rating" operator="between">
        <value>7</value>
        <value>10</value>
    </rule>
    <order direction="descending">rating</order>
</smartplaylist>
