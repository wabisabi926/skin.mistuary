<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="tvshows">
    <name>Recent TV premieres</name>
    <match>all</match>
    <rule field="numepisodes" operator="greaterthan">
        <value>0</value>
    </rule>
    <limit>21</limit>
    <order direction="descending">year</order>
</smartplaylist>
