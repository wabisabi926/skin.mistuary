	<!-- A 36px-high rounded surface reproduces the reference capsule without a dedicated asset.
	     Two buttons share the same surface: Kodi 22+ uses the $MAP lookup (friendly names),
	     Kodi 21 has no $MAP and falls back to the raw stream value. grouplist skips the hidden
	     one when laying out (GUIControlGroupList checks IsVisible), so only one capsule shows. -->
	<include name="NaraTechnicalTextPill">
		<param name="flag_visible">true</param>
		<param name="font">font_flag</param>
		<param name="flag_label_raw"></param>
		<definition>
			<control type="button">
				<width>auto</width>
				<height>36</height>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>14</textoffsetx>
				<font>$PARAM[font]</font>
				<textcolor>white</textcolor>
				<focusedcolor>white</focusedcolor>
				<disabledcolor>white</disabledcolor>
				<texturefocus colordiffuse="66000000" border="4">shapes/round4.png</texturefocus>
				<texturenofocus colordiffuse="66000000" border="4">shapes/round4.png</texturenofocus>
				<label>[B][UPPERCASE]$PARAM[flag_label][/UPPERCASE][/B]</label>
				<visible>$PARAM[flag_visible] + !$EXP[nara_kodi21]</visible>
			</control>
			<control type="button">
				<width>auto</width>
				<height>36</height>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>14</textoffsetx>
				<font>$PARAM[font]</font>
				<textcolor>white</textcolor>
				<focusedcolor>white</focusedcolor>
				<disabledcolor>white</disabledcolor>
				<texturefocus colordiffuse="66000000" border="4">shapes/round4.png</texturefocus>
				<texturenofocus colordiffuse="66000000" border="4">shapes/round4.png</texturenofocus>
				<label>[B][UPPERCASE]$PARAM[flag_label_raw][/UPPERCASE][/B]</label>
				<visible>$PARAM[flag_visible] + $EXP[nara_kodi21]</visible>
			</control>
		</definition>
	</include>

	<!-- 图标胶囊：与评分项同款底板。图标框 48×28 垂直居中（top 4），
	     可选小字跟在图标右侧，承载 Dolby Vision 的 P7/P8 档位。
	     小字用 font_flag(18px) —— font13 在本皮肤是 27px，"P7 MEL" 要 75px，
	     原来 24px 的宽度会把档位截成 "…"。
	     图标本体不做 colordiffuse 染色 —— 彩色版必须保住原色。 -->
	<include name="NaraTechnicalIconPill">
		<param name="flag_visible">true</param>
		<param name="icon"></param>
		<param name="detail"></param>
		<!-- 小字是否显示：必须用布尔参数，不能写 String.IsEmpty($PARAM[detail])。
		     detail 可能是 $MAP[...]，展开后条件里出现 [ ，Kodi 21 的表达式解析器
		     会在加载时报 "Misplaced ["（每部带杜比视界的片子刷两遍日志）。 -->
		<param name="detail_visible">false</param>
		<param name="detail_width">44</param>
		<param name="width">72</param>
		<definition>
			<control type="group">
				<width>$PARAM[width]</width>
				<height>36</height>
				<visible>$PARAM[flag_visible]</visible>
				<control type="image">
					<width>$PARAM[width]</width>
					<height>36</height>
					<texture border="4" colordiffuse="66000000">shapes/round4.png</texture>
				</control>
				<control type="image">
					<left>12</left>
					<top>4</top>
					<width>48</width>
					<height>28</height>
					<aspectratio>keep</aspectratio>
					<align>center</align>
					<aligny>center</aligny>
					<texture>techflags/color/$PARAM[icon].png</texture>
				</control>
				<control type="label">
					<left>64</left>
					<top>0</top>
					<width>$PARAM[detail_width]</width>
					<height>36</height>
					<font>font_flag</font>
					<align>left</align>
					<aligny>center</aligny>
					<textcolor>white</textcolor>
					<label>$PARAM[detail]</label>
					<visible>$PARAM[detail_visible]</visible>
				</control>
			</control>
		</definition>
	</include>

	<!-- 单个技术标识的唯一入口：有图标走图标，其余情况（Kodi 21 / 开关关闭 / 素材缺图）
	     走原来的文字胶囊。两条互斥，grouplist 会跳过隐藏的那条，不会占位。
	     素材缺图的判定就是 icon 参数为空 —— IconMap 里没有这个 key。 -->
	<include name="NaraTechnicalFlag">
		<param name="visible">true</param>
		<param name="icon"></param>
		<param name="label"></param>
		<param name="label_raw"></param>
		<param name="detail"></param>
		<param name="detail_visible">false</param>
		<param name="detail_width">44</param>
		<param name="width">72</param>
		<definition>
			<include content="NaraTechnicalIconPill">
				<param name="flag_visible" value="$PARAM[visible] + !Skin.HasSetting(hide_techflag_icons) + !$EXP[nara_kodi21]" />
				<param name="icon" value="$PARAM[icon]" />
				<param name="detail" value="$PARAM[detail]" />
			<param name="detail_visible" value="$PARAM[detail_visible]" />
				<param name="detail_width" value="$PARAM[detail_width]" />
				<param name="width" value="$PARAM[width]" />
			</include>
			<include content="NaraTechnicalTextPill">
				<param name="flag_visible" value="$PARAM[visible] + [Skin.HasSetting(hide_techflag_icons) | $EXP[nara_kodi21]]" />
				<param name="flag_label" value="$PARAM[label]" />
				<param name="flag_label_raw" value="$PARAM[label_raw]" />
			</include>
		</definition>
	</include>

	<!-- Dolby Vision detail stays attached to its HDR type in the same capsule. -->
	<include name="NaraTechnicalHdrPill">
		<param name="visible">true</param>
		<definition>
			<!-- 带档位分三档，宽度按实测字宽定，避免胶囊里空一大块：
			     ① P4~P9（2 字符，22px）      小字 24，胶囊 100
			     ② P10 / P8.1 / P8.2 / P8.4   小字 44，胶囊 120（40px 是 "P8.4"）
			     ③ P7 FEL / P7 MEL（59~64px） 小字 68，胶囊 144
			     未知档位落到②（宁可留白也不截断）。 -->
			<include content="NaraTechnicalFlag">
				<param name="visible" value="$PARAM[visible] + !String.IsEmpty($PARAM[hdr_type]) + String.IsEqual($PARAM[hdr_type],dolbyvision) + [String.IsEqual($PARAM[hdr_detail],4) | String.IsEqual($PARAM[hdr_detail],5) | String.IsEqual($PARAM[hdr_detail],6) | String.IsEqual($PARAM[hdr_detail],7) | String.IsEqual($PARAM[hdr_detail],8) | String.IsEqual($PARAM[hdr_detail],9)]" />
				<param name="icon" value="$MAP[NaraTechnicalHdrIconMap,$PARAM[hdr_type]]" />
				<param name="label" value="$MAP[NaraTechnicalHdrTextMap,$PARAM[hdr_type]]$MAP[NaraTechnicalDolbyVisionProfileTextMap,$PARAM[hdr_detail], ]" />
				<param name="label_raw" value="$INFO[$PARAM[hdr_type]]$INFO[$PARAM[hdr_detail], ]" />
				<param name="detail" value="$MAP[NaraTechnicalDolbyVisionProfileTextMap,$PARAM[hdr_detail]]" />
			<param name="detail_visible" value="!String.IsEmpty($PARAM[hdr_detail])" />
				<param name="detail_width" value="24" />
				<param name="width" value="100" />
			</include>
			<include content="NaraTechnicalFlag">
				<param name="visible" value="$PARAM[visible] + !String.IsEmpty($PARAM[hdr_type]) + String.IsEqual($PARAM[hdr_type],dolbyvision) + !String.IsEmpty($PARAM[hdr_detail]) + !String.IsEqual($PARAM[hdr_detail],4) + !String.IsEqual($PARAM[hdr_detail],5) + !String.IsEqual($PARAM[hdr_detail],6) + !String.IsEqual($PARAM[hdr_detail],7) + !String.IsEqual($PARAM[hdr_detail],8) + !String.IsEqual($PARAM[hdr_detail],9) + !String.IsEqual($PARAM[hdr_detail],7fel) + !String.IsEqual($PARAM[hdr_detail],7mel)" />
				<param name="icon" value="$MAP[NaraTechnicalHdrIconMap,$PARAM[hdr_type]]" />
				<param name="label" value="$MAP[NaraTechnicalHdrTextMap,$PARAM[hdr_type]]$MAP[NaraTechnicalDolbyVisionProfileTextMap,$PARAM[hdr_detail], ]" />
				<param name="label_raw" value="$INFO[$PARAM[hdr_type]]$INFO[$PARAM[hdr_detail], ]" />
				<param name="detail" value="$MAP[NaraTechnicalDolbyVisionProfileTextMap,$PARAM[hdr_detail]]" />
			<param name="detail_visible" value="!String.IsEmpty($PARAM[hdr_detail])" />
				<param name="detail_width" value="44" />
				<param name="width" value="120" />
			</include>
			<include content="NaraTechnicalFlag">
				<param name="visible" value="$PARAM[visible] + !String.IsEmpty($PARAM[hdr_type]) + String.IsEqual($PARAM[hdr_type],dolbyvision) + [String.IsEqual($PARAM[hdr_detail],7fel) | String.IsEqual($PARAM[hdr_detail],7mel)]" />
				<param name="icon" value="$MAP[NaraTechnicalHdrIconMap,$PARAM[hdr_type]]" />
				<param name="label" value="$MAP[NaraTechnicalHdrTextMap,$PARAM[hdr_type]]$MAP[NaraTechnicalDolbyVisionProfileTextMap,$PARAM[hdr_detail], ]" />
				<param name="label_raw" value="$INFO[$PARAM[hdr_type]]$INFO[$PARAM[hdr_detail], ]" />
				<param name="detail" value="$MAP[NaraTechnicalDolbyVisionProfileTextMap,$PARAM[hdr_detail]]" />
			<param name="detail_visible" value="!String.IsEmpty($PARAM[hdr_detail])" />
				<param name="detail_width" value="68" />
				<param name="width" value="144" />
			</include>
			<include content="NaraTechnicalFlag">
				<param name="visible" value="$PARAM[visible] + !String.IsEmpty($PARAM[hdr_type]) + [!String.IsEqual($PARAM[hdr_type],dolbyvision) | String.IsEmpty($PARAM[hdr_detail])]" />
				<param name="icon" value="$MAP[NaraTechnicalHdrIconMap,$PARAM[hdr_type]]" />
				<param name="label" value="$MAP[NaraTechnicalHdrTextMap,$PARAM[hdr_type]]" />
				<param name="label_raw" value="$INFO[$PARAM[hdr_type]]" />
			</include>
		</definition>
	</include>

	<!-- Value-source-independent content. The public row selects either the item's real stream
	     labels or the TV show's transient S01E01 properties inside the shared component. -->
	<include name="VideoTechnicalFlagsContent">
		<param name="visible">true</param>
		<definition>
			<include content="NaraTechnicalFlag">
				<param name="visible" value="$PARAM[visible] + !String.IsEmpty($PARAM[resolution])" />
				<param name="icon" value="$MAP[NaraTechnicalResolutionIconMap,$PARAM[resolution]]" />
				<param name="label" value="$MAP[NaraTechnicalResolutionTextMap,$PARAM[resolution]]" />
				<param name="label_raw" value="$INFO[$PARAM[resolution]]" />
			</include>

			<!-- Primary HDR: prefer stream 1, then the base value, then stream 2. -->
			<include content="NaraTechnicalHdrPill">
				<param name="visible" value="$PARAM[visible] + !String.IsEmpty($PARAM[hdr_type_1])" />
				<param name="hdr_type" value="$PARAM[hdr_type_1]" />
				<param name="hdr_detail" value="$PARAM[hdr_detail_1]" />
			</include>
			<include content="NaraTechnicalHdrPill">
				<param name="visible" value="$PARAM[visible] + String.IsEmpty($PARAM[hdr_type_1]) + !String.IsEmpty($PARAM[hdr_type])" />
				<param name="hdr_type" value="$PARAM[hdr_type]" />
				<param name="hdr_detail" value="$PARAM[hdr_detail]" />
			</include>
			<include content="NaraTechnicalHdrPill">
				<param name="visible" value="$PARAM[visible] + String.IsEmpty($PARAM[hdr_type_1]) + String.IsEmpty($PARAM[hdr_type]) + !String.IsEmpty($PARAM[hdr_type_2])" />
				<param name="hdr_type" value="$PARAM[hdr_type_2]" />
				<param name="hdr_detail" value="$PARAM[hdr_detail_2]" />
			</include>

			<!-- A distinct second HDR type remains an independent capsule. -->
			<include content="NaraTechnicalHdrPill">
				<param name="visible" value="$PARAM[visible] + !String.IsEmpty($PARAM[hdr_type_1]) + !String.IsEmpty($PARAM[hdr_type_2]) + !String.IsEqual($PARAM[hdr_type_1],$PARAM[hdr_type_2])" />
				<param name="hdr_type" value="$PARAM[hdr_type_2]" />
				<param name="hdr_detail" value="$PARAM[hdr_detail_2]" />
			</include>
			<include content="NaraTechnicalHdrPill">
				<param name="visible" value="$PARAM[visible] + String.IsEmpty($PARAM[hdr_type_1]) + !String.IsEmpty($PARAM[hdr_type]) + !String.IsEmpty($PARAM[hdr_type_2]) + !String.IsEqual($PARAM[hdr_type],$PARAM[hdr_type_2])" />
				<param name="hdr_type" value="$PARAM[hdr_type_2]" />
				<param name="hdr_detail" value="$PARAM[hdr_detail_2]" />
			</include>

			<include content="NaraTechnicalFlag">
				<param name="visible" value="$PARAM[visible] + !String.IsEmpty($PARAM[video_codec])" />
				<param name="icon" value="$MAP[NaraTechnicalVideoCodecIconMap,$PARAM[video_codec]]" />
				<param name="label" value="$MAP[NaraTechnicalVideoCodecTextMap,$PARAM[video_codec]]" />
				<param name="label_raw" value="$INFO[$PARAM[video_codec]]" />
			</include>
			<include content="NaraTechnicalFlag">
				<param name="visible" value="$PARAM[visible] + !String.IsEmpty($PARAM[audio_codec])" />
				<param name="icon" value="$MAP[NaraTechnicalAudioCodecIconMap,$PARAM[audio_codec]]" />
				<param name="label" value="$MAP[NaraTechnicalAudioCodecTextMap,$PARAM[audio_codec]]" />
				<param name="label_raw" value="$INFO[$PARAM[audio_codec]]" />
			</include>
			<!-- Atmos 叠加徽章：fuse3 同款做法 —— AudioCodec 里出现 atmos 就多一枚。
			     truehd_atmos / eac3_ddp_atmos 的编码图标本身已印着 ATMOS，这两种不再重复叠加。 -->
			<include content="NaraTechnicalFlag">
				<param name="visible" value="$PARAM[visible] + String.Contains($PARAM[audio_codec],atmos) + !String.IsEqual($PARAM[audio_codec],truehd_atmos) + !String.IsEqual($PARAM[audio_codec],eac3_ddp_atmos)" />
				<param name="icon" value="audio/atmos" />
				<param name="label" value="ATMOS" />
				<param name="label_raw" value="ATMOS" />
			</include>
			<!-- Language is intentionally omitted.
			     声道只用文字，不做图标：素材按声道数命名，而 5.1.2 与 7.1 都是 8 声道、
			     5.1.4 与 7.1.2 都是 10 声道，图标必然说谎。文字如实反映 Kodi 报的布局串。 -->
			<include content="NaraTechnicalTextPill">
				<param name="flag_visible" value="$PARAM[visible] + !String.IsEmpty($PARAM[audio_channels])" />
				<param name="flag_label" value="$INFO[$PARAM[audio_channels]]" />
				<param name="font" value="font13" />
			</include>
		</definition>
	</include>

	<!-- Public shared component. Callers only identify the item source and placement; source
	     selection, aliases, dual HDR, Dolby Vision detail and missing-value compaction stay here. -->
	<!-- 按 item 前缀取流信息。电影/单集用条目本身的流标签；
	     剧集（show 层级）本身没有流信息。详情页例外：它把分集货架 5101 的第一集
	     作为 item_prefix 传进来，走条目自己的流标签。搜索/首页的 show 行仍只能读
	     TvShowRepresentative.* 属性 —— 目前没有组件写这组属性（皮肤里没有，
	     Emby for Kodi 也不写），所以这些行实际不显示技术标识；分支保留给脚本方案。 -->
	<include name="VideoTechnicalFlagsByPrefix">
		<param name="visible">true</param>
		<param name="item_prefix">ListItem</param>
		<definition>
			<include content="VideoTechnicalFlagsContent">
				<param name="visible" value="$PARAM[visible] + !String.IsEqual($PARAM[item_prefix].DBType,tvshow)" />
				<param name="resolution" value="$PARAM[item_prefix].VideoResolution" />
				<param name="hdr_type" value="$PARAM[item_prefix].HdrType" />
				<param name="hdr_detail" value="$PARAM[item_prefix].HdrDetail" />
				<param name="hdr_type_1" value="$PARAM[item_prefix].Property(HdrType.1)" />
				<param name="hdr_detail_1" value="$PARAM[item_prefix].Property(HdrDetail.1)" />
				<param name="hdr_type_2" value="$PARAM[item_prefix].Property(HdrType.2)" />
				<param name="hdr_detail_2" value="$PARAM[item_prefix].Property(HdrDetail.2)" />
				<param name="video_codec" value="$PARAM[item_prefix].VideoCodec" />
				<param name="audio_codec" value="$PARAM[item_prefix].AudioCodec" />
				<param name="audio_channels" value="$PARAM[item_prefix].AudioChannels(DefaultLayout)" />
			</include>

			<include content="VideoTechnicalFlagsContent">
				<param name="visible" value="$PARAM[visible] + String.IsEqual($PARAM[item_prefix].DBType,tvshow)" />
				<param name="resolution" value="$PARAM[item_prefix].Property(TvShowRepresentative.VideoResolution)" />
				<param name="hdr_type" value="$PARAM[item_prefix].Property(TvShowRepresentative.HdrType)" />
				<param name="hdr_detail" value="$PARAM[item_prefix].Property(TvShowRepresentative.HdrDetail)" />
				<param name="hdr_type_1" value="$PARAM[item_prefix].Property(TvShowRepresentative.HdrType.1)" />
				<param name="hdr_detail_1" value="$PARAM[item_prefix].Property(TvShowRepresentative.HdrDetail.1)" />
				<param name="hdr_type_2" value="$PARAM[item_prefix].Property(TvShowRepresentative.HdrType.2)" />
				<param name="hdr_detail_2" value="$PARAM[item_prefix].Property(TvShowRepresentative.HdrDetail.2)" />
				<param name="video_codec" value="$PARAM[item_prefix].Property(TvShowRepresentative.VideoCodec)" />
				<param name="audio_codec" value="$PARAM[item_prefix].Property(TvShowRepresentative.AudioCodec)" />
				<param name="audio_channels" value="$PARAM[item_prefix].Property(TvShowRepresentative.AudioChannels)" />
			</include>
		</definition>
	</include>


</includes>
