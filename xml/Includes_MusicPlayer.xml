<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<variable name="NaraMusicCoverVar">
		<!-- 原来读 Window(visualisation).Property(NaraMusic.Cover)，但全皮肤没有任何地方写这个属性，
		     所以专辑图永远拿不到、永远显示占位图。改用 Kodi 原生的 Player.Art(thumb)。
		     注意：没有专辑图时 Kodi 返回的是它自带的 DefaultAlbumCover.png（**完整路径**，
		     不是空串），所以要先判结尾，否则显示的是那个白色唱片图标而不是皮肤兜底图。 -->
		<value condition="String.EndsWith(Player.Art(thumb),DefaultAlbumCover.png)">osd/nara/music-cover.png</value>
		<value condition="!String.IsEmpty(Player.Art(thumb))">$INFO[Player.Art(thumb)]</value>
		<value>osd/nara/music-cover.png</value>
	</variable>
	<variable name="NaraMusicAlbumYearVar">
		<value condition="String.IsEmpty(MusicPlayer.Album)">$INFO[MusicPlayer.Year]</value>
		<value>$INFO[MusicPlayer.Album]$INFO[MusicPlayer.Year, · ]</value>
	</variable>
	<variable name="NaraMusicNextHeadingVar">
