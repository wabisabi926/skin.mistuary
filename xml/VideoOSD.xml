<?xml version="1.0" encoding="utf-8"?>
<window>
	<onload condition="!Player.PauseEnabled">SetFocus(603)</onload>
	<defaultcontrol always="true">602</defaultcontrol>
	<depth>DepthOSD</depth>
	<controls>
		<control type="button">
			<description>background close area</description>
			<oninfo condition="!VideoPlayer.Content(LiveTV)">ActivateWindow(playerprocessinfo)</oninfo>
			<left>0</left>
			<top>0</top>
			<width>100%</width>
			<bottom>142</bottom>
			<texturefocus />
			<texturenofocus />
			<onclick>Action(close)</onclick>
		</control>
		<include>VideoOSDHeader</include>
		<control type="group">
			<include>Animation_BottomSlide</include>
			<bottom>0</bottom>
			<height>160</height>
			<visible>![Window.IsVisible(SliderDialog) | Window.IsVisible(1110) | Window.IsVisible(osdaudiosettings) | Window.IsVisible(osdvideosettings) | Window.IsVisible(VideoBookmarks) | Window.IsVisible(playerprocessinfo) | Window.IsVisible(osdcmssettings) | Window.IsVisible(PVROSDChannels) | Window.IsVisible(pvrchannelguide)]</visible>
			<animation effect="fade" time="200">VisibleChange</animation>
			<!-- 原来是一条实心深色横条；改成和音乐播放条一样的自下而上渐变压暗，
			     只压底部 220px，画面亮的时候也不会有硬边。 -->
			<control type="image">
				<left>0</left>
				<right>0</right>
				<bottom>0</bottom>
				<height>220</height>
				<texture colordiffuse="99000000">overlays/overlayfade.png</texture>
			</control>
			<control type="label">
				<left>80</left>
				<top>34</top>
				<width>130</width>
				<height>32</height>
				<font>font24</font>
				<aligny>center</aligny>
				<label>$VAR[NaraOSDTimeLabelVar]</label>
				<visible>!VideoPlayer.Content(LiveTV)</visible>
			</control>
			<control type="label">
				<right>80</right>
				<top>34</top>
				<width>130</width>
				<height>32</height>
				<font>font24</font>
				<align>right</align>
				<aligny>center</aligny>
				<label>$INFO[Player.Duration]</label>
				<visible>!VideoPlayer.Content(LiveTV)</visible>
			</control>
			<!-- 播放中的标题：进度条上方左侧，与顶部 logo 分开 -->
			<control type="label">
				<left>80</left>
				<bottom>208</bottom>
				<width>1400</width>
				<height>40</height>
				<font>font30_title</font>
				<scroll>true</scroll>
				<label>$VAR[NaraOSDPlayingTitleVar]</label>
				<visible>!VideoPlayer.Content(livetv)</visible>
			</control>
			<control type="label">
				<left>80</left>
				<top>68</top>
				<width>300</width>
				<height>56</height>
				<font>font24</font>
				<align>left</align>
				<aligny>center</aligny>
				<label>$LOCALIZE[31080] $INFO[Player.FinishTime]</label>
				<textcolor>text_secondary</textcolor>
				<visible>!Player.Paused + !VideoPlayer.Content(livetv) + Integer.IsGreater(Player.Duration(secs),0)</visible>
			</control>
			<control type="group" id="200">
				<include>Animation_BottomSlide</include>
        <!-- 主控组：上一章 / 播放 / 下一章 / 停止，屏幕居中 -->
        <control type="grouplist" id="201">
          <left>0</left>
          <right>0</right>
          <align>center</align>
          <itemgap>48</itemgap>
          <top>68</top>
          <height>56</height>
          <orientation>horizontal</orientation>
          <onup>87</onup>
          <ondown condition="Integer.IsGreater(Playlist.Length(video),1) + !VideoPlayer.Content(livetv)">Nara.OSDPlaylistShelf</ondown>
          <ondown condition="!Integer.IsGreater(Playlist.Length(video),1) | VideoPlayer.Content(livetv)">noop</ondown>
          <onleft>87</onleft>
          <onright>70046</onright>
					<control type="radiobutton" id="600">
						<include content="NaraVideoOSDButton">
							<param name="texture" value="osd/nara/previous.png"/>
						</include>
						<onclick>PlayerControl(Previous)</onclick>
						<visible>Player.HasSceneMarkers | Player.ChapterCount | Integer.IsGreater(Playlist.Length(video),1) | [Player.SeekEnabled + VideoPlayer.Content(livetv)]</visible>
					</control>
					<control type="radiobutton" id="602">
						<include>NaraVideoOSDPlayButton</include>
						<selected>Player.Paused</selected>
						<onclick>PlayerControl(Play)</onclick>
						<visible>Player.PauseEnabled</visible>
					</control>
					<control type="radiobutton" id="607">
						<include content="NaraVideoOSDButton">
							<param name="texture" value="osd/nara/next.png"/>
						</include>
						<onclick>PlayerControl(Next)</onclick>
						<visible>Player.HasSceneMarkers | Player.ChapterCount | Integer.IsGreater(Playlist.Length(video),1) | PVR.IsTimeShift</visible>
					</control>
					<control type="radiobutton" id="603">
						<include content="NaraVideoOSDButton">
							<param name="texture" value="osd/nara/stop.png"/>
						</include>
						<onclick>PlayerControl(Stop)</onclick>
					</control>
        </control>

        <!-- 功能组：音频/字幕/列表/书签/信息/设置/菜单/频道/EPG/录制/图文/3D，靠右 -->
        <control type="grouplist" id="202">
          <right>80</right>
          <width>800</width>
          <align>right</align>
          <itemgap>16</itemgap>
          <top>68</top>
          <height>56</height>
          <orientation>horizontal</orientation>
          <onup>87</onup>
          <ondown condition="Integer.IsGreater(Playlist.Length(video),1) + !VideoPlayer.Content(livetv)">Nara.OSDPlaylistShelf</ondown>
          <ondown condition="!Integer.IsGreater(Playlist.Length(video),1) | VideoPlayer.Content(livetv)">noop</ondown>
          <onleft>603</onleft>
          <onright>70046</onright>
					<control type="radiobutton" id="70046">
						<include content="NaraVideoOSDButton">
							<param name="texture" value="osd/nara/audio.png"/>
						</include>
						<onclick>DialogSelectAudio</onclick>
						<enable>Integer.IsGreater(VideoPlayer.AudioStreamCount,1)</enable>
					</control>
					<control type="radiobutton" id="70043">
						<include content="NaraVideoOSDButton">
							<param name="texture" value="osd/nara/subtitles.png"/>
						</include>
						<onclick>DialogSelectSubtitle</onclick>
						<enable>VideoPlayer.HasSubtitles</enable>
					</control>
					<control type="radiobutton" id="70042">
						<include content="NaraVideoOSDButton">
							<param name="texture" value="osd/nara/playlist.png"/>
						</include>
						<label>$LOCALIZE[559]</label>
						<onclick>ActivateWindow(1112)</onclick>
						<visible>Integer.IsGreater(Playlist.Length(video),1)</visible>
					</control>
					<control type="radiobutton" id="70044">
						<include content="NaraVideoOSDButton">
							<param name="texture" value="osd/nara/bookmark.png"/>
						</include>
						<onclick>ActivateWindow(videobookmarks)</onclick>
						<visible>!VideoPlayer.Content(livetv)</visible>
					</control>
					<control type="radiobutton" id="70049">
						<include content="NaraVideoOSDButton">
							<param name="texture" value="osd/nara/process-info.png"/>
						</include>
						<onclick>ActivateWindow(playerprocessinfo)</onclick>
					</control>
					<control type="radiobutton" id="70048">
						<include content="NaraVideoOSDButton">
							<param name="texture" value="osd/nara/settings.png"/>
						</include>
						<onclick>SetProperty(settingsdialog_content,videosettings,home)</onclick>
						<onclick>SetProperty(settingsdialog_header,$LOCALIZE[5],home)</onclick>
						<onclick>ActivateWindow(1101)</onclick>
					</control>
					<control type="radiobutton" id="804">
						<include content="NaraVideoOSDButton">
							<param name="texture" value="osd/nara/disc-menu.png"/>
						</include>
						<onclick>PlayerControl(ShowVideoMenu)</onclick>
						<visible>VideoPlayer.HasMenu</visible>
					</control>
					<control type="radiobutton" id="70040">
						<include content="NaraVideoOSDButton">
							<param name="texture" value="osd/nara/channels.png"/>
						</include>
						<onclick>Dialog.Close(VideoOSD)</onclick>
						<onclick>ActivateWindow(PVROSDChannels)</onclick>
						<visible>VideoPlayer.Content(livetv)</visible>
					</control>
					<control type="radiobutton" id="70041">
						<include content="NaraVideoOSDButton">
							<param name="texture" value="osd/nara/guide.png"/>
						</include>
						<onclick>Dialog.Close(VideoOSD)</onclick>
						<onclick>ActivateWindow(pvrchannelguide)</onclick>
						<visible>VideoPlayer.Content(livetv) + VideoPlayer.HasEPG</visible>
					</control>
					<control type="radiobutton" id="608">
						<include content="NaraVideoOSDButton">
							<param name="texture" value="osd/nara/record.png"/>
						</include>
						<selected>!PVR.IsRecordingPlayingChannel</selected>
						<onclick>PVR.ToggleRecordPlayingChannel</onclick>
						<visible>PVR.CanRecordPlayingChannel</visible>
						<visible>VideoPlayer.Content(livetv)</visible>
					</control>
					<control type="radiobutton" id="70045">
						<include content="NaraVideoOSDButton">
							<param name="texture" value="osd/nara/teletext.png"/>
						</include>
						<onclick>Dialog.Close(VideoOSD)</onclick>
						<onclick>ActivateWindow(Teletext)</onclick>
						<visible>VideoPlayer.HasTeletext</visible>
					</control>
					<control type="radiobutton" id="70047">
						<include content="NaraVideoOSDButton">
							<param name="texture" value="osd/nara/stereoscopic.png"/>
						</include>
						<visible>VideoPlayer.IsStereoscopic</visible>
						<onclick>SetProperty(settingsdialog_content,3d,home)</onclick>
						<onclick>SetProperty(settingsdialog_header,$LOCALIZE[36501],home)</onclick>
						<onclick>ActivateWindow(1101)</onclick>
					</control>
        </control>
			</control>
			<control type="group" id="6000">
				<left>200</left>
				<right>200</right>
				<top>42</top>
				<animation type="WindowOpen" condition="!Window.IsVisible(fullscreeninfo)" reversible="false">
					<effect type="fade" start="0" end="100" time="300"/>
					<effect type="slide" start="0,200" end="0,0" time="300" tween="cubic" easing="out" />
				</animation>
				<animation type="WindowClose" condition="!Window.IsVisible(fullscreeninfo)" reversible="false">
					<effect type="fade" start="100" end="0" time="300"/>
					<effect type="slide" start="0,0" end="0,200" time="300" tween="cubic" easing="out" />
				</animation>
				<animation type="WindowOpen" condition="Window.IsVisible(fullscreeninfo)" reversible="false">
					<effect type="fade" start="0" end="100" time="300"/>
				</animation>
				<animation type="WindowClose" condition="Window.IsVisible(fullscreeninfo)" reversible="false">
					<effect type="fade" start="100" end="0" time="300"/>
				</animation>
				<visible>Player.SeekEnabled</visible>
				<control type="image">
					<left>0</left>
					<right>0</right>
					<top>7</top>
					<height>3</height>
					<texture colordiffuse="40FFFFFF">colors/white.png</texture>
				</control>
				<control type="progress">
					<left>0</left>
					<right>0</right>
					<top>7</top>
					<height>3</height>
					<info>Player.Progress</info>
					<texturebg colordiffuse="00FFFFFF">colors/white.png</texturebg>
					<lefttexture />
					<midtexture colordiffuse="90FFFFFF">colors/white.png</midtexture>
					<righttexture />
					<visible>!Control.HasFocus(87) + !VideoPlayer.Content(LiveTV) + !Player.Seeking</visible>
				</control>
				<control type="progress">
					<left>0</left>
					<right>0</right>
					<top>7</top>
					<height>3</height>
					<info>Player.Progress</info>
					<texturebg colordiffuse="00FFFFFF">colors/white.png</texturebg>
					<lefttexture />
					<midtexture colordiffuse="FFFFFFFF">colors/white.png</midtexture>
					<righttexture />
					<visible>Control.HasFocus(87) + !VideoPlayer.Content(LiveTV) + !Player.Seeking</visible>
				</control>
				<control type="progress">
					<left>0</left>
					<right>0</right>
					<top>7</top>
					<height>3</height>
					<info>Player.SeekBar</info>
					<texturebg colordiffuse="00FFFFFF">colors/white.png</texturebg>
					<lefttexture />
					<midtexture colordiffuse="FFFFFFFF">colors/white.png</midtexture>
					<righttexture />
					<visible>Player.Seeking + !VideoPlayer.Content(LiveTV)</visible>
				</control>
				<control type="progress">
					<left>0</left>
					<right>0</right>
					<top>7</top>
					<height>3</height>
					<info>PVR.TimeshiftProgressPlayPos</info>
					<texturebg colordiffuse="00FFFFFF">colors/white.png</texturebg>
					<lefttexture />
					<midtexture colordiffuse="90FFFFFF">colors/white.png</midtexture>
					<righttexture />
					<visible>!Control.HasFocus(87) + VideoPlayer.Content(LiveTV)</visible>
				</control>
				<control type="progress">
					<left>0</left>
					<right>0</right>
					<top>7</top>
					<height>3</height>
					<info>PVR.TimeshiftProgressPlayPos</info>
					<texturebg colordiffuse="00FFFFFF">colors/white.png</texturebg>
					<lefttexture />
					<midtexture colordiffuse="FFFFFFFF">colors/white.png</midtexture>
					<righttexture />
					<visible>Control.HasFocus(87) + VideoPlayer.Content(LiveTV)</visible>
				</control>
				<control type="progress">
					<left>-32</left>
					<right>-32</right>
					<top>-24</top>
					<height>64</height>
					<info>Player.Progress</info>
					<texturebg colordiffuse="00FFFFFF">osd/nara/progress-nib-track.png</texturebg>
					<lefttexture />
					<midtexture />
					<righttexture colordiffuse="FF8C8C8C">osd/nara/progress-nib.png</righttexture>
					<visible>!Control.HasFocus(87) + !VideoPlayer.Content(LiveTV) + !Player.Seeking</visible>
				</control>
				<control type="progress">
					<left>-32</left>
					<right>-32</right>
					<top>-24</top>
					<height>64</height>
					<info>Player.Progress</info>
					<texturebg colordiffuse="00FFFFFF">osd/nara/progress-nib-track.png</texturebg>
					<lefttexture />
					<midtexture />
					<righttexture colordiffuse="FFFFFFFF">osd/nara/progress-nib.png</righttexture>
					<visible>Control.HasFocus(87) + !VideoPlayer.Content(LiveTV) + !Player.Seeking</visible>
				</control>
				<control type="progress">
					<left>-32</left>
					<right>-32</right>
					<top>-24</top>
					<height>64</height>
					<info>Player.SeekBar</info>
					<texturebg colordiffuse="00FFFFFF">osd/nara/progress-nib-track.png</texturebg>
					<lefttexture />
					<midtexture />
					<righttexture colordiffuse="FFFFFFFF">osd/nara/progress-nib.png</righttexture>
					<visible>Player.Seeking + !VideoPlayer.Content(LiveTV)</visible>
				</control>
				<control type="progress">
					<left>-32</left>
					<right>-32</right>
					<top>-24</top>
					<height>64</height>
					<info>PVR.TimeshiftProgressPlayPos</info>
					<texturebg colordiffuse="00FFFFFF">osd/nara/progress-nib-track.png</texturebg>
					<lefttexture />
					<midtexture />
					<righttexture colordiffuse="FF8C8C8C">osd/nara/progress-nib.png</righttexture>
					<visible>!Control.HasFocus(87) + VideoPlayer.Content(LiveTV)</visible>
				</control>
				<control type="progress">
					<left>-32</left>
					<right>-32</right>
					<top>-24</top>
					<height>64</height>
					<info>PVR.TimeshiftProgressPlayPos</info>
					<texturebg colordiffuse="00FFFFFF">osd/nara/progress-nib-track.png</texturebg>
					<lefttexture />
					<midtexture />
					<righttexture colordiffuse="FFFFFFFF">osd/nara/progress-nib.png</righttexture>
					<visible>Control.HasFocus(87) + VideoPlayer.Content(LiveTV)</visible>
				</control>
				<control type="button" id="87">
					<include>HiddenObject</include>
					<oninfo condition="!VideoPlayer.Content(LiveTV)">ActivateWindow(playerprocessinfo)</oninfo>
					<onup>200</onup>
					<ondown>200</ondown>
					<onleft>StepBack</onleft>
					<onright condition="!Player.Paused">StepForward</onright>
					<onright condition="Player.Paused">PlayerControl(FrameAdvance(1))</onright>
				</control>
				<control type="slider">
					<top>-5</top>
					<left>0</left>
					<width>100%</width>
					<height>26</height>
					<texturesliderbar colordiffuse="00FFFFFF">osd/progress/nub_leftright.png</texturesliderbar>
					<textureslidernib />
					<textureslidernibfocus />
					<info>Player.Progress</info>
					<onup>200</onup>
					<ondown>200</ondown>
					<oninfo>ActivateWindow(playerprocessinfo)</oninfo>
					<action>seek</action>
					<visible>!VideoPlayer.Content(LiveTV)</visible>
				</control>
				<control type="slider">
					<top>-5</top>
					<left>0</left>
					<width>100%</width>
					<height>26</height>
					<texturesliderbar colordiffuse="00FFFFFF">osd/progress/nub_leftright.png</texturesliderbar>
					<textureslidernib />
					<textureslidernibfocus />
					<info>PVR.TimeshiftProgressPlayPos</info>
					<onup>200</onup>
					<ondown>200</ondown>
					<action>pvr.seek</action>
					<visible>VideoPlayer.Content(LiveTV)</visible>
				</control>
			</control>
		</control>
	</controls>
</window>
