		<value condition="String.IsEqual(Window(home).Property(Home.Section),movies) + String.IsEqual(Window(home).Property(Home.movies.Hero),5100)">$INFO[Container(5100).ListItem.Art(fanart)]</value>
		<value condition="String.IsEqual(Window(home).Property(Home.Section),movies) + String.IsEqual(Window(home).Property(Home.movies.Hero),5200) + String.IsEqual(Container(5200).ListItem.Property(node.type),target_folder)">$INFO[Container(5200).ListItem(-1).Art(fanart)]</value>
		<value condition="String.IsEqual(Window(home).Property(Home.Section),movies) + String.IsEqual(Window(home).Property(Home.movies.Hero),5200)">$INFO[Container(5200).ListItem.Art(fanart)]</value>
