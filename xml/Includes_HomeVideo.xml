<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<variable name="HomeVideoPosterFocusColorVar">
		<value condition="String.IsEmpty(ListItem.Art(poster))">focus_card_surface</value>
		<value>focus_media</value>
	</variable>
	<expression name="NaraHomeMovieLibrariesVisible">System.AddonIsEnabled(plugin.service.emby-next-gen) + [Integer.IsGreater(Container(5700).NumItems,0) | Container(5700).IsUpdating]</expression>
	<expression name="NaraHomeTVShowLibrariesVisible">System.AddonIsEnabled(plugin.service.emby-next-gen) + [Integer.IsGreater(Container(6600).NumItems,0) | Container(6600).IsUpdating]</expression>
	<expression name="NaraHomeVideoSingleRow">[String.IsEqual(Window(home).Property(Home.Section),movies) + [String.IsEmpty(Window(home).Property(Home.movies.Page)) | String.IsEqual(Window(home).Property(Home.movies.Page),first)] + !$EXP[NaraHomeMovieLibrariesVisible]] | [String.IsEqual(Window(home).Property(Home.Section),tvshows) + [String.IsEmpty(Window(home).Property(Home.tvshows.Page)) | String.IsEqual(Window(home).Property(Home.tvshows.Page),first)] + !$EXP[NaraHomeTVShowLibrariesVisible]]</expression>
	<expression name="NaraHomeVideoExpanded">$EXP[NaraHomeVideoSingleRow] | [String.IsEqual(Window(home).Property(Home.Section),movies) + String.IsEqual(Window(home).Property(Home.movies.Page),poster)] | [String.IsEqual(Window(home).Property(Home.Section),tvshows) + String.IsEqual(Window(home).Property(Home.tvshows.Page),poster)]</expression>
	<include name="HomeVideoPage">
		<param name="always_first_row">false</param>
		<definition>
			<control type="group" id="$PARAM[id]">
				<height>100%</height>
				<visible>$PARAM[visible]</visible>
				<defaultcontrol always="$PARAM[always_first_row]">0</defaultcontrol>
				<nested />
			</control>
		</definition>
	</include>
	<include name="HomeVideoPageContent">
		<param name="slide_distance">16</param>
		<param name="slide_time">220</param>
		<param name="fade_time">220</param>
		<definition>
			<control type="group">
				<top>$PARAM[top]</top>
				<bottom>0</bottom>
				<animation type="Conditional" condition="$PARAM[active]" reversible="false">
					<effect type="fade" start="0" end="100" time="$PARAM[fade_time]" tween="sine" easing="out" />
					<effect type="slide" start="0,$PARAM[slide_distance]" end="0,0" time="$PARAM[slide_time]" tween="cubic" easing="out" />
				</animation>
				<nested />
			</control>
		</definition>
	</include>
	<!-- 首页剧集的「代表集」探针：两级隐藏列表，和详情页 5100（季）→ 5101（集）同构。
	     A 取第一季（sortby season，limit 1），B 用 A 的 FolderPath 取该季第一集。
	     不走 videodb://tvshows/titles/<id>/-1/-1/ 那种"全部分集"路径 —— 实测取不到东西。
	     id 一律由调用方传**字面量**（Home.xml 里写 620095/620096 这类数字），
	     不在 XML 里拼 $PARAM[list_id]95：动态拼出来的容器 id 塞进条件/内容路径会让
	     Kodi 的条件求值失败并按 true 处理（上一轮就是这么把电影的胶囊画成 4 颗的）。 -->
	<include name="HomeHeroSeasonProbe">
		<param name="list_id"></param>
		<param name="season_id"></param>
		<definition>
			<control type="list" id="$PARAM[season_id]">
				<left>-10</left>
				<top>-10</top>
				<width>1</width>
				<height>1</height>
				<enable>false</enable>
				<itemlayout width="1" height="1" />
				<focusedlayout width="1" height="1" />
				<content sortby="season" sortorder="ascending" limit="1" target="videos" browse="never">videodb://tvshows/titles/$INFO[Container($PARAM[list_id]).ListItem.DBID]/</content>
				<visible>String.IsEqual(Container($PARAM[list_id]).ListItem.DBType,tvshow) + Integer.IsGreater(Container($PARAM[list_id]).ListItem.DBID,0)</visible>
			</control>
		</definition>
	</include>
	<include name="HomeHeroEpisodeProbe">
		<param name="season_id"></param>
		<param name="episode_id"></param>
		<definition>
			<control type="list" id="$PARAM[episode_id]">
				<left>-10</left>
				<top>-10</top>
				<width>1</width>
				<height>1</height>
				<enable>false</enable>
				<itemlayout width="1" height="1" />
				<focusedlayout width="1" height="1" />
				<content sortby="episode" sortorder="ascending" limit="1" target="videos" browse="never">$INFO[Container($PARAM[season_id]).ListItem.FolderPath]</content>
				<visible>Integer.IsGreater(Container($PARAM[season_id]).NumItems,0)</visible>
			</control>
		</definition>
	</include>
	<include name="HomeVideoHeroDetails">
		<param name="season_id"></param>
		<param name="episode_id"></param>
		<definition>
			<control type="group">
				<left>80</left>
				<top>202</top>
				<visible>$EXP[NaraHomeVideoExpanded]</visible>
				<animation effect="fade" time="200">VisibleChange</animation>
				<animation effect="slide" start="0,0" end="0,20" time="320" tween="cubic" easing="out" condition="$EXP[NaraHomeVideoSingleRow]">Conditional</animation>
				<control type="label">
					<width>820</width>
					<height>38</height>
					<font>font13</font>
					<textcolor>text_secondary</textcolor>
					<scroll>true</scroll>
					<label>$INFO[Container($PARAM[list_id]).ListItem.Year]$INFO[Container($PARAM[list_id]).ListItem.Mpaa,  &#183;  ]$INFO[Container($PARAM[list_id]).ListItem.Duration,  &#183;  ]$INFO[Container($PARAM[list_id]).ListItem.Genre,  &#183;  ]</label>
					<visible>!String.IsEqual(Container($PARAM[list_id]).ListItem.DBType,tvshow)</visible>
				</control>
				<control type="label">
					<width>820</width>
					<height>38</height>
					<font>font13</font>
					<textcolor>text_secondary</textcolor>
					<scroll>true</scroll>
					<label>$INFO[Container($PARAM[list_id]).ListItem.Year]$INFO[Container($PARAM[list_id]).ListItem.Mpaa,  &#183;  ]$INFO[Container($PARAM[list_id]).ListItem.Genre,  &#183;  ]$INFO[Container($PARAM[list_id]).ListItem.Season,  &#183;  , $LOCALIZE[36905]]$INFO[Container($PARAM[list_id]).ListItem.Episode,  &#183;  , $LOCALIZE[36907]]</label>
					<visible>String.IsEqual(Container($PARAM[list_id]).ListItem.DBType,tvshow)</visible>
				</control>
				<control type="textbox">
					<top>62</top>
					<width>820</width>
					<height>105</height>
					<font>font13</font>
					<textcolor>text_secondary</textcolor>
					<label>$INFO[Container($PARAM[list_id]).ListItem.Plot]</label>
				</control>
				<!-- 剧集代表集探针：每个英雄区都会生成，但只有剧集分区的 <visible> 成立才会加载内容
				     （不可见的容器不取数据，电影分区零开销）。season_id / episode_id 由 Home.xml
				     逐处传字面量 —— include 上**不能**用 condition="!String.IsEmpty($PARAM[...])"：
				     解析 include 时 $PARAM 还没替换，String.IsEmpty 拿到空串，整个 include 会被跳过，
				     容器根本不存在（诊断行显示 S= E= 都是空的，就是这个原因）。 -->
				<include content="HomeHeroSeasonProbe">
					<param name="list_id" value="$PARAM[list_id]" />
					<param name="season_id" value="$PARAM[season_id]" />
				</include>
				<include content="HomeHeroEpisodeProbe">
					<param name="season_id" value="$PARAM[season_id]" />
					<param name="episode_id" value="$PARAM[episode_id]" />
				</include>
				<!-- 两条评分行用**外层 group 的 visible** 分流，不能用 include 的 condition：
				     condition 属性里 $PARAM 不替换，条件求值失败 → 电影那条永远 true、剧集那条永远
				     false，结果剧集用的是电影参数（episode_prefix 退回 ListItem）→ 标识全空。 -->
				<!-- 电影：参数与详情页逐字相同，多一个都不传。 -->
				<control type="group">
					<visible>!String.IsEqual(Container($PARAM[list_id]).ListItem.DBType,tvshow)</visible>
					<include content="NaraOnlineRatingsRow">
						<param name="top" value="191" />
						<param name="item_prefix" value="Container($PARAM[list_id]).ListItem" />
						<param name="inline_flags" value="true" />
						<param name="technical_visible" value="true" />
						<param name="technical_item_prefix" value="Container($PARAM[list_id]).ListItem" />
					</include>
				</control>
				<!-- 剧集：单独一条，只影响剧集。技术标识借隐藏分集列表的第一集。 -->
				<control type="group">
					<visible>String.IsEqual(Container($PARAM[list_id]).ListItem.DBType,tvshow)</visible>
					<include content="NaraOnlineRatingsRow">
						<param name="top" value="191" />
						<param name="item_prefix" value="Container($PARAM[list_id]).ListItem" />
						<param name="inline_flags" value="true" />
						<param name="technical_visible" value="Integer.IsGreater(Container($PARAM[episode_id]).NumItems,0)" />
						<param name="technical_item_prefix" value="Container($PARAM[list_id]).ListItem" />
						<param name="technical_episode_prefix" value="Container($PARAM[episode_id]).ListItemAbsolute(0)" />
					</include>
				</control>
			</control>
		</definition>
	</include>
	<include name="HomeMovieSetHeroDetails">
		<definition>
			<control type="group">
				<left>80</left>
				<top>202</top>
				<visible>$EXP[NaraHomeVideoExpanded]</visible>
				<animation effect="fade" time="200">VisibleChange</animation>
				<control type="label">
					<width>820</width>
					<height>38</height>
					<font>font13</font>
					<textcolor>text_secondary</textcolor>
					<scroll>true</scroll>
					<label>$LOCALIZE[20457]$INFO[Container(5600).ListItem.Property(total),  &#183;  $LOCALIZE[31705]: ]$INFO[Container(5600).ListItem.Year,  &#183;  $LOCALIZE[31707]: ]</label>
				</control>
				<control type="label">
					<top>44</top>
					<width>900</width>
					<height>38</height>
					<font>font13</font>
					<textcolor>text_primary</textcolor>
					<scroll>true</scroll>
					<label>$INFO[Container(5600).ListItem.Property(watched),$LOCALIZE[16102]: ]$INFO[Container(5600).ListItem.Property(unwatched),  &#183;  $LOCALIZE[16101]: ]$INFO[Container(5600).ListItem.Property(inprogress),  &#183;  $LOCALIZE[31709]: ]$INFO[Container(5600).ListItem.Rating,  &#183;  $LOCALIZE[31706]: ]</label>
				</control>
				<control type="textbox">
					<top>96</top>
					<width>820</width>
					<height>105</height>
					<font>font13</font>
					<textcolor>text_secondary</textcolor>
					<label>$INFO[Container(5600).ListItem.Plot]</label>
					<visible>!String.IsEmpty(Container(5600).ListItem.Plot)</visible>
				</control>
				<control type="list" id="5602">
					<enable>false</enable>
					<left>-82</left>
					<top>-342</top>
					<width>1</width>
					<height>1</height>
					<itemlayout width="1" height="1" />
					<focusedlayout width="1" height="1" />
					<visible>String.IsEqual(Window(home).Property(Home.movies.Hero),5600) + String.IsEmpty(Container(5600).ListItem.Plot) + !String.IsEmpty(Container(5600).ListItem.DBID) + !String.IsEqual(Container(5600).ListItem.Property(node.type),target_folder)</visible>
					<content sortby="year" sortorder="ascending" limit="5" browse="never">videodb://movies/sets/$INFO[Container(5600).ListItem.DBID]/?setid=$INFO[Container(5600).ListItem.DBID]</content>
				</control>
				<control type="textbox">
					<top>96</top>
					<width>820</width>
					<height>105</height>
					<font>font13</font>
					<textcolor>text_secondary</textcolor>
					<label>$LOCALIZE[31708]: $INFO[Container(5602).ListItemAbsolute(0).Title]$INFO[Container(5602).ListItemAbsolute(1).Title,  &#183;  ]$INFO[Container(5602).ListItemAbsolute(2).Title,  &#183;  ]$INFO[Container(5602).ListItemAbsolute(3).Title,  &#183;  ]$INFO[Container(5602).ListItemAbsolute(4).Title,  &#183;  ]</label>
					<visible>String.IsEmpty(Container(5600).ListItem.Plot) + !Container(5602).IsUpdating + String.IsEqual(Container(5602).ListItemAbsolute(0).SetID,Container(5600).ListItem.DBID)</visible>
				</control>
			</control>
		</definition>
	</include>
	<include name="HomeVideoTailListCommon">
		<orientation>vertical</orientation>
		<height min="540" max="540">auto</height>
		<scrolltime tween="cubic" easing="out">300</scrolltime>
		<itemgap>20</itemgap>
	</include>
	<include name="HomeVideoTailRow">
		<param name="visible">true</param>
		<definition>
			<control type="group" id="$PARAM[id]">
				<height>260</height>
				<visible>[$PARAM[visible]] + [Integer.IsGreater(Container($PARAM[list_id]).NumItems,0) | Container($PARAM[list_id]).IsUpdating]</visible>
				<nested />
			</control>
		</definition>
	</include>
	<include name="HomeVideoRowNavigation">
		<param name="hero_id"></param>
		<param name="update_hero">false</param>
		<param name="reset_on_row_change">false</param>
		<definition>
			<scrolltime tween="cubic" easing="out">350</scrolltime>
			<orientation>horizontal</orientation>
			<onleft>noop</onleft>
			<onright>noop</onright>
			<onup>$PARAM[onup]</onup>
			<ondown>$PARAM[ondown]</ondown>
			<onfocus condition="!String.IsEqual(Window(home).Property(Home.movies.Page),first) + Control.HasFocus(5700) + !String.IsEmpty(Container(5100).ListItem.Art(fanart))">SetProperty(Home.LastMovieFanart,$ESCINFO[Container(5100).ListItem.Art(fanart)],home)</onfocus>
			<onfocus condition="!String.IsEqual(Window(home).Property(Home.tvshows.Page),first) + Control.HasFocus(6600) + !String.IsEmpty(Container(6100).ListItem.Art(fanart))">SetProperty(Home.LastTVShowFanart,$ESCINFO[Container(6100).ListItem.Art(fanart)],home)</onfocus>
			<onfocus>SetProperty(Home.$PARAM[section].Page,$PARAM[page],home)</onfocus>
			<onfocus>SetProperty(Home.$PARAM[section].Row,$PARAM[list_id],home)</onfocus>
			<onfocus condition="$PARAM[update_hero]">SetProperty(Home.$PARAM[section].Hero,$PARAM[hero_id],home)</onfocus>
			<!-- Conditions use the previous row; record the new row before refocusing. -->
			<onfocus condition="$PARAM[reset_on_row_change] + !String.IsEqual(Window(home).Property(Home.$PARAM[section].Row),$PARAM[list_id])">SetFocus($PARAM[list_id],0,absolute)</onfocus>
			<onback condition="!Container($PARAM[list_id]).Position(0)">SetFocus($PARAM[list_id],0,absolute)</onback>
			<onback condition="Container($PARAM[list_id]).Position(0) + Container($PARAM[pages_id]).HasPrevious">SetFocus($PARAM[pages_id])</onback>
			<onback condition="Container($PARAM[list_id]).Position(0) + !Container($PARAM[pages_id]).HasPrevious">SetFocus(9000)</onback>
			<preloaditems>2</preloaditems>
		</definition>
	</include>
