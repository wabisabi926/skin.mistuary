		<value condition="String.IsEqual(Window(home).Property(Home.Section),tvshows) + String.IsEqual(Window(home).Property(Home.tvshows.Hero),6100) + String.IsEqual(Container(6100).ListItem.Property(node.type),target_folder)">$INFO[Container(6100).ListItem(-1).Art(fanart)]</value>
		<value condition="String.IsEqual(Window(home).Property(Home.Section),tvshows) + String.IsEqual(Window(home).Property(Home.tvshows.Hero),6100)">$INFO[Container(6100).ListItem.Art(fanart)]</value>
		<value condition="String.IsEqual(Window(home).Property(Home.Section),tvshows) + String.IsEqual(Window(home).Property(Home.tvshows.Hero),6200) + String.IsEqual(Container(6200).ListItem.Property(node.type),target_folder)">$INFO[Container(6200).ListItem(-1).Art(fanart)]</value>
