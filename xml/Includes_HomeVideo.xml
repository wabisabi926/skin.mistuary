		<value condition="String.IsEqual(Window(home).Property(Home.Section),tvshows) + String.IsEqual(Window(home).Property(Home.tvshows.Hero),6300)">$INFO[Container(6300).ListItem.Art(fanart)]</value>
		<value condition="String.IsEqual(Window(home).Property(Home.Section),tvshows) + String.IsEqual(Window(home).Property(Home.tvshows.Hero),6700) + String.IsEqual(Container(6700).ListItem.Property(node.type),target_folder)">$INFO[Container(6700).ListItem(-1).Art(fanart)]</value>
		<value condition="String.IsEqual(Window(home).Property(Home.Section),tvshows) + String.IsEqual(Window(home).Property(Home.tvshows.Hero),6700)">$INFO[Container(6700).ListItem.Art(fanart)]</value>
		<value condition="String.IsEqual(Window(home).Property(Home.Section),tvshows) + String.IsEqual(Window(home).Property(Home.tvshows.Hero),6800) + String.IsEqual(Container(6800).ListItem.Property(node.type),target_folder)">$INFO[Container(6800).ListItem(-1).Art(fanart)]</value>
