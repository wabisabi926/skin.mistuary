<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<!-- 豆瓣插件分数：只在详情页 onload 写入、离开时清除；次评分档位由设置 715 决定。 -->
	<expression name="NaraRatingDoubanReady">String.IsEqual(Window(home).Property(Mistuary.Rating.Status),ok)</expression>
	<!-- 评分胶囊。Kodi 20+ 支持按类型读评分：`ListItem.Rating(<type>)`，
	     默认类型用 `ListItem.Rating` 读。**一行最多两个胶囊**，优先级：
	     豆瓣 > IMDb > TMDB > 烂番茄（豆瓣和 IMDb 是同一个字段，由设置二选一，天然互斥）。
	     数据来源只有两个，都验证过：
	       Emby for Kodi 只写 `default`（CommunityRating）和 `tomatometerallcritics`（CriticRating，仅电影）
	       Kodi 官方 TMDb 刮削器写 `themoviedb`（电影）/ `tmdb`（剧集）/ `imdb` / `trakt`
	     取不到的类型返回空字符串，对应胶囊自动隐藏。详见 docs/HANDOVER.md §5.7。 -->
	<include name="NaraOnlineRatingItem">
		<!-- 每个评分是一枚胶囊：底板 + 徽标 + 分数，与技术标识同款外观。
		     宽度 = 左右内边距 12×2 + 内容宽度；文字框给 44（"8.9" 实测 42px，"10.0" 会裁掉末位边缘 —— 实际不会出现）。
		     图标框按素材比例传参：方形徽标（烂番茄/TMDb/Metacritic/豆瓣）28×28，
		     IMDb 词标是 2:1，给 46×23 才不至于比分数小一大截。 -->
		<param name="width">102</param>
		<param name="visible">false</param>
		<param name="icon"></param>
		<param name="label"></param>
		<param name="icon_width">28</param>
		<param name="icon_height">28</param>
		<param name="icon_top">4</param>
		<param name="pad">12</param>
		<param name="label_left">46</param>
		<param name="label_width">44</param>
		<definition>
			<control type="group">
				<width>$PARAM[width]</width>
				<height>36</height>
				<visible>$PARAM[visible]</visible>
				<control type="image">
					<width>$PARAM[width]</width>
					<height>36</height>
					<texture border="4" colordiffuse="66000000">shapes/round4.png</texture>
				</control>
				<control type="image">
					<left>$PARAM[pad]</left>
					<top>$PARAM[icon_top]</top>
					<width>$PARAM[icon_width]</width>
					<height>$PARAM[icon_height]</height>
					<aspectratio align="left" aligny="center">keep</aspectratio>
					<texture>$PARAM[icon]</texture>
				</control>
				<control type="label">
					<left>$PARAM[label_left]</left>
					<width>$PARAM[label_width]</width>
					<height>36</height>
					<font>font13</font>
					<aligny>center</aligny>
					<label>$PARAM[label]</label>
				</control>
			</control>
		</definition>
	</include>
	<include name="NaraOnlineRatingsRow">
		<param name="item_prefix">ListItem</param>
		<param name="top">0</param>
		<!-- 790 = 剧情简介的容器宽度，这一行的右边界必须和它一致，不能更宽。
		     两个评分 + 5 个标识 + 集号 = 757，正好在 790 内；
		     极端情况（双 HDR「DV P7 FEL + HDR10」+ ATMOS）会到 997
		     （2026-10-30 档位小字改 font_flag 后 DV 胶囊 100→144）——
		     grouplist 不裁剪也不滚动，超出部分画在简介右侧的空白区，不会盖住别的东西。 -->
		<param name="width">790</param>
		<param name="align">left</param>
		<!-- inline_flags=true 时把技术标识并进同一条 grouplist（评分 + 标识同一行）。 -->
		<param name="inline_flags">false</param>
		<param name="technical_visible">true</param>
		<param name="technical_item_prefix">ListItem</param>
		<!-- 剧集行没有文件级流信息，只能借「代表集」的 ListItem 读。
		     默认和 item_prefix 相同（等于拿不到标识），调用方按需传一个分集容器。 -->
		<param name="technical_episode_prefix">ListItem</param>
		<param name="technical_caption"></param>
		<param name="technical_caption_visible">false</param>
		<definition>
			<control type="grouplist">
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>36</height>
				<orientation>horizontal</orientation>
				<align>$PARAM[align]</align>
				<itemgap>12</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
				<!-- 主评分：Emby 的 CommunityRating（每个库单一来源）。
				     来源由 Emby 库的评分抓取器决定（TheMovieDb / OMDb / TheTVDB 都会写），
				     皮肤按「主评分来源」手选图标，三处（库 / E4K / 皮肤）保持一致。
				     IMDb 词标是 2:1，用 46×23 的图标框；豆瓣是方形徽标，用默认 28×28。 -->
        <!-- 主评分 · 手选优先（设置 707）。类型字段不能当依据：E4K 会把 CommunityRating
             标成 imdb 类型，自动识别会误判；所以只要用户选过档位，就只按档位画图标。 -->
        <include content="NaraOnlineRatingItem">
          <param name="visible" value="!String.IsEmpty($PARAM[item_prefix].Rating) + Skin.HasSetting(douban_rating)" />
          <param name="icon" value="flags/ratings/douban.png" />
          <param name="label" value="$INFO[$PARAM[item_prefix].Rating]" />
        </include>
        <include content="NaraOnlineRatingItem">
          <param name="visible" value="!String.IsEmpty($PARAM[item_prefix].Rating) + !Skin.HasSetting(douban_rating) + Skin.HasSetting(rating_src_imdb)" />
          <param name="icon" value="flags/ratings/imdb.png" />
          <param name="icon_width" value="46" />
          <param name="icon_height" value="23" />
          <param name="icon_top" value="6" />
          <param name="label_left" value="64" />
          <param name="label_width" value="44" />
          <param name="width" value="120" />
          <param name="label" value="$INFO[$PARAM[item_prefix].Rating]" />
        </include>
        <include content="NaraOnlineRatingItem">
          <param name="visible" value="!String.IsEmpty($PARAM[item_prefix].Rating) + !Skin.HasSetting(douban_rating) + !Skin.HasSetting(rating_src_imdb) + Skin.HasSetting(rating_src_tmdb)" />
          <param name="icon" value="flags/ratings/tmdb.png" />
          <param name="label" value="$INFO[$PARAM[item_prefix].Rating]" />
        </include>
        <!-- 主评分 · 三档都没选时才自动判断（本地刮削库类型字段有效；E4K 库会误判成 IMDb，不建议用自动）。 -->
        <include content="NaraOnlineRatingItem">
          <param name="visible" value="!String.IsEmpty($PARAM[item_prefix].Rating) + !Skin.HasSetting(douban_rating) + !Skin.HasSetting(rating_src_imdb) + !Skin.HasSetting(rating_src_tmdb) + !String.IsEmpty($PARAM[item_prefix].Rating(tmdb)) + String.IsEqual($PARAM[item_prefix].Rating,$PARAM[item_prefix].Rating(tmdb))" />
          <param name="icon" value="flags/ratings/tmdb.png" />
          <param name="label" value="$INFO[$PARAM[item_prefix].Rating]" />
        </include>
        <include content="NaraOnlineRatingItem">
          <param name="visible" value="!String.IsEmpty($PARAM[item_prefix].Rating) + !Skin.HasSetting(douban_rating) + !Skin.HasSetting(rating_src_imdb) + !Skin.HasSetting(rating_src_tmdb) + !String.IsEmpty($PARAM[item_prefix].Rating(trakt)) + String.IsEqual($PARAM[item_prefix].Rating,$PARAM[item_prefix].Rating(trakt)) + !String.IsEqual($PARAM[item_prefix].Rating,$PARAM[item_prefix].Rating(tmdb))" />
          <param name="icon" value="flags/ratings/trakt.png" />
          <param name="label" value="$INFO[$PARAM[item_prefix].Rating]" />
        </include>
        <include content="NaraOnlineRatingItem">
          <param name="visible" value="!String.IsEmpty($PARAM[item_prefix].Rating) + !Skin.HasSetting(douban_rating) + !Skin.HasSetting(rating_src_imdb) + !Skin.HasSetting(rating_src_tmdb) + !String.IsEmpty($PARAM[item_prefix].Rating(imdb)) + String.IsEqual($PARAM[item_prefix].Rating,$PARAM[item_prefix].Rating(imdb)) + !String.IsEqual($PARAM[item_prefix].Rating,$PARAM[item_prefix].Rating(tmdb)) + !String.IsEqual($PARAM[item_prefix].Rating,$PARAM[item_prefix].Rating(trakt))" />
          <param name="icon" value="flags/ratings/imdb.png" />
          <param name="icon_width" value="46" />
          <param name="icon_height" value="23" />
          <param name="icon_top" value="6" />
          <param name="label_left" value="64" />
          <param name="label_width" value="44" />
          <param name="width" value="120" />
          <param name="label" value="$INFO[$PARAM[item_prefix].Rating]" />
        </include>
        <include content="NaraOnlineRatingItem">
          <param name="visible" value="!String.IsEmpty($PARAM[item_prefix].Rating) + !Skin.HasSetting(douban_rating) + !Skin.HasSetting(rating_src_imdb) + !Skin.HasSetting(rating_src_tmdb) + !String.IsEqual($PARAM[item_prefix].Rating,$PARAM[item_prefix].Rating(tmdb)) + !String.IsEqual($PARAM[item_prefix].Rating,$PARAM[item_prefix].Rating(trakt)) + !String.IsEqual($PARAM[item_prefix].Rating,$PARAM[item_prefix].Rating(imdb))" />
          <param name="icon" value="flags/ratings/tmdb.png" />
          <param name="label" value="$INFO[$PARAM[item_prefix].Rating]" />
        </include>
				<!-- 次评分 ①：豆瓣（仅详情页，助手实时取分并写窗口属性）。
				     列表/海报墙读不到分类型评分，窗口属性也只在详情页有效，所以这里限定 videoinfo。
				     与主评分同值时省略，避免同一数字出现两遍。 -->
				<include content="NaraOnlineRatingItem">
					<param name="visible" value="Window.IsVisible(videoinfo) + $EXP[NaraRatingDoubanReady] + !Skin.HasSetting(douban_rating) + !String.IsEqual($PARAM[item_prefix].Rating,Window(10000).Property(Mistuary.Rating.Douban))" />
					<param name="icon" value="flags/ratings/douban.png" />
					<param name="label" value="$INFO[Window(10000).Property(Mistuary.Rating.Douban)]" />
				</include>
				<!-- 次评分 ②：烂番茄（Emby 的 CriticRating/10，只有电影写）。
				     没有豆瓣分时才显示；剧集/季没有该通道，自然隐藏。 -->
				<include content="NaraOnlineRatingItem">
					<param name="visible" value="!String.IsEmpty($PARAM[item_prefix].Rating(tomatometerallcritics)) + !Skin.HasSetting(douban_rating) + !$EXP[NaraRatingDoubanReady] + !String.IsEqual($PARAM[item_prefix].DBType,episode) + !String.IsEqual($PARAM[item_prefix].DBType,season)" />
					<param name="icon" value="flags/ratings/rtfresh.png" />
					<param name="label" value="$INFO[$PARAM[item_prefix].Rating(tomatometerallcritics)]" />
				</include>

				<include content="VideoTechnicalFlagsByPrefix">
					<param name="visible" value="$PARAM[inline_flags] + $PARAM[technical_visible]" />
					<param name="item_prefix" value="$PARAM[technical_item_prefix]" />
					<param name="episode_prefix" value="$PARAM[technical_episode_prefix]" />
				</include>
				<!-- 代表集说明放在参数后面：先读评分/规格，再把「这是哪一集」当注释。 -->
				<control type="label">
					<width>10</width>
					<height>36</height>
					<font>font13</font>
					<textcolor>text_muted</textcolor>
					<align>center</align>
					<aligny>center</aligny>
					<label>|</label>
					<visible>$PARAM[technical_visible] + $PARAM[technical_caption_visible]</visible>
				</control>
				<control type="label">
					<!-- 100：`S01E01` 实测 89.6px，`代表集` 兜底 81px，取大者加 10px 余量。
					     原来是 260（对应「代表集 S01E01」178px），白空 82px —— 正好一个技术标识的宽度。 -->
					<width>100</width>
					<height>36</height>
					<font>font13</font>
					<textcolor>text_secondary</textcolor>
					<align>left</align>
					<aligny>center</aligny>
					<label>$PARAM[technical_caption]</label>
					<visible>$PARAM[technical_visible] + $PARAM[technical_caption_visible]</visible>
				</control>

			</control>
		</definition>
	</include>
	<!-- The information dialog and library hero views share this exact content
	     geometry. Callers own the outer position and choose whether the synopsis
	     is focusable; action controls deliberately remain outside this include. -->
	<include name="VideoInfoHeroContent">
		<param name="synopsis_focusable">false</param>
		<param name="synopsis_navigation">0</param>
		<param name="synopsis_height">132</param>
		<param name="tv_synopsis_height">132</param>
		<!-- 合并行位置 = synopsis_height + 26（框内 top 2 + 下方间距 24）。
		     三个调用方的简介高度不同，必须由调用方算好传进来。 -->
		<param name="ratings_top">158</param>
		<param name="ratings_top_tv">158</param>
		<param name="synopsis_focus_height">128</param>
		<param name="tv_synopsis_tagline_offset">2</param>
		<param name="tv_synopsis_no_tagline_offset">-38</param>
		<param name="tv_content_tagline_offset">-30</param>
		<param name="tv_content_no_tagline_offset">-22</param>
		<param name="clearlogo_top">25</param>
		<param name="clearlogo_width">624</param>
		<param name="clearlogo_height">134</param>
		<param name="item_dbtype">ListItem.DBType</param>
		<param name="clearlogo_texture">$VAR[VideoInfoClearLogoVar]</param>
		<param name="clearlogo_visible">!String.IsEmpty(ListItem.Art(clearlogo)) | !String.IsEmpty(ListItem.Art(tvshow.clearlogo))</param>
		<param name="clearlogo_missing">String.IsEmpty(ListItem.Art(clearlogo)) + String.IsEmpty(ListItem.Art(tvshow.clearlogo))</param>
		<param name="hero_title">$VAR[VideoInfoHeroTitleVar]</param>
		<param name="episode_label">$VAR[VideoInfoEpisodeLabelVar]</param>
		<param name="episode_visible">String.IsEqual(ListItem.DBType,episode) | String.IsEqual(ListItem.DBType,season)</param>
		<param name="metadata_label">$VAR[VideoInfoHeroMetadataVar]</param>
		<param name="rating_item_prefix">ListItem</param>
		<param name="technical_visible">true</param>
		<param name="technical_item_prefix">ListItem</param>
		<param name="tagline_visible">!String.IsEmpty(ListItem.Tagline)</param>
		<param name="tagline_missing">String.IsEmpty(ListItem.Tagline)</param>
		<param name="tagline_label">[I]$INFO[ListItem.Tagline][/I]</param>
		<param name="synopsis_label">$VAR[VideoInfoSynopsisVar]</param>
		<definition>
			<control type="group">
				<animation effect="slide" start="0,38" end="0,38" condition="String.IsEqual($PARAM[item_dbtype],movie) + [$PARAM[tagline_missing]]">Conditional</animation>
				<animation effect="slide" start="0,$PARAM[tv_content_tagline_offset]" end="0,$PARAM[tv_content_tagline_offset]" condition="String.IsEqual($PARAM[item_dbtype],tvshow) + [$PARAM[tagline_visible]]">Conditional</animation>
				<animation effect="slide" start="0,$PARAM[tv_content_no_tagline_offset]" end="0,$PARAM[tv_content_no_tagline_offset]" condition="String.IsEqual($PARAM[item_dbtype],tvshow) + [$PARAM[tagline_missing]]">Conditional</animation>
				<control type="image">
					<top>$PARAM[clearlogo_top]</top>
					<width>$PARAM[clearlogo_width]</width>
					<height>$PARAM[clearlogo_height]</height>
					<aspectratio align="left" aligny="center">keep</aspectratio>
					<texture background="true">$PARAM[clearlogo_texture]</texture>
					<visible>$PARAM[clearlogo_visible]</visible>
				</control>
				<control type="label">
					<top>33</top>
					<width>800</width>
					<height>104</height>
					<font>font60</font>
					<shadowcolor>shadow_hard</shadowcolor>
					<aligny>center</aligny>
					<scroll>true</scroll>
					<label>$PARAM[hero_title]</label>
					<visible>$PARAM[clearlogo_missing]</visible>
				</control>
				<control type="label">
					<top>165</top>
					<width>790</width>
					<height>40</height>
					<font>font30_title</font>
					<shadowcolor>shadow_hard</shadowcolor>
					<textcolor>text_secondary</textcolor>
					<scroll>true</scroll>
					<label>$PARAM[episode_label]</label>
					<visible>$PARAM[episode_visible]</visible>
				</control>
				<control type="label">
					<top>205</top>
					<width>810</width>
					<height>38</height>
					<font>font13</font>
					<shadowcolor>shadow_hard</shadowcolor>
					<textcolor>text_secondary</textcolor>
					<scroll>true</scroll>
					<label>$PARAM[metadata_label]</label>
				</control>
				<!-- 评分与技术标识合并成一行，整体放在简介下方。 -->
				<control type="label">
					<top>247</top>
					<width>800</width>
					<height>38</height>
					<font>font25</font>
					<shadowcolor>shadow_hard</shadowcolor>
					<textcolor>text_secondary</textcolor>
					<scroll>true</scroll>
					<label>$PARAM[tagline_label]</label>
					<visible>$PARAM[tagline_visible]</visible>
				</control>
				<control type="group">
					<top>307</top>
					<!-- Keep the synopsis anchored when the movie header fills the missing tagline row. -->
					<animation effect="slide" start="0,-38" end="0,-38" condition="String.IsEqual($PARAM[item_dbtype],movie) + [$PARAM[tagline_missing]]">Conditional</animation>
					<!-- Keep caller-supplied boolean expressions grouped when composing them
					     with the TV-only condition; callers may pass their own OR branches. -->
					<animation effect="slide" start="0,$PARAM[tv_synopsis_tagline_offset]" end="0,$PARAM[tv_synopsis_tagline_offset]" condition="String.IsEqual($PARAM[item_dbtype],tvshow) + [$PARAM[tagline_visible]]">Conditional</animation>
					<animation effect="slide" start="0,$PARAM[tv_synopsis_no_tagline_offset]" end="0,$PARAM[tv_synopsis_no_tagline_offset]" condition="String.IsEqual($PARAM[item_dbtype],tvshow) + [$PARAM[tagline_missing]]">Conditional</animation>
					<control type="button" id="138">
						<width>804</width>
						<height>$PARAM[synopsis_focus_height]</height>
						<label></label>
						<texturefocus colordiffuse="border_subtle">colors/white.png</texturefocus>
						<texturenofocus />
						<onup>$PARAM[synopsis_navigation]</onup>
						<ondown>$PARAM[synopsis_navigation]</ondown>
						<onleft>$PARAM[synopsis_navigation]</onleft>
						<onright>$PARAM[synopsis_navigation]</onright>
						<onclick>SetProperty(TextViewer_Header,$LOCALIZE[207],home)</onclick>
						<onclick>SetProperty(TextViewer_Text,$ESCVAR[VideoInfoPlotVar],home)</onclick>
						<onclick>ActivateWindow(1102)</onclick>
						<visible>$PARAM[synopsis_focusable]</visible>
					</control>
					<control type="textbox">
						<left>2</left>
						<top>2</top>
						<width>790</width>
						<height>$PARAM[synopsis_height]</height>
						<font>font13</font>
						<shadowcolor>shadow_hard</shadowcolor>
						<textcolor>text_secondary</textcolor>
						<label fallback="19055">$PARAM[synopsis_label]</label>
						<autoscroll time="3000" delay="7000" repeat="5000">Skin.HasSetting(autoscroll) + !Window.IsActive(1102)</autoscroll>
						<visible>!String.IsEqual($PARAM[item_dbtype],tvshow)</visible>
					</control>
					<control type="textbox">
						<left>2</left>
						<top>2</top>
						<width>790</width>
						<height>$PARAM[tv_synopsis_height]</height>
						<font>font13</font>
						<shadowcolor>shadow_hard</shadowcolor>
						<textcolor>text_secondary</textcolor>
						<label fallback="19055">$PARAM[synopsis_label]</label>
						<autoscroll time="3000" delay="7000" repeat="5000">Skin.HasSetting(autoscroll) + !Window.IsActive(1102)</autoscroll>
						<visible>String.IsEqual($PARAM[item_dbtype],tvshow)</visible>
					</control>
					<!-- 评分 + 技术标识同一行，放在简介下方。电影/剧集简介高度不同，各用各的坐标；
					     都在简介组内部，随 tagline 缺失的整组上滑一起动。 -->
					<control type="group">
						<top>$PARAM[ratings_top]</top>
						<visible>!String.IsEqual($PARAM[item_dbtype],tvshow)</visible>
						<include content="NaraOnlineRatingsRow">
							<param name="top" value="0" />
							<param name="item_prefix" value="$PARAM[rating_item_prefix]" />
							<param name="inline_flags" value="true" />
							<param name="technical_visible" value="$PARAM[technical_visible]" />
							<param name="technical_item_prefix" value="$PARAM[technical_item_prefix]" />
						</include>
					</control>
					<control type="group">
						<top>$PARAM[ratings_top_tv]</top>
						<visible>String.IsEqual($PARAM[item_dbtype],tvshow)</visible>
						<include content="NaraOnlineRatingsRow">
							<param name="top" value="0" />
							<param name="item_prefix" value="$PARAM[rating_item_prefix]" />
							<param name="inline_flags" value="true" />
							<param name="technical_visible" value="Integer.IsGreater(Container(5101).NumItems,0)" />
							<param name="technical_item_prefix" value="Container(5101).ListItemAbsolute(0)" />
							<param name="technical_caption" value="$VAR[NaraRepCaptionVar]" />
							<param name="technical_caption_visible" value="!String.IsEmpty(Container(5101).ListItemAbsolute(0).VideoResolution)" />
						</include>
					</control>
				</control>
			</control>
		</definition>
	</include>
</includes>
