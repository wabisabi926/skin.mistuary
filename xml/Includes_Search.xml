<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<!-- Kodi interprets bare numeric labels as localization IDs. Fuse 2 avoids
	     that ambiguity by routing every digit through a literal variable. -->
	<variable name="NaraSearchNumber0"><value>0</value></variable>
	<variable name="NaraSearchNumber1"><value>1</value></variable>
	<variable name="NaraSearchNumber2"><value>2</value></variable>
	<variable name="NaraSearchNumber3"><value>3</value></variable>
	<variable name="NaraSearchNumber4"><value>4</value></variable>
	<variable name="NaraSearchNumber5"><value>5</value></variable>
	<variable name="NaraSearchNumber6"><value>6</value></variable>
	<variable name="NaraSearchNumber7"><value>7</value></variable>
	<variable name="NaraSearchNumber8"><value>8</value></variable>
	<variable name="NaraSearchNumber9"><value>9</value></variable>
	<!-- 第二排数字行（16994）的开关键，固定写 123：原来这个键只写 "0"，
	     没人看得出它是"切到数字键盘"的开关。
	     不跟着 NumbersVisible 翻转（做过 ABC/123 两档，但列表项 label 只在
	     条目重绘时才重新解析，切完会慢半拍），展开后靠下面那排 1–9 自己说话。
	     走变量是因为裸数字 label 会被 Kodi 当成 $LOCALIZE[123]。
	     第二排那个真正的 0 仍用 NaraSearchNumber0，不受影响。 -->
	<variable name="NaraSearchNumberToggleLabel"><value>123</value></variable>

	<!--
		Search is an XSP filter evaluated by the video database. The query matches
		title, original title (contains) and sort title (prefix only).
		`sorttitle` is the pinyin initials written by 神医助手 and synced by Emby for
		Kodi, so typing initials finds Chinese titles; prefix matching keeps
		"contains HZ" from pulling in HFHZY* style false positives. People and genre
		columns are deliberately absent: one flat OR can only carry one operator, and
		substring actor/director matches drown single-letter queries (Z hits 238 of
		742 movies). People/genre search belongs to the future server-side bridge,
		see docs/helper-plugin-plan.md §6. The lists deliberately carry no limit:
		the tab counters must show the real totals.
	-->
	<!-- 服务端搜索：插件和自己都装了、Emby 也启用时才走。
	     插件只是"多一个来源"，路径变量最后一行始终是本地 XSP 兜底。 -->
	<expression name="helper_search_ready">System.AddonIsEnabled(script.mistuary.helper) + System.AddonIsEnabled(plugin.service.emby-next-gen)</expression>
	<variable name="NaraSearchMoviesPathVar">
		<value condition="$EXP[helper_search_ready] + !Skin.HasSetting(helper_search_off) + !String.IsEmpty(Control.GetLabel(16999).index(1))">plugin://script.mistuary.helper/?mode=search&amp;type=movies&amp;query=$INFO[Control.GetLabel(16999).index(1)]</value>
		<value condition="!String.IsEmpty(Control.GetLabel(16999).index(1))">videodb://movies/titles/?xsp={"order":{"direction":"ascending","ignorefolders":0,"method":"sorttitle"},"rules":{"or":[{"field":"title","operator":"contains","value":["$INFO[Control.GetLabel(16999).index(1)]"]},{"field":"originaltitle","operator":"contains","value":["$INFO[Control.GetLabel(16999).index(1)]"]},{"field":"sorttitle","operator":"startswith","value":["$INFO[Control.GetLabel(16999).index(1)]"]}]},"type":"movies"}</value>
	</variable>
	<variable name="NaraSearchTVShowsPathVar">
		<value condition="$EXP[helper_search_ready] + !Skin.HasSetting(helper_search_off) + !String.IsEmpty(Control.GetLabel(16999).index(1))">plugin://script.mistuary.helper/?mode=search&amp;type=shows&amp;query=$INFO[Control.GetLabel(16999).index(1)]</value>
		<value condition="!String.IsEmpty(Control.GetLabel(16999).index(1))">videodb://tvshows/titles/?xsp={"order":{"direction":"ascending","ignorefolders":0,"method":"sorttitle"},"rules":{"or":[{"field":"title","operator":"contains","value":["$INFO[Control.GetLabel(16999).index(1)]"]},{"field":"originaltitle","operator":"contains","value":["$INFO[Control.GetLabel(16999).index(1)]"]},{"field":"sorttitle","operator":"startswith","value":["$INFO[Control.GetLabel(16999).index(1)]"]}]},"type":"tvshows"}</value>
	</variable>
	<!-- 两种来源的容器属性不同：本地 XSP 自带 order，但仍显式写 sortby 保证顺序；
	     服务端要保留相关度排序，不能写 sortby。装/卸插件后重载皮肤才切换。 -->
	<include name="NaraSearchMoviesContentLocal">
		<content sortby="sorttitle" sortorder="ascending" target="videos" browse="never">$VAR[NaraSearchMoviesPathVar]</content>
	</include>
	<include name="NaraSearchMoviesContentServer">
		<content target="videos" browse="never">$VAR[NaraSearchMoviesPathVar]</content>
	</include>
	<include name="NaraSearchTVShowsContentLocal">
		<content sortby="sorttitle" sortorder="ascending" target="videos" browse="never">$VAR[NaraSearchTVShowsPathVar]</content>
	</include>
	<include name="NaraSearchTVShowsContentServer">
		<content target="videos" browse="never">$VAR[NaraSearchTVShowsPathVar]</content>
	</include>
	<!-- Keep the active result type independent from the order in which the two
	     asynchronous directory providers finish. A valid explicit tab choice wins;
	     otherwise movies are the deterministic default, falling back to TV only
	     when the movie result is empty. -->
	<expression name="NaraSearchMoviesActive">Integer.IsGreater(Container(16101).NumItems,0) + [!String.IsEqual(Window(home).Property(Search.ActiveType),tvshows) | Integer.IsEqual(Container(16102).NumItems,0)]</expression>
	<expression name="NaraSearchTVShowsActive">Integer.IsGreater(Container(16102).NumItems,0) + [String.IsEqual(Window(home).Property(Search.ActiveType),tvshows) | Integer.IsEqual(Container(16101).NumItems,0)]</expression>
	<expression name="NaraSearchHasResults">!String.IsEmpty(Control.GetLabel(16999).index(1)) + [Integer.IsGreater(Container(16101).NumItems,0) | Integer.IsGreater(Container(16102).NumItems,0)]</expression>
	<expression name="NaraSearchKeyboardHidden">!String.IsEqual(Window(home).Property(Home.Section),search) | System.HasActiveModalDialog | !String.IsEmpty(Window(home).Property(Search.SettingsTransition)) | [!ControlGroup(16010).HasFocus() + !String.IsEmpty(Window(home).Property(Search.KeyboardHidden))]</expression>
	<variable name="NaraSearchFanartVar">
		<value condition="$EXP[NaraSearchMoviesActive]">$INFO[Container(16101).ListItem.Art(fanart)]</value>
		<value condition="$EXP[NaraSearchTVShowsActive]">$INFO[Container(16102).ListItem.Art(fanart)]</value>
	</variable>
	<!-- 这里刻意不给 DefaultVideo.png 兜底：它只喂右侧那块"没有 fanart 时显示大海报"
	     的面板，兜底会让那块面板顶着默认图冒出来，和下面的网格重复。
	     面板的可见性自己会要求"有真海报"，所以空着就等于不显示。 -->
	<variable name="NaraSearchPosterVar">
		<value condition="$EXP[NaraSearchMoviesActive] + !String.IsEmpty(Container(16101).ListItem.Art(poster))">$INFO[Container(16101).ListItem.Art(poster)]</value>
		<value condition="$EXP[NaraSearchTVShowsActive] + !String.IsEmpty(Container(16102).ListItem.Art(poster))">$INFO[Container(16102).ListItem.Art(poster)]</value>
	</variable>
	<!-- Fuse 2 search keyboard input mapping. Kodi's Number actions provide the
	     multi-tap letter entry while focus briefly sits on the hidden edit. -->
	<include name="NaraSearchInputA"><onclick>Number2</onclick></include>
	<include name="NaraSearchInputB"><onclick>Number2</onclick><onclick>Number2</onclick></include>
	<include name="NaraSearchInputC"><onclick>Number2</onclick><onclick>Number2</onclick><onclick>Number2</onclick></include>
	<include name="NaraSearchInputD"><onclick>Number3</onclick></include>
	<include name="NaraSearchInputE"><onclick>Number3</onclick><onclick>Number3</onclick></include>
