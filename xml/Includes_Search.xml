	<include name="NaraSearchInputM"><onclick>Number6</onclick></include>
	<include name="NaraSearchInputN"><onclick>Number6</onclick><onclick>Number6</onclick></include>
	<include name="NaraSearchInputO"><onclick>Number6</onclick><onclick>Number6</onclick><onclick>Number6</onclick></include>
	<include name="NaraSearchInputP"><onclick>Number7</onclick></include>
	<include name="NaraSearchInputQ"><onclick>Number7</onclick><onclick>Number7</onclick></include>
	<include name="NaraSearchInputR"><onclick>Number7</onclick><onclick>Number7</onclick><onclick>Number7</onclick></include>
	<include name="NaraSearchInputS"><onclick>Number7</onclick><onclick>Number7</onclick><onclick>Number7</onclick><onclick>Number7</onclick></include>
	<include name="NaraSearchInputT"><onclick>Number8</onclick></include>
	<include name="NaraSearchInputU"><onclick>Number8</onclick><onclick>Number8</onclick></include>
	<include name="NaraSearchInputV"><onclick>Number8</onclick><onclick>Number8</onclick><onclick>Number8</onclick></include>
	<include name="NaraSearchInputW"><onclick>Number9</onclick></include>
	<include name="NaraSearchInputX"><onclick>Number9</onclick><onclick>Number9</onclick></include>
	<include name="NaraSearchInputY"><onclick>Number9</onclick><onclick>Number9</onclick><onclick>Number9</onclick></include>
	<include name="NaraSearchInputZ"><onclick>Number9</onclick><onclick>Number9</onclick><onclick>Number9</onclick><onclick>Number9</onclick></include>
	<include name="NaraSearchInputBackspace"><onclick>Backspace</onclick></include>

	<!-- The numeric page is hidden until the 0-9 key is selected. The repeated
	     actions cycle Kodi's multi-tap input to the literal digit, exactly as in
	     Fuse 2. -->
	<include name="NaraSearchInput0">
		<onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick>
		<onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick>
		<onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick>
		<onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick><onclick>Number0</onclick>
	</include>
	<include name="NaraSearchInput1">
		<onclick>Number1</onclick><onclick>Number1</onclick><onclick>Number1</onclick><onclick>Number1</onclick><onclick>Number1</onclick>
		<onclick>Number1</onclick><onclick>Number1</onclick><onclick>Number1</onclick><onclick>Number1</onclick><onclick>Number1</onclick>
		<onclick>Number1</onclick><onclick>Number1</onclick><onclick>Number1</onclick><onclick>Number1</onclick>
	</include>
	<include name="NaraSearchInput2"><onclick>Number2</onclick><onclick>Number2</onclick><onclick>Number2</onclick><onclick>Number2</onclick></include>
	<include name="NaraSearchInput3"><onclick>Number3</onclick><onclick>Number3</onclick><onclick>Number3</onclick><onclick>Number3</onclick></include>
	<include name="NaraSearchInput4"><onclick>Number4</onclick><onclick>Number4</onclick><onclick>Number4</onclick><onclick>Number4</onclick></include>
	<include name="NaraSearchInput5"><onclick>Number5</onclick><onclick>Number5</onclick><onclick>Number5</onclick><onclick>Number5</onclick></include>
	<include name="NaraSearchInput6"><onclick>Number6</onclick><onclick>Number6</onclick><onclick>Number6</onclick><onclick>Number6</onclick></include>
	<include name="NaraSearchInput7"><onclick>Number7</onclick><onclick>Number7</onclick><onclick>Number7</onclick><onclick>Number7</onclick><onclick>Number7</onclick></include>
	<include name="NaraSearchInput8"><onclick>Number8</onclick><onclick>Number8</onclick><onclick>Number8</onclick><onclick>Number8</onclick></include>
	<include name="NaraSearchInput9"><onclick>Number9</onclick><onclick>Number9</onclick><onclick>Number9</onclick><onclick>Number9</onclick><onclick>Number9</onclick></include>

	<include name="NaraSearchKeyboardItemLayout">
		<param name="focused">false</param>
		<definition>
			<control type="image">
				<left>6</left><top>6</top><width>60</width><height>52</height>
				<texture colordiffuse="glass_focus_light" border="14">shapes/round14.png</texture>
				<visible>$PARAM[focused]</visible>
			</control>
			<control type="label">
				<width>72</width><height>64</height>
				<font>font24_search_bold</font>
				<label>$INFO[ListItem.Label]</label>
				<align>center</align><aligny>center</aligny>
				<textcolor>text_primary</textcolor>
			</control>
			<control type="image">
				<left>22</left><top>20</top><width>28</width><height>24</height>
				<aspectratio>keep</aspectratio>
				<texture colordiffuse="text_primary">$INFO[ListItem.Icon]</texture>
				<visible>!String.IsEmpty(ListItem.Icon)</visible>
			</control>
		</definition>
	</include>

	<include name="NaraSearchKeyboardNavigation">
		<onfocus>ClearProperty(Search.KeyboardHidden,home)</onfocus>
		<onback>SetProperty(Search.KeyboardHidden,true,home)</onback>
		<onback>ClearProperty(Search.NumbersVisible,home)</onback>
		<onback condition="$EXP[NaraSearchHasResults] + $EXP[NaraSearchMoviesActive]">16101</onback>
		<onback condition="$EXP[NaraSearchHasResults] + $EXP[NaraSearchTVShowsActive]">16102</onback>
		<onback condition="!$EXP[NaraSearchHasResults]">9011</onback>
	</include>
	<include name="NaraSearchResultsLift">
		<animation effect="slide" start="0,0" end="0,-360" time="280" tween="cubic" easing="inout" reversible="true" condition="!$EXP[NaraSearchKeyboardHidden]">Conditional</animation>
	</include>

	<include name="NaraSearchKeyboard">
		<!-- Virtual-key input targets the hidden edit; the visible input button owns Back navigation. -->
		<control type="edit" id="16999">
			<left>-1000</left><top>-1000</top><width>1</width><height>1</height>
			<include>NaraSearchKeyboardNavigation</include>
			<ontextchange>ClearProperty(Search.ActiveType,home)</ontextchange>
			<ondown>16992</ondown>
			<onleft>noop</onleft><onright>noop</onright>
		</control>
		<control type="group">
			<centerleft>50%</centerleft><top>24</top><width>1008</width><height>64</height>
			<control type="button" id="16998">
				<width>1008</width><height>64</height>
				<label></label><texturefocus /><texturenofocus />
				<include>NaraSearchKeyboardNavigation</include>
				<onup>SetProperty(Search.KeyboardHidden,true,home)</onup>
				<onup>ClearProperty(Search.NumbersVisible,home)</onup>
				<onup condition="$EXP[NaraSearchHasResults] + $EXP[NaraSearchMoviesActive]">16101</onup>
				<onup condition="$EXP[NaraSearchHasResults] + $EXP[NaraSearchTVShowsActive]">16102</onup>
				<onup condition="!$EXP[NaraSearchHasResults]">9011</onup>
				<ondown>16992</ondown>
				<onleft>noop</onleft><onright>noop</onright>
				<onclick>SetFocus(16992)</onclick>
			</control>
			<control type="label">
				<width>1008</width><height>60</height>
				<font>font34_search</font>
				<label>$INFO[Control.GetLabel(16999).index(1)]</label>
				<textcolor>text_primary</textcolor>
				<align>center</align><aligny>center</aligny><scroll>true</scroll>
			</control>
			<control type="image">
				<centerleft>50%</centerleft><bottom>0</bottom><width>1008</width><height>1</height>
				<texture colordiffuse="text_secondary">colors/white.png</texture>
			</control>
			<control type="image">
				<centerleft>50%</centerleft><bottom>0</bottom><width>1008</width><height>3</height>
				<texture colordiffuse="glass_focus_heavy">colors/white.png</texture>
				<visible>Control.HasFocus(16998)</visible>
			</control>
		</control>
		<control type="panel" id="16992">
			<centerleft>50%</centerleft><top>106</top><width>1008</width><height>128</height>
			<orientation>vertical</orientation>
			<include>NaraSearchKeyboardNavigation</include>
			<onup>16998</onup>
			<ondown condition="!String.IsEmpty(Window(home).Property(Search.NumbersVisible))">16994</ondown>
			<ondown>noop</ondown>
			<onleft>16992</onleft><onright>16992</onright>
			<itemlayout width="72" height="64"><include>NaraSearchKeyboardItemLayout</include></itemlayout>
			<focusedlayout width="72" height="64">
				<include content="NaraSearchKeyboardItemLayout">
					<param name="focused" value="Control.HasFocus(16992)" />
				</include>
			</focusedlayout>
			<content>
				<item><label>A</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputA</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>B</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputB</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>C</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputC</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>D</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputD</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>E</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputE</include><onclick>SetFocus(16992)</onclick></item>
