	<include name="NaraSearchBackground">
		<!-- 三层，自下而上：
		     ① 兜底渐变 primary.jpg @50%（默认一直铺着，所以不需要纯黑底）
		     ② 空查询随机剧照（同「文件 / 收藏夹」那一套数据源）
		     ③ 搜索结果剧照（聚焦条目有 fanart 时）
		     ②③ 都必须是 stretch：Kodi 的 aspectratio 只有 keep/scale/center/stretch，
		     没有"放大并裁切"，用 scale 时非 16:9 的图会留缝、露出下层的渐变。
		     ②（空查询）也要吃同一套蒙层 + 左侧渐变，否则 80% 直接叠在深色兜底上
		     会明显比首页亮一档（2026-10-31 统一口径）。 -->
		<control type="image">
			<include>FullScreenDimensions</include>
			<aspectratio>stretch</aspectratio>
			<texture colordiffuse="search_backdrop">special://skin/extras/backgrounds/primary.jpg</texture>
		</control>
		<!-- ② 空查询随机剧照：照「文件 / 收藏夹」的写法，只是改成 stretch 铺满 -->
		<control type="image">
			<include>FullScreenDimensions</include>
			<aspectratio>stretch</aspectratio>
			<fadetime>250</fadetime>
			<texture background="true" colordiffuse="CCFFFFFF">$VAR[NaraSharedRandomFanartVar]</texture>
			<visible>String.IsEmpty(Control.GetLabel(16999).index(1)) + !Skin.HasSetting(no_fanart) + ![String.IsEmpty(Skin.String(Nara.SharedRandomFanart.LockedPath)) + String.IsEmpty(Window(home).Property(Home.SharedRandomFanart.SessionPath)) + String.IsEmpty(Container(16090).ListItem.Art(fanart))]</visible>
		</control>
		<!-- 剧照必须铺满：Kodi 的 aspectratio 只有 keep/scale/center/stretch，
		     没有"放大并裁切"，所以只能用 stretch。16:9 的剧照完全不变形，
		     非 16:9（例如 1.58）会被横向拉宽一点，作为全屏背景看不出来。 -->
		<control type="image" id="16590">
			<include>FullScreenDimensions</include>
			<aspectratio>stretch</aspectratio>
			<fadetime>350</fadetime>
			<texture background="true">$VAR[NaraSearchFanartVar]</texture>
			<include content="Animation_NaraFanartDetail">
				<param name="source" value="search" />
			</include>
			<visible>!String.IsEmpty(Control.GetLabel(16999).index(1)) + !Skin.HasSetting(no_fanart) + [[$EXP[NaraSearchMoviesActive] + !String.IsEmpty(Container(16101).ListItem.Art(fanart))] | [$EXP[NaraSearchTVShowsActive] + !String.IsEmpty(Container(16102).ListItem.Art(fanart))]]</visible>
			<animation effect="fade" time="400">VisibleChange</animation>
		</control>
		<control type="image">
			<width>100%</width>
			<height>220</height>
			<aspectratio>stretch</aspectratio>
			<texture flipy="true" colordiffuse="33FFFFFF">overlays/overlayfade.png</texture>
		</control>
		<include content="NaraFanartReveal">
			<param name="source" value="16590" />
			<param name="enabled" value="[Control.HasFocus(16101) | Control.HasFocus(16102)] + !System.HasActiveModalDialog" />
			<param name="visible" value="!Skin.HasSetting(no_fanart) + [[!String.IsEmpty(Control.GetLabel(16999).index(1)) + $EXP[NaraSearchMoviesActive] + !String.IsEmpty(Container(16101).ListItem.Art(fanart))] | [!String.IsEmpty(Control.GetLabel(16999).index(1)) + $EXP[NaraSearchTVShowsActive] + !String.IsEmpty(Container(16102).ListItem.Art(fanart))] | [String.IsEmpty(Control.GetLabel(16999).index(1)) + ![String.IsEmpty(Skin.String(Nara.SharedRandomFanart.LockedPath)) + String.IsEmpty(Window(home).Property(Home.SharedRandomFanart.SessionPath)) + String.IsEmpty(Container(16090).ListItem.Art(fanart))]]]" />
		</include>
		<control type="image">
			<width>1200</width>
			<height>1080</height>
			<aspectratio>stretch</aspectratio>
			<texture>overlays/detail-left-scrim.png</texture>
			<visible>[!String.IsEmpty(Control.GetLabel(16999).index(1)) + $EXP[NaraSearchMoviesActive] + !Skin.HasSetting(no_fanart) + !String.IsEmpty(Container(16101).ListItem.Art(fanart))] | [!String.IsEmpty(Control.GetLabel(16999).index(1)) + $EXP[NaraSearchTVShowsActive] + !Skin.HasSetting(no_fanart) + !String.IsEmpty(Container(16102).ListItem.Art(fanart))] | [String.IsEmpty(Control.GetLabel(16999).index(1)) + !Skin.HasSetting(no_fanart) + ![String.IsEmpty(Skin.String(Nara.SharedRandomFanart.LockedPath)) + String.IsEmpty(Window(home).Property(Home.SharedRandomFanart.SessionPath)) + String.IsEmpty(Container(16090).ListItem.Art(fanart))]]</visible>
			<animation effect="fade" time="400">VisibleChange</animation>
		</control>
		<control type="image">
			<top>420</top>
			<!-- 宽度必须百分比：皮肤在 18:9（2160×1080）等分辨率下坐标空间不是 1920 -->
			<width>100%</width>
			<height>660</height>
			<aspectratio>stretch</aspectratio>
			<texture colordiffuse="opacity_medium">overlays/overlayfade.png</texture>
			<visible>!String.IsEmpty(Control.GetLabel(16999).index(1))</visible>
		</control>
	</include>
