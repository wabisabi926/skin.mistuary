		<control type="panel" id="16994">
			<centerleft>50%</centerleft><top>258</top><width>720</width><height>64</height>
			<orientation>vertical</orientation>
			<include>NaraSearchKeyboardNavigation</include>
			<onup>16992</onup><ondown>noop</ondown>
			<onleft>16994</onleft><onright>16994</onright>
			<!-- The toggle can focus this row before the next visibility update. -->
