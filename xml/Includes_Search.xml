				<item><label>H</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputH</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>I</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputI</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>J</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputJ</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>K</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputK</include><onclick>SetFocus(16992)</onclick></item>
				<item><label>L</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInputL</include><onclick>SetFocus(16992)</onclick></item>
