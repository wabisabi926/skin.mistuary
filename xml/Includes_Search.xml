			<itemlayout width="72" height="64"><include>NaraSearchKeyboardItemLayout</include></itemlayout>
			<focusedlayout width="72" height="64">
				<include content="NaraSearchKeyboardItemLayout">
					<param name="focused" value="Control.HasFocus(16994)" />
				</include>
			</focusedlayout>
			<content>
				<item><label>$VAR[NaraSearchNumber1]</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInput1</include><onclick>SetFocus(16994)</onclick></item>
				<item><label>$VAR[NaraSearchNumber2]</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInput2</include><onclick>SetFocus(16994)</onclick></item>
				<item><label>$VAR[NaraSearchNumber3]</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInput3</include><onclick>SetFocus(16994)</onclick></item>
				<item><label>$VAR[NaraSearchNumber4]</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInput4</include><onclick>SetFocus(16994)</onclick></item>
				<item><label>$VAR[NaraSearchNumber5]</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInput5</include><onclick>SetFocus(16994)</onclick></item>
				<item><label>$VAR[NaraSearchNumber6]</label><onclick>SetFocus(16999)</onclick><include>NaraSearchInput6</include><onclick>SetFocus(16994)</onclick></item>
