<?xml version="1.0" encoding="utf-8"?>
<window type="dialog" id="1102">
	<defaultcontrol always="true">1000</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<!-- 弹窗压在插件详情 / 详情页上时，只有遮蔽层 + 玻璃面板，下层窗口的行和文字
		     会透成鬼影（「版本变更」叠在插件详情上最明显）。这里先铺一层不透明共享剧照
		     （与插件信息 / 插件设置 / 依赖弹窗同一张、同一 fanart_dim），
		     透出来的是一张图，不是另一个窗口的文字。 -->
		<control type="list" id="16090">
			<left>-2</left>
			<top>-2</top>
			<width>1</width>
			<height>1</height>
			<itemlayout width="1" height="1" />
			<focusedlayout width="1" height="1" />
			<content sortby="random" sortorder="ascending" limit="1" target="videos" browse="never">videodb://movies/titles/</content>
			<visible>String.IsEmpty(Skin.String(Nara.SharedRandomFanart.LockedPath)) + String.IsEmpty(Window(home).Property(Home.SharedRandomFanart)) + String.IsEmpty(Window(home).Property(Home.SharedRandomFanart.SessionPath))</visible>
		</control>
		<control type="image">
			<include>FullScreenDimensions</include>
			<aspectratio align="right">scale</aspectratio>
			<texture background="true" colordiffuse="fanart_dim">$VAR[NaraFileManagerRandomFanartVar]</texture>
			<visible>$EXP[nara_page_shared_fanart_visible]</visible>
		</control>
		<control type="image">
			<width>100%</width>
			<height>100%</height>
			<texture colordiffuse="$VAR[NaraGlassFloatScrimVar]">colors/black.png</texture>
		</control>
		<control type="button">
			<width>100%</width>
			<height>100%</height>
			<texturefocus />
			<texturenofocus />
			<onclick>Action(Close)</onclick>
		</control>
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>1500</width>
			<height>550</height>
			<control type="image">
				<width>100%</width>
				<height>100%</height>
				<texture colordiffuse="$VAR[NaraGlassPageTintVar]" border="20">shapes/glass20.png</texture>
			</control>
			<control type="button" id="22002">
				<width>100%</width>
				<height>100%</height>
				<texturefocus />
				<texturenofocus />
				<onclick>noop</onclick>
				<onup>PageUp(3000)</onup>
				<ondown>PageDown(3000)</ondown>
			</control>
			<control type="label" id="1">
				<left>48</left>
				<top>32</top>
				<width>1404</width>
				<height>44</height>
				<font>font32</font>
				<label>$INFO[Window(home).Property(TextViewer_Header)]</label>
			</control>
			<control type="textbox" id="2000">
				<left>48</left>
				<top>96</top>
				<width>1404</width>
				<height>406</height>
				<pagecontrol>3000</pagecontrol>
				<font>font30_title</font>
				<label>$INFO[Window(home).Property(TextViewer_Text)]</label>
			</control>
			<control type="scrollbar" id="3000">
				<right>24</right>
				<top>96</top>
				<width>6</width>
				<height>406</height>
				<orientation>vertical</orientation>
				<onleft>1000</onleft>
				<onright>1000</onright>
				<onup>3000</onup>
				<ondown>3000</ondown>
				<texturesliderbackground colordiffuse="border_subtle" border="3">shapes/round3.png</texturesliderbackground>
				<texturesliderbar colordiffuse="text_muted" border="3">shapes/round3.png</texturesliderbar>
				<texturesliderbarfocus colordiffuse="text_primary" border="3">shapes/round3.png</texturesliderbarfocus>
				<visible>Integer.IsGreater(Container(2000).NumPages,1)</visible>
			</control>
		</control>
		<control type="button" id="1000">
			<include>HiddenObject</include>
			<onclick>Action(Close)</onclick>
			<onup>PageUp(3000)</onup>
			<ondown>PageDown(3000)</ondown>
			<onright condition="Integer.IsGreater(Container(2000).NumPages,1)">3000</onright>
		</control>
	</controls>
</window>
