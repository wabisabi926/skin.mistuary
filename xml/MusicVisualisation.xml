<?xml version="1.0" encoding="UTF-8"?>
<window>
	<onload condition="!Player.PauseEnabled">SetFocus(70048)</onload>
	<defaultcontrol always="true">602</defaultcontrol>
	<backgroundcolor>FF000000</backgroundcolor>
	<controls>
		<include>NaraMusicPlayerBackground</include>
		<control type="group">
			<animation effect="fade" start="0" end="100" time="260">WindowOpen</animation>
			<control type="label">
				<left>40</left>
				<top>28</top>
				<width>800</width>
				<height>36</height>
				<font>font27</font>
				<aligny>center</aligny>
				<textcolor>text_primary</textcolor>
				<label>$LOCALIZE[31000]...</label>
				<visible>!PVR.IsPlayingRadio</visible>
			</control>
			<control type="label">
				<left>40</left>
				<top>64</top>
				<width>800</width>
				<height>32</height>
				<font>font12_large</font>
				<aligny>center</aligny>
				<textcolor>text_secondary</textcolor>
				<label>$LOCALIZE[554] $INFO[Playlist.Position(music)] / $INFO[Playlist.Length(music)]</label>
				<visible>!PVR.IsPlayingRadio + Integer.IsGreater(Playlist.Length(music),0)</visible>
			</control>
			<control type="label">
				<right>40</right>
				<top>28</top>
				<width>240</width>
				<height>68</height>
				<font>font_home_clock</font>
				<textcolor>text_primary</textcolor>
				<align>right</align>
				<aligny>center</aligny>
				<label>$INFO[System.Time]</label>
			</control>
			<control type="image" id="434">
				<left>196</left>
				<top>166</top>
				<width>498</width>
				<height>498</height>
				<texture border="40" colordiffuse="4D000000">overlays/shadow.png</texture>
				<visible>[!String.IsEmpty(Window(visualisation).Property(NaraMusic.Cover)) + !String.IsEqual(Window(visualisation).Property(NaraMusic.Cover),DefaultAlbumCover.png)] | [PVR.IsPlayingRadio + !String.IsEmpty(MusicPlayer.Cover) + !String.IsEqual(MusicPlayer.Cover,DefaultAlbumCover.png)]</visible>
			</control>
			<control type="image" id="431">
				<left>136</left>
				<top>106</top>
				<width>618</width>
				<height>618</height>
				<colordiffuse>00FFFFFF</colordiffuse>
				<texture>osd/nara/music-cover-glow.png</texture>
			</control>
			<control type="image" id="430">
				<left>220</left>
				<top>190</top>
				<width>450</width>
				<height>450</height>
				<aspectratio>keep</aspectratio>
				<fadetime>320</fadetime>
				<texture background="true">$VAR[NaraMusicCoverVar]</texture>
				<visible>!String.IsEmpty(Window(visualisation).Property(NaraMusic.Cover)) | PVR.IsPlayingRadio</visible>
			</control>
			<control type="grouplist" id="432">
				<left>220</left>
				<top>190</top>
				<width>450</width>
				<height>450</height>
				<orientation>vertical</orientation>
				<usecontrolcoords>true</usecontrolcoords>
				<control type="image" id="433">
					<width>450</width>
					<height>450</height>
					<colordiffuse>00FFFFFF</colordiffuse>
					<texture>osd/nara/music-cover-sheen.png</texture>
				</control>
			</control>
			<control type="label">
				<left>220</left>
				<top>674</top>
				<width>640</width>
				<height>56</height>
				<font>font40_title</font>
				<label>$INFO[Player.Title]</label>
				<scroll>true</scroll>
			</control>
			<control type="label">
				<left>220</left>
				<top>738</top>
				<width>640</width>
				<height>36</height>
				<font>font27</font>
				<textcolor>BFFFFFFF</textcolor>
				<label>$INFO[MusicPlayer.Artist]</label>
				<scroll>true</scroll>
			</control>
			<control type="label">
				<left>220</left>
				<top>780</top>
				<width>640</width>
				<height>32</height>
				<font>font12</font>
				<textcolor>80FFFFFF</textcolor>
				<label>$VAR[NaraMusicAlbumYearVar]</label>
				<scroll>true</scroll>
			</control>
			<control type="grouplist">
				<right>160</right>
				<bottom>163</bottom>
				<width>800</width>
				<height>28</height>
				<orientation>horizontal</orientation>
				<align>right</align>
				<itemgap>16</itemgap>
				<include content="NaraMusicAudioDetail">
					<param name="info" value="MusicPlayer.Codec" />
					<param name="label" value="[UPPERCASE]$INFO[MusicPlayer.Codec][/UPPERCASE]" />
				</include>
				<include content="NaraMusicAudioDetail">
					<param name="info" value="MusicPlayer.BitsPerSample" />
					<param name="label" value="$INFO[MusicPlayer.BitsPerSample,, bit]" />
				</include>
				<include content="NaraMusicAudioDetail">
					<param name="info" value="MusicPlayer.SampleRate" />
					<param name="label" value="$INFO[MusicPlayer.SampleRate,, kHz]" />
				</include>
				<include content="NaraMusicAudioDetail">
					<param name="info" value="MusicPlayer.BitRate" />
					<param name="label" value="$INFO[MusicPlayer.BitRate,, kbps]" />
				</include>
				<include content="NaraMusicAudioDetail">
					<param name="info" value="MusicPlayer.Channels" />
					<param name="label" value="$INFO[MusicPlayer.Channels,, ch]" />
				</include>
			</control>
			<control type="fixedlist" id="420">
				<left>960</left>
				<top>150</top>
				<width>800</width>
				<height>622</height>
				<focusposition>3</focusposition>
				<movement>0</movement>
				<scrolltime tween="sine">300</scrolltime>
				<onleft>602</onleft>
				<onright>602</onright>
				<onup>420</onup>
				<ondown>420</ondown>
				<onclick>SetFocus(602)</onclick>
				<visible>String.IsEqual(Window(visualisation).Property(NaraMusic.LyricsTimed),true) + !Window.IsVisible(script-cu-lrclyrics-main.xml)</visible>
				<include>NaraMusicLyricsFade</include>
				<itemlayout width="800" height="72">
					<control type="label">
						<width>790</width>
						<height>72</height>
						<font>font_nara_music_lyric_context</font>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
						<textcolor>4DFFFFFF</textcolor>
					</control>
				</itemlayout>
				<focusedlayout width="800" height="180">
					<control type="textbox">
						<top>12</top>
						<width>790</width>
						<height>156</height>
						<font>font_nara_music_lyric</font>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
						<textcolor>$VAR[NaraMusicLyricColorVar]</textcolor>
						<autoscroll delay="1800" time="1400" repeat="5000">true</autoscroll>
					</control>
				</focusedlayout>
			</control>
			<control type="textbox" id="421">
				<left>960</left>
				<top>150</top>
				<width>770</width>
				<height>622</height>
				<font>font27</font>
				<textcolor>CFFFFFFF</textcolor>
				<label>$INFO[Window(visualisation).Property(NaraMusic.LyricsText)]</label>
				<pagecontrol>422</pagecontrol>
				<visible>!String.IsEmpty(Window(visualisation).Property(NaraMusic.LyricsText)) + !Window.IsVisible(script-cu-lrclyrics-main.xml)</visible>
				<include>NaraMusicLyricsFade</include>
			</control>
			<control type="scrollbar" id="422">
				<left>1760</left>
				<top>150</top>
				<width>6</width>
				<height>622</height>
				<orientation>vertical</orientation>
				<onleft>602</onleft>
				<onright>602</onright>
				<visible>!String.IsEmpty(Window(visualisation).Property(NaraMusic.LyricsText)) + !Window.IsVisible(script-cu-lrclyrics-main.xml)</visible>
				<include>NaraMusicLyricsFade</include>
			</control>
			<control type="group">
				<left>960</left>
				<top>350</top>
				<width>800</width>
				<height>300</height>
				<visible>!String.IsEqual(Window(visualisation).Property(NaraMusic.LyricsTimed),true) + String.IsEmpty(Window(visualisation).Property(NaraMusic.LyricsText)) + !Window.IsVisible(script-cu-lrclyrics-main.xml)</visible>
				<include>NaraMusicLyricsFade</include>
				<control type="grouplist">
					<width>800</width>
					<height>260</height>
					<orientation>vertical</orientation>
					<itemgap>16</itemgap>
					<visible>!String.IsEmpty(Window(visualisation).Property(NaraMusic.NextTitle))</visible>
					<control type="label">
						<height>32</height>
						<font>font12</font>
						<textcolor>80FFFFFF</textcolor>
						<label>$VAR[NaraMusicNextHeadingVar]</label>
					</control>
					<control type="textbox">
						<width>790</width>
						<height min="48" max="112">auto</height>
						<font>font36_title</font>
						<textcolor>DFFFFFFF</textcolor>
						<label>$INFO[Window(visualisation).Property(NaraMusic.NextTitle)]</label>
					</control>
					<control type="label">
						<height>40</height>
						<font>font27</font>
						<textcolor>80FFFFFF</textcolor>
						<label>$INFO[Window(visualisation).Property(NaraMusic.NextArtist)]</label>
						<scroll>true</scroll>
						<visible>!String.IsEmpty(Window(visualisation).Property(NaraMusic.NextArtist))</visible>
					</control>
				</control>
				<control type="label">
					<top>80</top>
					<height>48</height>
					<font>font27</font>
					<textcolor>80FFFFFF</textcolor>
					<label>$VAR[NaraMusicLyricsStatusVar]</label>
					<visible>String.IsEmpty(Window(visualisation).Property(NaraMusic.NextTitle))</visible>
				</control>
			</control>
		</control>
		<control type="group">
			<visible>!Window.IsVisible(musicosd)</visible>
			<include>NaraMusicPlayerControls</include>
		</control>
	</controls>
</window>
