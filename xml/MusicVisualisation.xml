<?xml version="1.0" encoding="UTF-8"?>
<window>
	<!-- 歌词面板固定在播放页右侧：首次进入若未指定歌词插件，自动选中 CU LRC；
	     已指定则在页面打开时自动启动歌词脚本（窗口覆盖文件已把列表放在右侧、无全屏遮罩），
	     离开播放页时关闭歌词窗口。 -->
	<onload condition="String.IsEmpty(Skin.String(LyricScript_Path)) + System.HasAddon(script.cu.lrclyrics)">Skin.SetString(LyricScript_Path,script.cu.lrclyrics)</onload>
	<!-- 不能写 System.HasAddon($INFO[...])：Kodi 的布尔表达式解析器不认嵌套的 $INFO，
	     会直接报 "Misplaced [" 然后整条条件失效 —— 歌词脚本永远不启动。
	     这里只判路径非空；插件真缺了 RunScript 自己会报错，不影响其它功能。 -->
	<onload condition="!String.IsEmpty(Skin.String(LyricScript_Path))">RunScript($INFO[Skin.String(LyricScript_Path)])</onload>
	<onunload>Dialog.Close(script-cu-lrclyrics-main)</onunload>
	<backgroundcolor>FF000000</backgroundcolor>
	<controls>
		<include>NaraMusicPlayerBackground</include>
		<control type="group">
			<animation effect="fade" start="0" end="100" time="260">WindowOpen</animation>
			<control type="label">
				<left>40</left>
				<top>28</top>
				<width>800</width>
				<height>36</height>
				<font>font27</font>
				<aligny>center</aligny>
				<textcolor>text_primary</textcolor>
				<label>$LOCALIZE[31000]...</label>
				<visible>!PVR.IsPlayingRadio</visible>
			</control>
			<control type="label">
				<left>40</left>
				<top>64</top>
				<width>800</width>
				<height>32</height>
				<font>font12_large</font>
				<aligny>center</aligny>
				<textcolor>text_secondary</textcolor>
				<label>$LOCALIZE[554] $INFO[Playlist.Position(music)] / $INFO[Playlist.Length(music)]</label>
				<visible>!PVR.IsPlayingRadio + Integer.IsGreater(Playlist.Length(music),0)</visible>
			</control>
			<control type="label">
				<right>40</right>
				<top>28</top>
				<width>240</width>
				<height>68</height>
				<font>font_home_clock</font>
				<textcolor>text_primary</textcolor>
				<align>right</align>
				<aligny>center</aligny>
				<label>$INFO[System.Time]</label>
			</control>
			<control type="image" id="434">
				<left>196</left>
				<top>166</top>
				<width>498</width>
				<height>498</height>
				<texture border="40" colordiffuse="4D000000">overlays/shadow.png</texture>
			</control>
			<control type="image" id="431">
				<left>136</left>
				<top>106</top>
				<width>618</width>
				<height>618</height>
				<colordiffuse>00FFFFFF</colordiffuse>
				<texture>osd/nara/music-cover-glow.png</texture>
			</control>
			<!-- 封面真圆角：正方形盒子 + 正方形专辑图，遮罩 1:1。
			     这里**不加 scalediffuse="false"**：keep 时图片可能比控件窄，
			     遮罩要跟着图片走才能保证圆角真的落在图上（默认 true 就是这个行为）。 -->
			<control type="image" id="430">
				<left>220</left>
				<top>190</top>
				<width>450</width>
				<height>450</height>
				<aspectratio>keep</aspectratio>
				<fadetime>320</fadetime>
				<texture background="true" diffuse="shapes/mask_450x450_r12.png">$VAR[NaraMusicCoverVar]</texture>
				<visible>!Skin.HasSetting(vinyl_mode)</visible>
			</control>
			<control type="grouplist" id="432">
				<left>220</left>
				<top>190</top>
				<width>450</width>
				<height>450</height>
				<orientation>vertical</orientation>
				<usecontrolcoords>true</usecontrolcoords>
				<visible>!Skin.HasSetting(vinyl_mode)</visible>
				<control type="image" id="433">
					<width>450</width>
					<height>450</height>
					<colordiffuse>00FFFFFF</colordiffuse>
					<texture>osd/nara/music-cover-sheen.png</texture>
				</control>
			</control>
			<!-- 黑胶模式（设置 → 屏幕菜单式调节 → 黑胶唱片效果）。
			     盘面 520 / 圆封面 340（封面占 65%，比例对齐主流音乐 App）。
			     盘面底边 665，标题在 674，所以**不用动文字排版**。
			     转速 24s/圈：暂停时条件动画会 reset 回 0°，周期拉长能把跳变压到最小。 -->
			<control type="group" id="435">
				<visible>Skin.HasSetting(vinyl_mode)</visible>
				<control type="image">
					<left>185</left>
					<top>145</top>
					<width>520</width>
					<height>520</height>
					<texture>osd/nara/vinyl-disc.png</texture>
					<animation effect="rotate" start="0" end="360" loop="true" time="24000"
					           center="auto" condition="Player.Playing">Conditional</animation>
				</control>
				<control type="image">
					<left>275</left>
					<top>235</top>
					<width>340</width>
					<height>340</height>
					<texture background="true" diffuse="masks/circle.png">$VAR[NaraVinylCoverVar]</texture>
					<animation effect="rotate" start="0" end="360" loop="true" time="24000"
					           center="auto" condition="Player.Playing">Conditional</animation>
				</control>
				<control type="image">
					<left>360</left>
					<top>70</top>
					<width>460</width>
					<height>660</height>
					<texture>osd/nara/vinyl-tonearm.png</texture>
					<animation effect="rotate" start="-18" end="0" time="700" reversible="true"
					           center="400,60" condition="Player.Playing">Conditional</animation>
				</control>
			</control>
			<control type="label">
				<left>220</left>
				<top>674</top>
				<width>640</width>
				<height>56</height>
				<font>font40_title</font>
				<label>$INFO[Player.Title]</label>
				<scroll>true</scroll>
			</control>
			<control type="label">
				<left>220</left>
				<top>738</top>
				<width>640</width>
				<height>36</height>
				<font>font27</font>
				<textcolor>BFFFFFFF</textcolor>
				<label>$INFO[MusicPlayer.Artist]</label>
				<scroll>true</scroll>
			</control>
			<control type="label">
				<left>220</left>
				<top>780</top>
				<width>640</width>
				<height>32</height>
				<font>font12</font>
				<textcolor>80FFFFFF</textcolor>
				<label>$VAR[NaraMusicAlbumYearVar]</label>
				<scroll>true</scroll>
			</control>
			<control type="grouplist">
				<left>80</left>
				<bottom>40</bottom>
				<width>800</width>
				<height>28</height>
				<orientation>horizontal</orientation>
				<align>left</align>
				<itemgap>16</itemgap>
				<include content="NaraMusicAudioDetail">
					<param name="info" value="MusicPlayer.Codec" />
					<param name="label" value="[UPPERCASE]$INFO[MusicPlayer.Codec][/UPPERCASE]" />
				</include>
				<include content="NaraMusicAudioDetail">
					<param name="info" value="MusicPlayer.BitsPerSample" />
					<param name="label" value="$INFO[MusicPlayer.BitsPerSample,, bit]" />
				</include>
				<include content="NaraMusicAudioDetail">
					<param name="info" value="MusicPlayer.SampleRate" />
					<param name="label" value="$INFO[MusicPlayer.SampleRate,, kHz]" />
				</include>
				<include content="NaraMusicAudioDetail">
					<param name="info" value="MusicPlayer.BitRate" />
					<param name="label" value="$INFO[MusicPlayer.BitRate,, kbps]" />
				</include>
				<include content="NaraMusicAudioDetail">
					<param name="info" value="MusicPlayer.Channels" />
					<param name="label" value="$INFO[MusicPlayer.Channels,, ch]" />
				</include>
			</control>
			<control type="group">
				<left>960</left>
				<top>350</top>
				<width>800</width>
				<height>300</height>
				<!-- 原来这里还判 NaraMusic.LyricsTimed / LyricsText，但这两个属性全皮肤没人写入
				     （CU LRC 用的是自己的窗口），恒为假/空，等于只判歌词窗口是否打开。已简化。 -->
				<visible>!Window.IsVisible(script-cu-lrclyrics-main.xml)</visible>
				<include>NaraMusicLyricsFade</include>
				<control type="grouplist">
					<width>800</width>
					<height>260</height>
					<orientation>vertical</orientation>
					<itemgap>16</itemgap>
					<visible>!String.IsEmpty(Window(visualisation).Property(NaraMusic.NextTitle))</visible>
					<control type="label">
						<height>32</height>
						<font>font12</font>
						<textcolor>80FFFFFF</textcolor>
						<label>$VAR[NaraMusicNextHeadingVar]</label>
					</control>
					<control type="textbox">
						<width>790</width>
						<height min="48" max="112">auto</height>
						<font>font36_title</font>
						<textcolor>DFFFFFFF</textcolor>
						<label>$INFO[Window(visualisation).Property(NaraMusic.NextTitle)]</label>
					</control>
					<control type="label">
						<height>40</height>
						<font>font27</font>
						<textcolor>80FFFFFF</textcolor>
						<label>$INFO[Window(visualisation).Property(NaraMusic.NextArtist)]</label>
						<scroll>true</scroll>
						<visible>!String.IsEmpty(Window(visualisation).Property(NaraMusic.NextArtist))</visible>
					</control>
				</control>
				<control type="label">
					<top>80</top>
					<height>48</height>
					<font>font27</font>
					<textcolor>80FFFFFF</textcolor>
					<label>$VAR[NaraMusicLyricsStatusVar]</label>
					<visible>String.IsEmpty(Window(visualisation).Property(NaraMusic.NextTitle))</visible>
				</control>
			</control>
		</control>
	</controls>
</window>
