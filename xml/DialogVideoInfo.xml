<?xml version="1.0" encoding="utf-8"?>
<window>
	<defaultcontrol always="true">5000</defaultcontrol>
	<onload>ClearProperty(VideoInfo.More,home)</onload>
	<onload>Skin.Reset(nara_cast_open)</onload>
	<onload>SetFocus(5000)</onload>
	<onload>SetProperty(infobackground,$ESCINFO[ListItem.Art(fanart)],home)</onload>
	<!-- Keep the backdrop owner stable while other modal dialogs are open. -->
	<onload>SetProperty(VideoInfo.FanartSource,$VAR[NaraVideoInfoFanartSourceVar])</onload>
	<!-- 豆瓣评分来自可选插件：先清掉上一条的状态，避免详情页切换时闪旧分数；
	     只对电影/剧集请求，单集与季不显示豆瓣。 -->
	<onload>ClearProperty(Mistuary.Rating.Status,home)</onload>
	<!-- 标题可能带逗号，不能塞进 RunScript 参数；走窗口属性，插件在没有 IMDb 时按标题+年份兜底。 -->
	<onload>SetProperty(Mistuary.Rating.Query,$INFO[ListItem.Title])</onload>
	<onload>SetProperty(Mistuary.Rating.Year,$INFO[ListItem.Year])</onload>
	<onload condition="System.AddonIsEnabled(script.mistuary.helper) + [String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,tvshow)]">RunScript(script.mistuary.helper,action=rating,type=$INFO[ListItem.DBType],dbid=$INFO[ListItem.DBID],imdb=$INFO[ListItem.IMDBNumber])</onload>
	<onunload>ClearProperty(Mistuary.Rating.Status,home)</onunload>
	<onunload>ClearProperty(Mistuary.Rating.Query,home)</onunload>
	<onunload>ClearProperty(Mistuary.Rating.Year,home)</onunload>
	<onunload>ClearProperty(infobackground,home)</onunload>
	<onunload>ClearProperty(VideoInfo.More,home)</onunload>
	<controls>
		<!-- Kodi's built-in video-information actions. Visible skin controls
		     forward to these IDs instead of duplicating playback, library or
		     favourite behaviour. -->
		<control type="button" id="6">
			<include>HiddenObject</include>
		</control>
		<control type="button" id="7">
			<enable>String.IsEmpty(Container.PluginName) + !Container.Content(Sets)</enable>
			<include>HiddenObject</include>
		</control>
		<control type="togglebutton" id="8">
			<include>HiddenObject</include>
		</control>
		<control type="button" id="10">
			<include>HiddenObject</include>
		</control>
		<control type="button" id="11">
			<include>HiddenObject</include>
		</control>
		<control type="button" id="13">
			<include>HiddenObject</include>
		</control>
		<control type="button" id="14">
			<include>HiddenObject</include>
		</control>
		<control type="button" id="15">
			<include>HiddenObject</include>
		</control>
		<control type="button" id="16">
			<include>HiddenObject</include>
		</control>
		<control type="button" id="17">
			<include>HiddenObject</include>
		</control>
		<!-- Back target for the in-page More menu. Routing Back through a real
		     control prevents it from bubbling up and closing the info dialog. -->
		<control type="button" id="5198">
			<include>HiddenObject</include>
			<onfocus>ClearProperty(VideoInfo.More,home)</onfocus>
			<onfocus>SetFocus(5003)</onfocus>
		</control>
		<!-- Full-bleed cinematic page. -->
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>100%</width>
			<height>100%</height>
			<animation effect="fade" start="100" end="0" time="180">WindowClose</animation>
			<animation effect="fade" start="100" end="0" time="200" tween="sine" condition="Window.IsVisible(script-embuary-video.xml) | Window.IsVisible(script-embuary-person.xml) | Window.IsVisible(script-embuary-image.xml)">Conditional</animation>
			<!-- Backdrop and layered scrims. -->
			<!-- 外扩尺寸而不是写死 1920×1080：Kodi 在 17:9 等宽画布（2040+）下会右侧露底 -->
			<control type="image">
				<left>-120</left>
				<top>-80</top>
				<right>-120</right>
				<bottom>-80</bottom>
				<aspectratio>scale</aspectratio>
				<texture colordiffuse="primary_background_info">special://skin/extras/backgrounds/primary.jpg</texture>
				<animation effect="fade" start="0" end="100" time="260">WindowOpen</animation>
				<visible>Skin.HasSetting(no_fanart) | String.IsEmpty(ListItem.Art(fanart))</visible>
			</control>
			<control type="image" id="5900">
				<left>-120</left>
				<top>-80</top>
				<right>-120</right>
				<bottom>-80</bottom>
				<aspectratio align="right">scale</aspectratio>
				<fadetime>250</fadetime>
				<texture background="true">$INFO[ListItem.Art(fanart)]</texture>
				<animation effect="zoom" start="100" end="104" center="80%,35%" time="500" tween="sine" easing="inout" condition="!Window.IsVisible(11111) + !$EXP[NaraVideoInfoFromHome] + !Window.IsVisible(videos)">WindowOpen</animation>
				<!-- Preserve the completed entry zoom while the page fades out. -->
				<animation effect="zoom" start="104" end="104" center="80%,35%" time="0" condition="String.IsEqual(Window.Property(VideoInfo.FanartSource),fallback)">WindowClose</animation>
				<visible>!Skin.HasSetting(no_fanart) + !String.IsEmpty(ListItem.Art(fanart))</visible>
			</control>
			<include content="NaraFanartReveal">
				<param name="source" value="5900" />
				<param name="visible" value="!Skin.HasSetting(no_fanart) + !String.IsEmpty(ListItem.Art(fanart))" />
			</include>
			<!-- Detail-only left reading scrim. A dedicated horizontal texture
			     keeps its dark edge deterministic and lighter than Fuse.
			     **left 必须给负值**：外层分组是 1920 宽居中，在 2040 画布上起点在 x=60，
			     不给偏移的话最左边 60px 会完全没有压暗，露一条亮带。 -->
			<control type="image">
				<left>-120</left>
				<width>1320</width>
				<height>1080</height>
				<aspectratio>stretch</aspectratio>
				<texture>overlays/detail-left-scrim.png</texture>
				<visible>!Skin.HasSetting(no_fanart) + !String.IsEmpty(ListItem.Art(fanart))</visible>
			</control>
			<control type="image">
				<top>420</top>
				<left>-120</left>
				<right>-120</right>
				<height>660</height>
				<aspectratio>stretch</aspectratio>
				<texture colordiffuse="opacity_medium">overlays/overlayfade.png</texture>
			</control>
			<control type="group">
				<animation effect="fade" start="0" end="100" time="260">WindowOpen</animation>
				<control type="group">
					<left>1250</left>
					<top>100</top>
					<visible>[Skin.HasSetting(no_fanart) | String.IsEmpty(ListItem.Art(fanart))] + [!String.IsEmpty(ListItem.Art(poster)) | !String.IsEmpty(ListItem.Art(season.poster)) | !String.IsEmpty(ListItem.Art(tvshow.poster))]</visible>
					<control type="image">
						<left>-24</left>
						<top>-24</top>
						<width>500</width>
						<height>720</height>
						<texture colordiffuse="shadow_hard" border="21">overlays/shadow.png</texture>
					</control>
					<control type="image">
						<width>452</width>
						<height>672</height>
						<aspectratio scalediffuse="false">scale</aspectratio>
						<texture background="true" diffuse="shapes/mask_452x672_r12.png">$VAR[InfoDialogPosterVar]</texture>
					</control>
				</control>
				<!-- Shared hero structure keeps the movie/TV metadata-row rhythm and a single
				     set of focus IDs while the TV header moves upward above its anchored plot. -->
				<control type="group">
					<left>80</left>
					<top>175</top>
					<width>1180</width>
					<height>640</height>
					<animation effect="slide" start="-70,0" end="0,0" time="360" tween="cubic" easing="out">WindowOpen</animation>
					<control type="group">
						<top>27</top>
						<include content="VideoInfoHeroContent">
							<param name="synopsis_focusable" value="true" />
							<param name="synopsis_navigation" value="5000" />
							<param name="synopsis_height" value="105" />
							<param name="tv_synopsis_height" value="105" />
							<param name="ratings_top" value="131" />
							<param name="ratings_top_tv" value="131" />
							<param name="synopsis_focus_height" value="98" />
						</include>
					</control>
					<include>VideoInfoActionBar</include>
				</control>
				<!-- TV seasons, episodes and playback-target preview remain in this
				     viewport; the cast shelf becomes their final tab. -->
				<include>VideoInfoTvContent</include>
				<include>VideoInfoCastShelf</include>
			</control>
		</control>
		<!-- Context-menu style More dialog. It exists only while explicitly opened;
		     deferred focus makes the first click both open it and enter the list. -->
		<control type="group">
			<include>FullScreenDimensions</include>
			<visible>String.IsEqual(Window(Home).Property(VideoInfo.More),True)</visible>
			<animation effect="fade" start="0" end="100" time="160">Visible</animation>
			<animation effect="zoom" center="960,540" start="96" end="100" time="170" tween="cubic" easing="out">Visible</animation>
			<animation effect="fade" start="100" end="0" time="120">Hidden</animation>
			<control type="button" id="5110">
				<include>FullScreenDimensions</include>
				<label></label>
				<texturefocus colordiffuse="$VAR[NaraGlassScrimTintVar]">colors/black.png</texturefocus>
				<texturenofocus colordiffuse="$VAR[NaraGlassScrimTintVar]">colors/black.png</texturenofocus>
				<onclick>ClearProperty(VideoInfo.More,home)</onclick>
				<onclick>SetFocus(5003)</onclick>
			</control>
			<!-- Match DialogContextMenu's glass surface and keep its 12 px content inset
			     clear of the rounded border: 349 = 325 px list + 24 px padding. -->
			<control type="image">
				<centerleft>50%</centerleft>
				<centertop>50%</centertop>
				<width>480</width>
				<height>349</height>
				<texture colordiffuse="$VAR[NaraGlassFloatTintVar]" border="20">shapes/glass20.png</texture>
			</control>
			<control type="list" id="5199">
				<centerleft>50%</centerleft>
				<top>377.5</top>
				<width>456</width>
				<height>325</height>
				<orientation>vertical</orientation>
				<scrolltime>150</scrolltime>
				<onleft>5199</onleft>
				<onright>5199</onright>
				<onback>5198</onback>
				<itemlayout width="456" height="65">
					<control type="label">
						<width>456</width>
						<height>65</height>
						<font>font13</font>
						<align>center</align>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</itemlayout>
				<focusedlayout width="456" height="65">
					<control type="image">
						<width>456</width>
						<height>65</height>
						<texture colordiffuse="glass_focus_light" border="30">shapes/round30.png</texture>
					</control>
					<control type="label">
						<width>456</width>
						<height>65</height>
						<font>font13</font>
						<align>center</align>
						<aligny>center</aligny>
						<textcolor>text_primary</textcolor>
						<scroll>true</scroll>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</focusedlayout>
				<content>
					<item>
						<label>$LOCALIZE[31123]</label>
						<onclick>ClearProperty(VideoInfo.More,home)</onclick>
						<onclick>SetFocus(5003)</onclick>
						<onclick>SendClick(13)</onclick>
						<visible>!String.IsEmpty(ListItem.Director)</visible>
					</item>
					<item>
						<label>$LOCALIZE[31033]</label>
						<onclick>ClearProperty(VideoInfo.More,home)</onclick>
						<onclick>SetFocus(5003)</onclick>
						<onclick>SendClick(7)</onclick>
						<visible>Control.IsEnabled(7)</visible>
					</item>
					<item>
						<label>$LOCALIZE[31028]</label>
						<onclick>ClearProperty(VideoInfo.More,home)</onclick>
						<onclick>SetFocus(5003)</onclick>
						<onclick>SetProperty(fanart,$ESCINFO[ListItem.Art(fanart)],home)</onclick>
						<onclick>ActivateWindow(1104)</onclick>
						<visible>!String.IsEmpty(ListItem.Art(fanart))</visible>
					</item>
					<item>
						<label>$LOCALIZE[13511]</label>
						<onclick>ClearProperty(VideoInfo.More,home)</onclick>
						<onclick>SetFocus(5003)</onclick>
						<onclick>SendClick(10)</onclick>
						<visible>Control.IsEnabled(10)</visible>
					</item>
					<item>
						<label>$LOCALIZE[184]</label>
						<onclick>ClearProperty(VideoInfo.More,home)</onclick>
						<onclick>SetFocus(5003)</onclick>
						<onclick>SendClick(6)</onclick>
						<visible>Control.IsEnabled(6)</visible>
					</item>
				</content>
			</control>
		</control>
	</controls>
</window>
