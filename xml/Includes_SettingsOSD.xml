<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<include name="NaraOSDSettingsLayout">
		<definition>
			<control type="group">
				<!-- 面板 820 高：top 取 (1080-820)/2 = 130，上下留白对称。
				     原来面板 870 时 top=105（上 105 / 下 105）。列表缩短 50px 后若不动 top，
				     面板会明显偏上（下留 155）。 -->
				<top>130</top>
				<centerleft>50%</centerleft>
				<width>1520</width>
				<include>Animation_DialogPopupVisible</include>
				<visible>!Window.IsVisible(sliderdialog)</visible>
				<!-- 遮蔽层 -->
				<control type="image">
					<left>-2000</left>
					<top>-2000</top>
					<width>6000</width>
					<height>6000</height>
					<texture colordiffuse="$VAR[NaraSettingsDialogScrimVar]">colors/black.png</texture>
				</control>
				<!-- 面板：一整块显式图片（照抄 FileManager 的做法）。
				     原来这里用 DialogBackgroundCommons，它的内嵌 group 让面板位置不可控 ——
				     标题和右上角图标会跑到面板外面，还多出一层方角的半透明块。 -->
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>1520</width>
					<!-- 870 → 820：列表高度从 750 收到 700（10 整行）后，面板同步收 50 -->
					<height>820</height>
					<texture colordiffuse="$VAR[NaraPlaybackDialogTintVar]" border="20">shapes/glass20.png</texture>
				</control>
				<!-- 标题：id=2 由 Kodi 的设置窗口填入分组名 -->
				<control type="label" id="2">
					<left>48</left>
					<top>18</top>
					<width>1200</width>
					<height>56</height>
					<font>font32_title</font>
					<textcolor>text_primary</textcolor>
					<label></label>
					<aligny>center</aligny>
				</control>
				<!-- 右上角图标 -->
				<include>DialogHeaderIcon</include>
				<control type="grouplist" id="5">
					<description>control area</description>
					<left>29</left>
					<top>100</top>
					<width>1160</width>
					<!-- 必须是行高的整数倍：行高 70、itemgap 0 → 10 行 = 700。
					     原来 750（=70×10.7）会让第 11 行在 750 处被硬切断，露出半截文字。
					     改行高时必须同步重算这里和下面的 scrollbar。 -->
					<height>700</height>
					<pagecontrol>60</pagecontrol>
					<onleft>9000</onleft>
					<onright>60</onright>
					<onup>5</onup>
					<ondown>5</ondown>
				</control>
				<control type="button" id="7">
					<textcolor>text_primary</textcolor>
					<description>Default Button</description>
					<include>DefaultSettingButton</include>
				</control>
				<control type="radiobutton" id="8">
					<textcolor>text_primary</textcolor>
					<description>Default RadioButton</description>
					<include>DefaultSettingButton</include>
				</control>
				<control type="spincontrolex" id="9">
					<description>Default SpinControlex</description>
					<include>DefaultSettingButton</include>
				</control>
				<control type="image" id="11">
					<description>separator image</description>
					<!-- Kodi 22 的 settings.xml 里没有 type="sep"，这个控件实际不渲染；
					     高度统一成 70 只为保证「任何项都是行高的整数倍」，防止将来出现 sep 时破坏对齐 -->
					<height>70</height>
					<texture colordiffuse="separator" border="3">dialogs/separator-grey.png</texture>
				</control>
				<control type="edit" id="12">
					<include>DefaultSettingButton</include>
				</control>
				<control type="sliderex" id="13">
					<description>Default Slider</description>
					<include>DefaultSettingButton</include>
					<textwidth>800</textwidth>
				</control>
				<control type="label" id="14">
					<textcolor>text_primary</textcolor>
					<description>Default Label</description>
					<include>DefaultSettingLabel</include>
				</control>
				<control type="colorbutton" id="15">
					<description>Default ColorButton</description>
					<include>DefaultSettingButton</include>
				</control>
				<control type="grouplist" id="9000">
					<left>1210</left>
					<top>92</top>
					<orientation>vertical</orientation>
					<width>300</width>
					<height>280</height>
					<itemgap>-10</itemgap>
					<onleft>5</onleft>
					<onright>5</onright>
					<include content="DefaultDialogButton">
						<param name="id" value="28" />
						<param name="label" value="" />
					</include>
					<include content="DefaultDialogButton">
						<param name="id" value="29" />
						<param name="label" value="" />
					</include>
					<include content="DefaultDialogButton">
						<param name="id" value="30" />
						<param name="label" value="" />
					</include>
				</control>
				<control type="scrollbar" id="60">
					<left>1189</left>
					<top>100</top>
					<width>6</width>
					<!-- 与 grouplist id=5 高度保持一致 -->
					<height>700</height>
					<orientation>vertical</orientation>
					<onleft>5</onleft>
					<onright>9000</onright>
					<animation effect="fade" start="0" end="100" delay="300" time="320">WindowOpen</animation>
					<animation effect="fade" start="100" end="0" time="150">WindowClose</animation>
				</control>
			</control>
		</definition>
	</include>
</includes>
