<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<variable name="VideoOSDButtonFocusSurfaceVar">
		<value condition="Window.IsVisible(1116)">00FFFFFF</value>
		<value>focus_surface</value>
	</variable>
	<variable name="VideoOSDButtonFocusForegroundVar">
		<value condition="Window.IsVisible(1116)">text_primary</value>
		<value>focus_foreground</value>
	</variable>
	<variable name="VideoOSDPlaylistThumbVar">
		<value condition="String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value>DefaultVideo.png</value>
	</variable>
	<variable name="VideoOSDPlaylistTitleVar">
		<value condition="String.IsEqual(ListItem.DBType,episode)">$INFO[ListItem.Season,S]$INFO[ListItem.Episode,E]$INFO[ListItem.Title, · ]</value>
		<value>$VAR[NaraPlaylistTitleVar]</value>
	</variable>
	<variable name="VideoOSDHdrTypeVar">
		<value condition="!String.IsEmpty(Player.Process(hdrsource))">$INFO[Player.Process(hdrsource)]</value>
		<value condition="!String.IsEmpty(VideoPlayer.HdrType)">$VAR[NaraTechHdrPlayer]</value>
		<value>SDR</value>
	</variable>
	<include name="VideoOSDInfoBadge">
		<param name="visible">true</param>
		<param name="surface">C0EDEDED</param>
		<param name="foreground">FF282828</param>
		<definition>
			<control type="button">
				<width min="40" max="$PARAM[maxwidth]">auto</width>
				<height>36</height>
				<label>[B][UPPERCASE]$PARAM[label][/UPPERCASE][/B]</label>
				<font>font19_title</font>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>18</textoffsetx>
				<textcolor>$PARAM[foreground]</textcolor>
				<disabledcolor>$PARAM[foreground]</disabledcolor>
				<texturefocus colordiffuse="$PARAM[surface]" border="4">shapes/round4.png</texturefocus>
				<texturenofocus colordiffuse="$PARAM[surface]" border="4">shapes/round4.png</texturenofocus>
				<enable>false</enable>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>
	<include name="VideoOSDInfoBadgeRow">
		<param name="top">30</param>
		<param name="surface">C0EDEDED</param>
		<param name="foreground">FF282828</param>
		<definition>
			<control type="grouplist">
				<right>30</right>
				<top>$PARAM[top]</top>
				<width>1030</width>
				<height>36</height>
				<orientation>horizontal</orientation>
				<align>right</align>
				<itemgap>8</itemgap>
				<include content="VideoOSDInfoBadge">
					<param name="label" value="$VAR[VideoOSDHdrTypeVar]" />
					<param name="maxwidth" value="200" />
					<param name="surface" value="$PARAM[surface]" />
					<param name="foreground" value="$PARAM[foreground]" />
				</include>
				<include content="VideoOSDInfoBadge">
					<param name="label" value="$INFO[Player.Process(videowidth)]×$INFO[Player.Process(videoheight)]" />
					<param name="maxwidth" value="158" />
					<param name="visible" value="Integer.IsGreater(Player.Process(videowidth),0) + Integer.IsGreater(Player.Process(videoheight),0)" />
					<param name="surface" value="$PARAM[surface]" />
					<param name="foreground" value="$PARAM[foreground]" />
				</include>
				<include content="VideoOSDInfoBadge">
					<param name="label" value="$INFO[Player.Process(videofps),, FPS]" />
					<param name="maxwidth" value="160" />
					<param name="visible" value="!String.IsEmpty(Player.Process(videofps))" />
					<param name="surface" value="$PARAM[surface]" />
					<param name="foreground" value="$PARAM[foreground]" />
				</include>
				<include content="VideoOSDInfoBadge">
					<param name="label" value="$VAR[NaraTechAudioPlayer]" />
					<param name="maxwidth" value="305" />
					<param name="visible" value="!String.IsEmpty(VideoPlayer.AudioCodec)" />
					<param name="surface" value="$PARAM[surface]" />
					<param name="foreground" value="$PARAM[foreground]" />
				</include>
				<include content="VideoOSDInfoBadge">
					<param name="label" value="$INFO[VideoPlayer.AudioChannels(DefaultLayout)]" />
					<param name="maxwidth" value="175" />
					<param name="visible" value="!String.IsEmpty(VideoPlayer.AudioChannels(DefaultLayout))" />
					<param name="surface" value="$PARAM[surface]" />
					<param name="foreground" value="$PARAM[foreground]" />
				</include>
			</control>
		</definition>
	</include>
	<include name="VideoOSDHeader">
		<control type="group">
			<visible>Window.IsModalDialogTopmost(videoosd) | Window.IsModalDialogTopmost(1116)</visible>
			<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="140">WindowClose</animation>
			<animation effect="fade" time="140">VisibleChange</animation>
			<control type="image">
				<width>100%</width>
				<height>270</height>
				<texture flipy="true" colordiffuse="5AFFFFFF">overlays/overlayfade.png</texture>
			</control>
			<control type="grouplist">
				<left>30</left>
				<top>30</top>
				<width>820</width>
				<height>166</height>
				<orientation>vertical</orientation>
				<itemgap>6</itemgap>
				<control type="image">
					<width>356</width>
					<height>100</height>
					<texture>$VAR[PlayerClearLogoVar]</texture>
					<aspectratio align="left" aligny="top">keep</aspectratio>
					<visible>!String.IsEmpty(Player.Art(tvshow.clearlogo)) | !String.IsEmpty(Player.Art(clearlogo))</visible>
				</control>
				<control type="label">
					<width>820</width>
					<height>50</height>
					<font>font36_title</font>
					<label>$VAR[NowPlayingBreadcrumbsVar]</label>
					<scroll>true</scroll>
					<visible>String.IsEmpty(Player.Art(tvshow.clearlogo)) + String.IsEmpty(Player.Art(clearlogo))</visible>
				</control>
				<control type="label">
					<width>820</width>
					<height>34</height>
					<font>font12</font>
					<label>$INFO[VideoPlayer.Season,S]$INFO[VideoPlayer.Episode,E]$INFO[VideoPlayer.Title, · ]</label>
					<textcolor>text_secondary</textcolor>
					<scroll>true</scroll>
					<visible>VideoPlayer.Content(episodes) + !Window.IsVisible(1109)</visible>
				</control>
			</control>
			<include content="VideoOSDInfoBadgeRow" />
		</control>
	</include>
	<include name="VideoOSDPlaylistCard">
		<param name="focused">false</param>
		<definition>
			<control type="group">
				<left>10</left>
				<top>10</top>
				<width>356</width>
				<height>200</height>
				<control type="image">
					<width>356</width>
					<height>200</height>
					<aspectratio>scale</aspectratio>
					<texture background="true">$VAR[VideoOSDPlaylistThumbVar]</texture>
				</control>
				<control type="image">
					<top>134</top>
					<width>356</width>
					<height>66</height>
					<aspectratio>stretch</aspectratio>
					<texture colordiffuse="80FFFFFF">overlays/overlayfade.png</texture>
				</control>
				<!-- 焦点描边环：1:1 整张图，不要 border（9-slice 拉伸会让某条边消失） -->
				<control type="image">
					<left>-3</left>
					<top>-3</top>
					<width>362</width>
					<height>206</height>
					<texture colordiffuse="focus_media">shapes/ring_card_362x206_r6.png</texture>
					<visible>$PARAM[focused]</visible>
				</control>
				<control type="label">
					<left>12</left>
					<top>159</top>
					<width>212</width>
					<height>34</height>
					<font>font12</font>
					<label>$VAR[VideoOSDPlaylistTitleVar]</label>
					<textcolor>text_secondary</textcolor>
					<selectedcolor>text_secondary</selectedcolor>
					<scroll>$PARAM[focused]</scroll>
				</control>
				<control type="image">
					<centerleft>50%</centerleft>
					<centertop>50%</centertop>
					<width>64</width>
					<height>64</height>
					<aspectratio>keep</aspectratio>
					<texture colordiffuse="B3FFFFFF">osd/nara/play-circle.png</texture>
					<visible>ListItem.IsPlaying</visible>
				</control>
				<control type="label">
					<right>12</right>
					<top>159</top>
					<width>124</width>
					<height>32</height>
					<font>font12</font>
					<align>right</align>
					<label>$INFO[ListItem.Duration]</label>
					<textcolor>text_secondary</textcolor>
					<selectedcolor>text_secondary</selectedcolor>
					<visible>!ListItem.IsPlaying</visible>
				</control>
				<control type="label">
					<right>12</right>
					<top>159</top>
					<width>124</width>
					<height>32</height>
					<font>font12</font>
					<align>right</align>
					<label>$LOCALIZE[31000]</label>
					<textcolor>FFFFFFFF</textcolor>
					<selectedcolor>FFFFFFFF</selectedcolor>
					<visible>ListItem.IsPlaying</visible>
				</control>
			</control>
		</definition>
	</include>
</includes>
