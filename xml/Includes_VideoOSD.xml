<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<variable name="VideoOSDButtonFocusSurfaceVar">
		<value condition="Window.IsVisible(1116)">00FFFFFF</value>
		<value>focus_surface</value>
	</variable>
	<variable name="VideoOSDButtonFocusForegroundVar">
		<value condition="Window.IsVisible(1116)">text_primary</value>
		<value>focus_foreground</value>
	</variable>
	<variable name="VideoOSDPlaylistThumbVar">
		<value condition="String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value>DefaultVideo.png</value>
	</variable>
	<variable name="VideoOSDPlaylistTitleVar">
		<value condition="String.IsEqual(ListItem.DBType,episode)">$INFO[ListItem.Season,S]$INFO[ListItem.Episode,E]$INFO[ListItem.Title, · ]</value>
		<value>$VAR[NaraPlaylistTitleVar]</value>
	</variable>
	<variable name="VideoOSDHdrTypeVar">
		<value condition="!String.IsEmpty(Player.Process(hdrsource))">$INFO[Player.Process(hdrsource)]</value>
		<value condition="!String.IsEmpty(VideoPlayer.HdrType)">$VAR[NaraTechHdrPlayer]</value>
		<value>SDR</value>
	</variable>
	<variable name="NaraOSDResolutionTextVar">
		<!-- 只显示档位，不显示 3840×2160 —— 后者在 font19_title 下会被 maxwidth 截成 "3,840×2,1…"。
		     优先用 VideoPlayer.VideoResolution（Kodi 自己判的档，和详情页同源）；
		     取不到时退回画面高度 + P（"2160P"），也短，不会截断。 -->
		<value condition="String.IsEqual(VideoPlayer.VideoResolution,480)">480P</value>
		<value condition="String.IsEqual(VideoPlayer.VideoResolution,540)">540P</value>
		<value condition="String.IsEqual(VideoPlayer.VideoResolution,576)">576P</value>
		<value condition="String.IsEqual(VideoPlayer.VideoResolution,720)">720P</value>
		<value condition="String.IsEqual(VideoPlayer.VideoResolution,1080)">1080P</value>
		<value condition="String.IsEqual(VideoPlayer.VideoResolution,4K)">2160P</value>
		<value condition="String.IsEqual(VideoPlayer.VideoResolution,8K)">4320P</value>
		<value>$INFO[Player.Process(videoheight),,P]</value>
	</variable>
	<include name="VideoOSDInfoBadge">
		<param name="visible">true</param>
		<param name="surface">66000000</param>
		<param name="foreground">white</param>
		<definition>
			<control type="button">
				<width min="40" max="$PARAM[maxwidth]">auto</width>
				<height>36</height>
				<label>[B][UPPERCASE]$PARAM[label][/UPPERCASE][/B]</label>
				<font>font19_title</font>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>18</textoffsetx>
				<textcolor>$PARAM[foreground]</textcolor>
				<disabledcolor>$PARAM[foreground]</disabledcolor>
				<texturefocus colordiffuse="$PARAM[surface]" border="4">shapes/round4.png</texturefocus>
				<texturenofocus colordiffuse="$PARAM[surface]" border="4">shapes/round4.png</texturenofocus>
				<enable>false</enable>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>
	<include name="VideoOSDInfoBadgeRow">
		<param name="bottom">168</param>
		<param name="right">80</param>
		<param name="surface">66000000</param>
		<param name="foreground">white</param>
		<definition>
			<control type="grouplist">
				<right>$PARAM[right]</right>
				<bottom>$PARAM[bottom]</bottom>
				<width>860</width>
				<height>36</height>
				<orientation>horizontal</orientation>
				<align>right</align>
				<itemgap>8</itemgap>
				<!-- 位置在进度条上方、右对齐，与左侧标题同一水平带（标题 bottom 也是 168）。
				     底 66000000 + 白字，和详情页技术标识、设置弹窗同一套透明。
				     宽度按 font19_title 实测：HDR 190 / 分辨率 110 / 帧率 160 / 音频 280 / 声道 80，
				     合计 820，行宽 860。标题让到 880 后两者不重叠。 -->
				<include content="VideoOSDInfoBadge">
					<param name="label" value="$VAR[VideoOSDHdrTypeVar]" />
					<param name="maxwidth" value="190" />
					<param name="surface" value="$PARAM[surface]" />
					<param name="foreground" value="$PARAM[foreground]" />
				</include>
				<include content="VideoOSDInfoBadge">
					<param name="label" value="$VAR[NaraOSDResolutionTextVar]" />
					<param name="maxwidth" value="110" />
					<param name="visible" value="!String.IsEmpty(VideoPlayer.VideoResolution) | Integer.IsGreater(Player.Process(videoheight),0)" />
					<param name="surface" value="$PARAM[surface]" />
					<param name="foreground" value="$PARAM[foreground]" />
				</include>
				<include content="VideoOSDInfoBadge">
					<param name="label" value="$INFO[Player.Process(videofps),, FPS]" />
					<param name="maxwidth" value="160" />
					<param name="visible" value="!String.IsEmpty(Player.Process(videofps))" />
					<param name="surface" value="$PARAM[surface]" />
					<param name="foreground" value="$PARAM[foreground]" />
				</include>
				<include content="VideoOSDInfoBadge">
					<param name="label" value="$VAR[NaraTechAudioPlayer]" />
					<param name="maxwidth" value="280" />
					<param name="visible" value="!String.IsEmpty(VideoPlayer.AudioCodec)" />
					<param name="surface" value="$PARAM[surface]" />
					<param name="foreground" value="$PARAM[foreground]" />
				</include>
				<include content="VideoOSDInfoBadge">
					<param name="label" value="$INFO[VideoPlayer.AudioChannels(DefaultLayout)]" />
					<param name="maxwidth" value="80" />
					<param name="visible" value="!String.IsEmpty(VideoPlayer.AudioChannels(DefaultLayout))" />
					<param name="surface" value="$PARAM[surface]" />
					<param name="foreground" value="$PARAM[foreground]" />
				</include>
			</control>
		</definition>
	</include>
	<include name="VideoOSDHeader">
		<control type="group">
			<visible>Window.IsModalDialogTopmost(videoosd) | Window.IsModalDialogTopmost(1116)</visible>
			<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="140">WindowClose</animation>
			<animation effect="fade" time="140">VisibleChange</animation>
			<control type="image">
				<width>100%</width>
				<height>270</height>
				<texture flipy="true" colordiffuse="5AFFFFFF">overlays/overlayfade.png</texture>
			</control>
			<control type="grouplist">
				<!-- 原位。之前往下让是为了避开 1109 顶栏那行章节副标题，
				     现在那条在 OSD 打开时已经整条隐藏（Custom_1109_TopBarOverlay），
				     所以回到原始的 left 30 / top 30。 -->
				<left>30</left>
				<top>30</top>
				<width>820</width>
				<height>166</height>
				<orientation>vertical</orientation>
				<itemgap>6</itemgap>
				<control type="image">
					<width>356</width>
					<height>100</height>
					<texture>$VAR[PlayerClearLogoVar]</texture>
					<aspectratio align="left" aligny="top">keep</aspectratio>
					<visible>!String.IsEmpty(Player.Art(tvshow.clearlogo)) | !String.IsEmpty(Player.Art(clearlogo))</visible>
				</control>
				<control type="label">
					<width>820</width>
					<height>50</height>
					<font>font36_title</font>
					<label>$VAR[NowPlayingBreadcrumbsVar]</label>
					<scroll>true</scroll>
					<visible>String.IsEmpty(Player.Art(tvshow.clearlogo)) + String.IsEmpty(Player.Art(clearlogo)) + [VideoPlayer.Content(livetv) | !Player.HasVideo]</visible>
				</control>
				<control type="label">
					<width>820</width>
					<height>34</height>
					<font>font12</font>
					<label>$INFO[VideoPlayer.Season,S]$INFO[VideoPlayer.Episode,E]$INFO[VideoPlayer.Title, · ]</label>
					<textcolor>text_secondary</textcolor>
					<scroll>true</scroll>
					<visible>VideoPlayer.Content(episodes) + !Window.IsVisible(1109)</visible>
				</control>
			</control>
		</control>
	</include>
	<include name="VideoOSDPlaylistCard">
		<param name="focused">false</param>
		<definition>
			<control type="group">
				<left>10</left>
				<top>10</top>
				<width>356</width>
				<height>200</height>
				<control type="image">
					<width>356</width>
					<height>200</height>
					<aspectratio scalediffuse="false">scale</aspectratio>
					<texture background="true" diffuse="shapes/mask_356x200_r12.png">$VAR[VideoOSDPlaylistThumbVar]</texture>
				</control>
				<control type="image">
					<top>134</top>
					<width>356</width>
					<height>66</height>
					<aspectratio>stretch</aspectratio>
					<texture colordiffuse="80FFFFFF">overlays/overlayfade.png</texture>
				</control>
				<!-- 焦点描边环：1:1 整张图，不要 border（9-slice 拉伸会让某条边消失）。
				     缩略图 356×200 遮罩 r12 → 环 358×202 r13（外扩 1px、内缘压进 2px）。 -->
				<control type="image">
					<left>-1</left>
					<top>-1</top>
					<width>358</width>
					<height>202</height>
					<texture colordiffuse="focus_media">shapes/ring_card_358x202_r13.png</texture>
					<visible>$PARAM[focused]</visible>
				</control>
				<control type="label">
					<left>12</left>
					<top>159</top>
					<width>212</width>
					<height>34</height>
					<font>font12</font>
					<label>$VAR[VideoOSDPlaylistTitleVar]</label>
					<textcolor>text_secondary</textcolor>
					<selectedcolor>text_secondary</selectedcolor>
					<scroll>$PARAM[focused]</scroll>
				</control>
				<control type="image">
					<centerleft>50%</centerleft>
					<centertop>50%</centertop>
					<width>64</width>
					<height>64</height>
					<aspectratio>keep</aspectratio>
					<texture colordiffuse="B3FFFFFF">osd/nara/play-circle.png</texture>
					<visible>ListItem.IsPlaying</visible>
				</control>
				<control type="label">
					<right>12</right>
					<top>159</top>
					<width>124</width>
					<height>32</height>
					<font>font12</font>
					<align>right</align>
					<label>$INFO[ListItem.Duration]</label>
					<textcolor>text_secondary</textcolor>
					<selectedcolor>text_secondary</selectedcolor>
					<visible>!ListItem.IsPlaying</visible>
				</control>
				<control type="label">
					<right>12</right>
					<top>159</top>
					<width>124</width>
					<height>32</height>
					<font>font12</font>
					<align>right</align>
					<label>$LOCALIZE[31000]</label>
					<textcolor>FFFFFFFF</textcolor>
					<selectedcolor>FFFFFFFF</selectedcolor>
					<visible>ListItem.IsPlaying</visible>
				</control>
			</control>
		</definition>
	</include>
</includes>
