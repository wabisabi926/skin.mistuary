<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<!-- 原来：!Window.IsActive(fullscreenvideo) + !Window.IsActive(fullscreengame) + !$EXP[nara_settings_osd]
	     —— 即"播放中 / OSD 设置"时切到不透明的 Legacy 面，保证压在画面上看得清。
	     问题是：`<include condition="X">` 是**加载时**求值的（GUIIncludes::ResolveIncludes），
	     窗口只要在播放中被加载过一次，这个分支就永久钉死，之后再也不会切回玻璃面；
	     而且 Legacy 面是 100% 不透明的死板，完全不跟「界面透明度」走 ——
	     这就是"播放中打开的对话框永远不跟设置"的根因。

	     现在恒为 true：所有对话框、任何时候都走玻璃面（跟随界面透明度），
	     压画面的问题交给遮蔽层用 scrim_osd（30%）解决，而不是靠不透明面板。

	     ⚠️ **所以全皮肤里所有 `!$EXP[nara_dialog_glass]` 分支都是死代码，永远不会执行。**
	     改对话框时**只改玻璃分支**，别照着旧分支抄一份（22 个文件、约 40 处）。
	     2026-10-29 已按这个原则删掉电源菜单那一套；其余等有空整体清理。 -->
	<expression name="nara_dialog_glass">true</expression>
	<!-- ===== 浮窗遮蔽层 =====
	     scrim 只负责「底噪」：把底下的画面压到认不出，不参与面板质感。
	     摆放顺序必须是：scrim → 点空白关闭按钮（如有）→ 面板 → 内容，
	     否则面板内部点击会被 scrim 上的按钮吃掉。 -->
	<include name="NaraDialogScrim">
		<param name="tint">$VAR[NaraGlassScrimTintVar]</param>
		<definition>
			<control type="image">
				<left>-2000</left>
				<top>-2000</top>
				<width>6000</width>
				<height>6000</height>
				<texture colordiffuse="$PARAM[tint]">colors/black.png</texture>
				<animation effect="fade" time="300">VisibleChange</animation>
			</control>
		</definition>
	</include>
	<!-- 面板投影：不提高任何不透明度，靠「浮在背景之上」的暗示提升可读性感知。
	     独立 include，由 NaraDialogGlassSurface 无条件注入 ——
	     条件 include 的 condition 是**加载时**求值（GUIIncludes::ResolveIncludes），
	     写成 condition="$PARAM[shadow]" 依赖参数替换早于条件求值，不可靠。 -->
	<include name="NaraDialogGlassShadow">
		<bordertexture border="21" infill="false">overlays/shadow.png</bordertexture>
		<bordersize>20</bordersize>
	</include>
	<!-- tint 的值可以是颜色名（gl_1..5 等），**也可以是变量**（NaraGlassFloatTintVar /
	     NaraGlassPageTintVar / NaraPlaybackDialogTintVar）。
	     不能用 frosted / dialog 这类别名——那不是颜色名，会解析失败。
	     贴图 shapes/glass<N>.png 自带 alpha 渐变：中心实、边缘化开，
	     所以 colordiffuse 的 alpha 语义是「不透明度上限」而不是「均匀不透明度」。 -->
	<include name="NaraDialogGlassTexture">
		<param name="tint">$VAR[NaraGlassFloatTintVar]</param>
		<param name="radius">20</param>
		<definition>
			<texture colordiffuse="$PARAM[tint]" border="$PARAM[radius]">shapes/glass$PARAM[radius].png</texture>
		</definition>
	</include>
	<include name="NaraDialogGlassSurface">
		<param name="style">$VAR[NaraGlassFloatTintVar]</param>
		<definition>
			<control type="image">
				<width>100%</width>
				<height>100%</height>
				<include content="NaraDialogGlassTexture">
					<param name="tint" value="$PARAM[style]" />
				</include>
				<include>NaraDialogGlassShadow</include>
			</control>
		</definition>
	</include>
	<include name="NaraDialogInsetTexture">
		<texture colordiffuse="18FFFFFF" border="16">shapes/round16.png</texture>
	</include>
	<include name="NaraDialogButtonInsetTexture">
		<texturenofocus colordiffuse="18FFFFFF" border="16">shapes/round16.png</texturenofocus>
		<texturefocus colordiffuse="glass_focus_medium" border="16">shapes/round16.png</texturefocus>
		<focusedcolor>text_primary</focusedcolor>
		<selectedcolor>text_primary</selectedcolor>
	</include>
	<include name="NaraDialogLegacyButtonTexture">
		<texturenofocus border="21">dialogs/dialog-bg.png</texturenofocus>
	</include>
	<include name="NaraDialogLegacyTexture">
		<param name="texture">colors/white.png</param>
		<param name="border">0</param>
		<param name="color">FFFFFFFF</param>
		<param name="shadow">false</param>
		<definition>
			<texture border="$PARAM[border]" colordiffuse="$PARAM[color]">$PARAM[texture]</texture>
			<include condition="$PARAM[shadow]">NaraDialogLegacyShadow</include>
		</definition>
	</include>
	<include name="NaraDialogLegacyShadow">
		<bordertexture border="21" infill="false">overlays/shadow.png</bordertexture>
		<bordersize>20</bordersize>
	</include>
	<include name="NaraDialogActionTextures">
		<texturefocus colordiffuse="glass_focus_medium" border="14">shapes/round14.png</texturefocus>
		<texturenofocus />
		<textcolor>text_primary</textcolor>
		<focusedcolor>text_primary</focusedcolor>
		<selectedcolor>text_primary</selectedcolor>
	</include>
	<include name="NaraDialogButtonDimensions">
		<definition>
			<width>$PARAM[width]</width>
			<height>$PARAM[height]</height>
		</definition>
	</include>
	<include name="NaraDialogButtonItemGap">
		<param name="value">16</param>
		<definition>
			<itemgap>$PARAM[value]</itemgap>
		</definition>
	</include>
	<include name="NaraDialogButtonSpacing">
		<param name="legacy">dialogbuttons_itemgap</param>
		<param name="value">16</param>
		<definition>
			<include condition="$EXP[nara_dialog_glass]" content="NaraDialogButtonItemGap">
				<param name="value" value="$PARAM[value]" />
			</include>
			<include content="NaraDialogButtonItemGap" condition="!$EXP[nara_dialog_glass]">
				<param name="value" value="$PARAM[legacy]" />
			</include>
		</definition>
	</include>
	<include name="NaraDialogLegacyActionTextures">
		<texturefocus border="40" colordiffuse="focus_surface">buttons/dialogbutton-fo.png</texturefocus>
		<texturenofocus border="40">buttons/dialogbutton-nofo.png</texturenofocus>
	</include>
	<include name="NaraPowerMenuLayout">
		<control type="image">
			<width>100%</width>
			<height>100%</height>
			<texture colordiffuse="$VAR[NaraGlassScrimTintVar]">colors/black.png</texture>
		</control>
		<control type="button">
			<width>100%</width>
			<height>100%</height>
			<onclick>Action(close)</onclick>
			<texturefocus />
			<texturenofocus />
		</control>
		<!-- 通用版：grouplist 无 texturebackground，改为独立背景层（高度按内容估算） -->
		<!-- 宽度 400：最长标签「关闭系统电源」6 个字 × 26 ≈ 156px，左右各留 24 还绰绰有余。
		     高度按**可见按钮数**分两层：88（标题）+ N×70 + 18（底部留白）。
		     N=6 时 526、N=5 时 456。用 System.CanHibernate 区分 —— 平台有休眠才会多出「休眠」那一格，
		     这样每个平台都刚好贴边，不会出现"板子比按钮多一块"。 -->
		<control type="image">
			<centerleft>50%</centerleft>
			<top>180</top>
			<width>400</width>
			<height>526</height>
			<texture colordiffuse="$VAR[NaraGlassFloatTintVar]" border="20">shapes/glass20.png</texture>
			<visible>System.CanHibernate</visible>
		</control>
		<control type="image">
			<centerleft>50%</centerleft>
			<top>180</top>
			<width>400</width>
			<height>456</height>
			<texture colordiffuse="$VAR[NaraGlassFloatTintVar]" border="20">shapes/glass20.png</texture>
			<visible>!System.CanHibernate</visible>
		</control>
		<control type="grouplist" id="9000">
			<defaultcontrol>103</defaultcontrol>
			<centerleft>50%</centerleft>
			<top>180</top>
			<width>400</width>
			<orientation>vertical</orientation>
			<usecontrolcoords>true</usecontrolcoords>
			<onup>9000</onup>
			<ondown>9000</ondown>
			<height max="780">auto</height>
			<control type="group">
				<height>88</height>
				<control type="label" id="2">
					<left>32</left>
					<top>16</top>
					<width>470</width>
					<height>56</height>
					<font>font32</font>
					<label>$LOCALIZE[33060]</label>
				</control>
			</control>
			<control type="button" id="103">
				<left>24</left>
				<width>352</width>
				<height>70</height>
				<font>font26</font>
				<align>center</align>
				<aligny>center</aligny>
				<include>NaraDialogActionTextures</include>
				<label>$LOCALIZE[13012]</label>
				<onclick>Quit()</onclick>
				<visible>System.ShowExitButton</visible>
			</control>
			<!-- 下面每个按钮都挂 Kodi 的**能力标志**：平台不支持就自动隐藏，
			     不需要按 Windows / CoreELEC 分两套写。 -->
			<control type="button" id="104">
				<left>24</left>
				<width>352</width>
				<height>70</height>
				<font>font26</font>
				<align>center</align>
				<aligny>center</aligny>
				<include>NaraDialogActionTextures</include>
				<label>$LOCALIZE[31774]</label>
				<onclick>Powerdown()</onclick>
				<visible>System.CanPowerDown</visible>
			</control>
			<control type="button" id="105">
				<left>24</left>
				<width>352</width>
				<height>70</height>
				<font>font26</font>
				<align>center</align>
				<aligny>center</aligny>
				<include>NaraDialogActionTextures</include>
				<label>$LOCALIZE[13013]</label>
				<onclick>Reset()</onclick>
				<visible>System.CanReboot</visible>
			</control>
			<control type="button" id="106">
				<left>24</left>
				<width>352</width>
				<height>70</height>
				<font>font26</font>
				<align>center</align>
				<aligny>center</aligny>
				<include>NaraDialogActionTextures</include>
				<label>$LOCALIZE[13011]</label>
				<onclick>Dialog.Close(shutdownmenu)</onclick>
				<onclick>Suspend()</onclick>
				<visible>System.CanSuspend</visible>
			</control>
			<control type="button" id="107">
				<left>24</left>
				<width>352</width>
				<height>70</height>
				<font>font26</font>
				<align>center</align>
				<aligny>center</aligny>
				<include>NaraDialogActionTextures</include>
				<label>$LOCALIZE[13010]</label>
				<onclick>Dialog.Close(shutdownmenu)</onclick>
				<onclick>Hibernate()</onclick>
				<visible>System.CanHibernate</visible>
			</control>
			<control type="button" id="108">
				<left>24</left>
				<width>352</width>
				<height>70</height>
				<font>font26</font>
				<align>center</align>
				<aligny>center</aligny>
				<include>NaraDialogActionTextures</include>
				<label>$LOCALIZE[20183]</label>
				<onclick>ReloadSkin()</onclick>
			</control>
			<control type="group">
				<height>18</height>
			</control>
		</control>
	</include>
	<variable name="NaraDialogFocusForegroundVar">
		<value condition="$EXP[nara_dialog_glass]">text_primary</value>
		<value>focus_foreground</value>
	</variable>
	<variable name="NaraDialogFocusMutedVar">
		<value condition="$EXP[nara_dialog_glass]">text_secondary</value>
		<value>focus_foreground_muted</value>
	</variable>
	<include name="NaraDialogFocusTexture">
		<include condition="$EXP[nara_dialog_glass]">NaraDialogGlassFocusTexture</include>
		<include condition="!$EXP[nara_dialog_glass]" content="NaraDialogLegacyTexture">
			<param name="texture" value="shapes/round14.png" />
			<param name="border" value="14" />
			<param name="color" value="focus_surface" />
		</include>
	</include>
	<include name="NaraDialogGlassFocusTexture">
		<texture colordiffuse="glass_focus_medium" border="16">shapes/round16.png</texture>
	</include>
	<include name="NaraDialogControlTextures">
		<include>NaraDialogActionTextures</include>
		<alttexturefocus colordiffuse="glass_focus_medium" border="14">shapes/round14.png</alttexturefocus>
		<alttexturenofocus />
	</include>
	<include name="NaraDialogButtonRowHeight">
		<include condition="$EXP[nara_dialog_glass]">NaraDialogCompactRowHeight</include>
		<include condition="!$EXP[nara_dialog_glass]">NaraDialogLegacyRowHeight</include>
	</include>
	<include name="NaraDialogCompactRowHeight">
		<height>64</height>
	</include>
	<include name="NaraDialogLegacyRowHeight">
		<height>100</height>
	</include>
	<variable name="NaraDialogFocusSurfaceVar">
		<value condition="$EXP[nara_dialog_glass]">glass_focus_medium</value>
		<value>focus_surface</value>
	</variable>
	<include name="NaraDialogLegacySettingsItem">
		<texturenofocus border="40">buttons/dialogbutton-nofo.png</texturenofocus>
		<texturefocus border="40" colordiffuse="focus_surface">buttons/dialogbutton-fo.png</texturefocus>
		<height>100</height>
		<aligny>center</aligny>
		<textoffsetx>40</textoffsetx>
		<alttexturefocus border="40" colordiffuse="focus_surface">buttons/dialogbutton-fo.png</alttexturefocus>
		<alttexturenofocus border="40">buttons/dialogbutton-nofo.png</alttexturenofocus>
	</include>
	<variable name="NaraDialogFocusLayoutTextColor10Var">
		<value condition="$EXP[nara_dialog_glass]">text_primary</value>
		<value>$VAR[FocusLayoutTextColor10Var]</value>
	</variable>
	<variable name="NaraDialogFocusLayoutTextColor11Var">
		<value condition="$EXP[nara_dialog_glass]">text_primary</value>
		<value>$VAR[FocusLayoutTextColor11Var]</value>
	</variable>
	<variable name="NaraDialogFocusLayoutTextColor120Var">
		<value condition="$EXP[nara_dialog_glass]">text_primary</value>
		<value>$VAR[FocusLayoutTextColor120Var]</value>
	</variable>
	<variable name="NaraDialogFocusLayoutTextColor12Var">
		<value condition="$EXP[nara_dialog_glass]">text_primary</value>
		<value>$VAR[FocusLayoutTextColor12Var]</value>
	</variable>
	<variable name="NaraDialogFocusLayoutTextColor13Var">
		<value condition="$EXP[nara_dialog_glass]">text_primary</value>
		<value>$VAR[FocusLayoutTextColor13Var]</value>
	</variable>
	<variable name="NaraDialogFocusLayoutTextColor20Var">
		<value condition="$EXP[nara_dialog_glass]">text_primary</value>
		<value>$VAR[FocusLayoutTextColor20Var]</value>
	</variable>
	<variable name="NaraDialogFocusLayoutTextColor450Var">
		<value condition="$EXP[nara_dialog_glass]">text_primary</value>
		<value>$VAR[FocusLayoutTextColor450Var]</value>
	</variable>
	<variable name="NaraDialogFocusLayoutTextColor451Var">
		<value condition="$EXP[nara_dialog_glass]">text_primary</value>
		<value>$VAR[FocusLayoutTextColor451Var]</value>
	</variable>
	<variable name="NaraDialogFocusLayoutTextColor6Var">
		<value condition="$EXP[nara_dialog_glass]">text_primary</value>
		<value>$VAR[FocusLayoutTextColor6Var]</value>
	</variable>
	<variable name="NaraDialogFocusLayoutTextColor9010Var">
		<value condition="$EXP[nara_dialog_glass]">text_primary</value>
		<value>$VAR[FocusLayoutTextColor9010Var]</value>
	</variable>
	<variable name="NaraDialogFocusLayoutTextColor50Var">
		<value condition="$EXP[nara_dialog_glass]">text_primary</value>
		<value>$VAR[FocusLayoutTextColor451Var]</value>
	</variable>
	<variable name="NaraDialogFocusLayoutTextColor9000Var">
		<value condition="$EXP[nara_dialog_glass]">text_primary</value>
		<value>$VAR[FocusLayoutTextColor9000Var]</value>
	</variable>
	<include name="NaraDialogSettingsRowHeight">
		<include condition="$EXP[nara_dialog_glass]">NaraDialogSettingsRowCompactHeight</include>
		<include condition="!$EXP[nara_dialog_glass]">NaraDialogLegacyRowHeight</include>
	</include>
	<include name="NaraDialogSettingsRowCompactHeight">
		<height>70</height>
	</include>
</includes>
