<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<!-- 对话框**只有玻璃一套**（跟随「界面透明度」）。

	     历史上曾经有第二条"不透明旧面"（`NaraDialogLegacy*` 那一套），由
	     `nara_dialog_glass` 这个表达式在"播放中 / OSD 设置"时切换。两个问题导致它被废弃：
	     ① `<include condition="X">` 是**加载时**求值的（GUIIncludes::ResolveIncludes），
	        窗口只要在播放中被加载过一次，分支就永久钉死，之后再也切不回玻璃面；
	     ② 旧面是 100% 不透明的死板，完全不跟「界面透明度」走
	        —— 这就是"播放中打开的对话框永远不跟设置"的根因。
	     压画面的问题现在交给遮蔽层 `scrim_osd`（30%）解决，不靠不透明面板。

	     2026-10-29 把 40 处死分支、65 处恒真条件、6 个 `NaraDialogLegacy*` 定义
	     全部清掉了，表达式本身也一并删除。**改对话框只有一个分支可改。** -->
	<!-- ===== 浮窗遮蔽层 =====
	     scrim 只负责「底噪」：把底下的画面压到认不出，不参与面板质感。
	     摆放顺序必须是：scrim → 点空白关闭按钮（如有）→ 面板 → 内容，
	     否则面板内部点击会被 scrim 上的按钮吃掉。 -->
	<include name="NaraDialogScrim">
		<param name="tint">$VAR[NaraGlassFloatScrimVar]</param>
		<definition>
			<control type="image">
				<left>-2000</left>
				<top>-2000</top>
				<width>6000</width>
				<height>6000</height>
				<texture colordiffuse="$PARAM[tint]">colors/black.png</texture>
				<animation effect="fade" time="300">VisibleChange</animation>
			</control>
		</definition>
	</include>
	<!-- 面板投影：不提高任何不透明度，靠「浮在背景之上」的暗示提升可读性感知。
	     独立 include，由 NaraDialogGlassSurface 无条件注入 ——
	     条件 include 的 condition 是**加载时**求值（GUIIncludes::ResolveIncludes），
	     写成 condition="$PARAM[shadow]" 依赖参数替换早于条件求值，不可靠。 -->
	<include name="NaraDialogGlassShadow">
		<bordertexture border="21" infill="false">overlays/shadow.png</bordertexture>
		<bordersize>20</bordersize>
	</include>
	<!-- tint 的值可以是颜色名（gl_1..5 等），**也可以是变量**（NaraGlassFloatTintVar /
	     NaraGlassPageTintVar / NaraPlaybackDialogTintVar）。
	     不能用 frosted / dialog 这类别名——那不是颜色名，会解析失败。
	     贴图 shapes/glass<N>.png 自带 alpha 渐变：中心实、边缘化开，
	     所以 colordiffuse 的 alpha 语义是「不透明度上限」而不是「均匀不透明度」。 -->
	<include name="NaraDialogGlassTexture">
		<param name="tint">$VAR[NaraGlassFloatTintVar]</param>
		<param name="radius">20</param>
		<definition>
			<texture colordiffuse="$PARAM[tint]" border="$PARAM[radius]">shapes/glass$PARAM[radius].png</texture>
		</definition>
	</include>
	<include name="NaraDialogGlassSurface">
		<param name="style">$VAR[NaraGlassFloatTintVar]</param>
		<definition>
			<control type="image">
				<width>100%</width>
				<height>100%</height>
				<include content="NaraDialogGlassTexture">
					<param name="tint" value="$PARAM[style]" />
				</include>
				<include>NaraDialogGlassShadow</include>
			</control>
		</definition>
	</include>
	<include name="NaraDialogInsetTexture">
		<texture colordiffuse="18FFFFFF" border="16">shapes/round16.png</texture>
	</include>
	<include name="NaraDialogButtonInsetTexture">
		<texturenofocus colordiffuse="18FFFFFF" border="16">shapes/round16.png</texturenofocus>
		<texturefocus colordiffuse="glass_focus_medium" border="16">shapes/round16.png</texturefocus>
		<focusedcolor>text_primary</focusedcolor>
		<selectedcolor>text_primary</selectedcolor>
	</include>
	<include name="NaraDialogActionTextures">
		<texturefocus colordiffuse="glass_focus_medium" border="14">shapes/round14.png</texturefocus>
		<texturenofocus />
		<textcolor>text_primary</textcolor>
		<focusedcolor>text_primary</focusedcolor>
		<selectedcolor>text_primary</selectedcolor>
	</include>
	<include name="NaraDialogButtonDimensions">
		<definition>
			<width>$PARAM[width]</width>
			<height>$PARAM[height]</height>
		</definition>
	</include>
	<include name="NaraDialogButtonItemGap">
		<param name="value">16</param>
		<definition>
			<itemgap>$PARAM[value]</itemgap>
		</definition>
	</include>
	<include name="NaraDialogButtonSpacing">
		<param name="legacy">dialogbuttons_itemgap</param>
		<param name="value">16</param>
		<definition>
			<include content="NaraDialogButtonItemGap">
				<param name="value" value="$PARAM[value]" />
			</include>
		</definition>
	</include>
	<include name="NaraPowerMenuLayout">
		<control type="image">
			<width>100%</width>
			<height>100%</height>
			<texture colordiffuse="$VAR[NaraGlassFloatScrimVar]">colors/black.png</texture>
		</control>
		<control type="button">
			<width>100%</width>
			<height>100%</height>
			<onclick>Action(close)</onclick>
			<texturefocus />
			<texturenofocus />
		</control>
		<!-- 通用版：grouplist 无 texturebackground，改为独立背景层（高度按内容估算） -->
		<!-- 宽度 400：最长标签「关闭系统电源」6 个字 × 26 ≈ 156px，左右各留 24 还绰绰有余。
		     高度按**可见按钮数**分两层：88（标题）+ N×70 + 18（底部留白）。
		     N=6 时 526、N=5 时 456。用 System.CanHibernate 区分 —— 平台有休眠才会多出「休眠」那一格，
		     这样每个平台都刚好贴边，不会出现"板子比按钮多一块"。 -->
		<control type="image">
			<centerleft>50%</centerleft>
			<top>180</top>
			<width>400</width>
			<height>526</height>
			<texture colordiffuse="$VAR[NaraGlassFloatTintVar]" border="20">shapes/glass20.png</texture>
			<visible>System.CanHibernate</visible>
		</control>
		<control type="image">
			<centerleft>50%</centerleft>
			<top>180</top>
			<width>400</width>
			<height>456</height>
			<texture colordiffuse="$VAR[NaraGlassFloatTintVar]" border="20">shapes/glass20.png</texture>
			<visible>!System.CanHibernate</visible>
		</control>
		<control type="grouplist" id="9000">
			<defaultcontrol>103</defaultcontrol>
			<centerleft>50%</centerleft>
			<top>180</top>
			<width>400</width>
			<orientation>vertical</orientation>
			<usecontrolcoords>true</usecontrolcoords>
			<onup>9000</onup>
			<ondown>9000</ondown>
			<height max="780">auto</height>
			<control type="group">
				<height>88</height>
				<control type="label" id="2">
					<left>32</left>
					<top>16</top>
					<width>470</width>
					<height>56</height>
					<font>font32</font>
					<label>$LOCALIZE[33060]</label>
				</control>
			</control>
			<control type="button" id="103">
				<left>24</left>
				<width>352</width>
				<height>70</height>
				<font>font26</font>
				<align>center</align>
				<aligny>center</aligny>
				<include>NaraDialogActionTextures</include>
				<label>$LOCALIZE[13012]</label>
				<onclick>Quit()</onclick>
				<visible>System.ShowExitButton</visible>
			</control>
			<!-- 下面每个按钮都挂 Kodi 的**能力标志**：平台不支持就自动隐藏，
			     不需要按 Windows / CoreELEC 分两套写。 -->
			<control type="button" id="104">
				<left>24</left>
				<width>352</width>
				<height>70</height>
				<font>font26</font>
				<align>center</align>
				<aligny>center</aligny>
				<include>NaraDialogActionTextures</include>
				<label>$LOCALIZE[31774]</label>
				<onclick>Powerdown()</onclick>
				<visible>System.CanPowerDown</visible>
			</control>
			<control type="button" id="105">
				<left>24</left>
				<width>352</width>
				<height>70</height>
				<font>font26</font>
				<align>center</align>
				<aligny>center</aligny>
				<include>NaraDialogActionTextures</include>
				<label>$LOCALIZE[13013]</label>
				<onclick>Reset()</onclick>
				<visible>System.CanReboot</visible>
			</control>
			<control type="button" id="106">
				<left>24</left>
				<width>352</width>
				<height>70</height>
				<font>font26</font>
				<align>center</align>
				<aligny>center</aligny>
				<include>NaraDialogActionTextures</include>
				<label>$LOCALIZE[13011]</label>
				<onclick>Dialog.Close(shutdownmenu)</onclick>
				<onclick>Suspend()</onclick>
				<visible>System.CanSuspend</visible>
			</control>
			<control type="button" id="107">
				<left>24</left>
				<width>352</width>
				<height>70</height>
				<font>font26</font>
				<align>center</align>
				<aligny>center</aligny>
				<include>NaraDialogActionTextures</include>
				<label>$LOCALIZE[13010]</label>
				<onclick>Dialog.Close(shutdownmenu)</onclick>
				<onclick>Hibernate()</onclick>
				<visible>System.CanHibernate</visible>
			</control>
			<control type="button" id="108">
				<left>24</left>
				<width>352</width>
				<height>70</height>
				<font>font26</font>
				<align>center</align>
				<aligny>center</aligny>
				<include>NaraDialogActionTextures</include>
				<label>$LOCALIZE[20183]</label>
				<onclick>ReloadSkin()</onclick>
			</control>
			<control type="group">
				<height>18</height>
			</control>
		</control>
	</include>
