<?xml version="1.0" encoding="UTF-8"?>
<window>
	<zorder>3</zorder>
	<controls>
		<control type="group">
			<depth>DepthMax</depth>
			<top>85</top>
			<!-- 原来是 right=0，贴着屏幕边缘。改成 60：1920 画布下正好和
			     设置页玻璃面板的右边缘（1860）对齐；宽屏居中时也能留出边距。 -->
			<right>60</right>
			<width>400</width>
			<include>OpenClose_Right</include>
			<visible>String.IsEmpty(Window(Home).Property(script.cinemavision.running))</visible>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>400</width>
				<height>80</height>
				<include condition="$EXP[nara_dialog_glass]">NaraDialogGlassTexture</include>
				<include condition="!$EXP[nara_dialog_glass]" content="NaraDialogLegacyTexture">
					<param name="texture" value="dialogs/dialog-bg-nobo.png" />
					<param name="shadow" value="true" />
				</include>
			</control>
			<control type="image" id="400">
				<description>avatar</description>
				<left>14</left>
				<top>16</top>
				<width>48</width>
				<height>48</height>
				<aspectratio>stretch</aspectratio>
			</control>
			<!-- 340 宽时「Emby for Kodi Next Gen」这类标题会被截断，
			     加宽到 400 并让文字放不下时滚动，而不是硬切 -->
			<control type="fadelabel" id="401">
				<description>Line 1 Label</description>
				<left>74</left>
				<top>8</top>
				<width>314</width>
				<height>32</height>
				<font>font24</font>
				<aligny>center</aligny>
				<scrollout>false</scrollout>
				<pauseatend>2000</pauseatend>
			</control>
			<control type="fadelabel" id="402">
				<description>Line 2 Label</description>
				<left>75</left>
				<top>40</top>
				<width>314</width>
				<height>30</height>
				<font>font22</font>
				<aligny>center</aligny>
				<scrollout>false</scrollout>
				<pauseatend>2000</pauseatend>
			</control>
		</control>
	</controls>
</window>
