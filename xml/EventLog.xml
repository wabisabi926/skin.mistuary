						<focusedcolor>text_primary</focusedcolor>
						<textoffsetx>24</textoffsetx>
					</control>
					<control type="button" id="20">
						<width>100%</width>
						<height>78</height>
						<align>left</align>
						<aligny>center</aligny>
						<textoffsetx>24</textoffsetx>
						<texturenofocus />
						<texturefocus colordiffuse="glass_focus_light" border="14">shapes/round14.png</texturefocus>
						<textcolor>text_primary</textcolor>
						<focusedcolor>text_primary</focusedcolor>
						<label>$LOCALIZE[192]</label>
						<onclick></onclick>
						<selectedcolor>text_primary</selectedcolor>
					</control>
					<control type="button" id="501">
						<width>100%</width>
						<height>78</height>
						<align>left</align>
						<aligny>center</aligny>
						<textoffsetx>24</textoffsetx>
						<texturenofocus />
						<texturefocus colordiffuse="glass_focus_light" border="14">shapes/round14.png</texturefocus>
						<textcolor>text_primary</textcolor>
						<focusedcolor>text_primary</focusedcolor>
						<label>$LOCALIZE[5]</label>
						<onclick>ActivateWindow(systemsettings,logging)</onclick>
						<selectedcolor>text_primary</selectedcolor>
					</control>
					<left>76</left>
					<top>165</top>
					<width>368</width>
					<height>685</height>
				</control>
			</control>
			<control type="scrollbar" id="60">
				<left>1874</left>
				<top>193</top>
				<width>8</width>
				<height>644</height>
				<onleft>50</onleft>
				<onright>9000</onright>
				<orientation>vertical</orientation>
				<animation effect="slide" end="6,0" time="300" tween="sine" easing="inout" condition="!Control.HasFocus(60)">conditional</animation>
				<visible>Control.IsVisible(50)</visible>
			</control>
		</control>
		<!-- 帮助条：占 PVR/直播电视那页同一个位置（545,915，1255×100）。
		     列表里的消息是单行 font26、宽度只有 815，长消息必被裁；
		     这里把选中项的标题和正文完整显示出来，超长自动滚动。 -->
		<control type="label" id="70">
			<left>545</left>
			<top>915</top>
			<width>1255</width>
			<height>40</height>
			<font>font26</font>
			<textcolor>text_primary</textcolor>
			<label>$INFO[Container(50).ListItem.Label]</label>
		</control>
		<control type="textbox" id="71">
			<left>545</left>
			<top>955</top>
			<width>1255</width>
			<height>60</height>
			<font>font24</font>
			<textcolor>text_secondary</textcolor>
			<label>$INFO[Container(50).ListItem.Property(Event.Description)]</label>
			<autoscroll time="3000" delay="5000" repeat="5000">true</autoscroll>
		</control>
		<include content="TopBar">
			<param name="breadcrumbs_label" value="$LOCALIZE[31067]" />
			<param name="sublabel" value="" />
		</include>
		<include>BottomBar</include>
	</controls>
</window>
