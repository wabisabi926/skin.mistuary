		<control type="image">
			<left>505</left>
			<top>145</top>
			<width>1355</width>
			<height>740</height>
			<texture colordiffuse="$VAR[NaraGlassPageTintVar]" border="20">shapes/glass20.png</texture>
		</control>
		<control type="group">
			<animation effect="fade" start="100" end="0" time="200" tween="sine" condition="$EXP[infodialog_active]">Conditional</animation>
			<control type="group">
				<visible>Control.IsVisible(50)</visible>
				<include>OpenClose_Right</include>
				<control type="fixedlist" id="50">
					<left>525</left>
					<top>193</top>
					<width>1315</width>
					<height>644</height>
					<onleft>9000</onleft>
					<onright>60</onright>
					<onup>50</onup>
					<movement>2</movement>
					<focusposition>3</focusposition>
					<ondown>50</ondown>
					<viewtype label="535">list</viewtype>
					<pagecontrol>60</pagecontrol>
					<scrolltime tween="cubic" easing="out">500</scrolltime>
					<itemlayout height="76">
						<control type="image">
							<left>28</left>
							<top>10</top>
							<width>56</width>
							<height>56</height>
							<texture>$VAR[NaraImgListitemIconDefDefaultAddon]</texture>
							<aspectratio>scale</aspectratio>
							<bordertexture colordiffuse="border_alpha">colors/black.png</bordertexture>
							<bordersize>4</bordersize>
						</control>
						<control type="label">
							<left>100</left>
							<right>400</right>
							<top>2</top>
							<height>36</height>
							<aligny>center</aligny>
							<font>font26</font>
							<label>$INFO[ListItem.Label]</label>
						</control>
						<control type="textbox">
							<left>100</left>
							<top>38</top>
							<right>28</right>
							<height>34</height>
							<aligny>top</aligny>
							<font>font10</font>
							<textcolor>grey</textcolor>
							<label>$INFO[ListItem.Property(Event.Description)]</label>
						</control>
						<control type="label">
							<left>0</left>
							<right>28</right>
							<top>2</top>
							<height>36</height>
							<align>right</align>
							<aligny>center</aligny>
							<label>$INFO[ListItem.Label2]</label>
						</control>
					</itemlayout>
					<focusedlayout height="76">
						<control type="image">
							<left>0</left>
							<top>0</top>
							<right>0</right>
							<bottom>0</bottom>
							<texture colordiffuse="glass_focus_light" border="14">shapes/round14.png</texture>
							<visible>Control.HasFocus(50)</visible>
						</control>
						<control type="image">
							<left>28</left>
							<top>10</top>
							<width>56</width>
							<height>56</height>
							<texture>$VAR[NaraImgListitemIconDefDefaultAddon]</texture>
							<aspectratio>scale</aspectratio>
							<bordertexture colordiffuse="border_alpha">colors/black.png</bordertexture>
							<bordersize>4</bordersize>
						</control>
						<control type="label">
							<left>100</left>
							<right>400</right>
							<top>2</top>
							<height>36</height>
							<aligny>center</aligny>
							<font>font26</font>
							<label>$INFO[ListItem.Label]</label>
							<textcolor>text_primary</textcolor>
							<selectedcolor>text_primary</selectedcolor>
						</control>
						<control type="textbox">
							<left>100</left>
							<top>38</top>
							<right>28</right>
							<height>34</height>
							<aligny>top</aligny>
							<font>font10</font>
							<label>$INFO[ListItem.Property(Event.Description)]</label>
							<textcolor>text_primary</textcolor>
						</control>
						<control type="label">
							<left>0</left>
							<right>28</right>
							<top>2</top>
							<height>36</height>
							<align>right</align>
							<aligny>center</aligny>
							<label>$INFO[ListItem.Label2]</label>
							<textcolor>text_primary</textcolor>
							<selectedcolor>text_primary</selectedcolor>
						</control>
					</focusedlayout>
				</control>
			</control>
			<control type="group">
				<depth>DepthContentPanel</depth>
				<include>OpenClose_Left</include>
				<include>NaraSettingsSidebar</include>
				<control type="grouplist" id="9000">
					<orientation>vertical</orientation>
					<itemgap>4</itemgap>
					<onup>9000</onup>
					<ondown>9000</ondown>
					<onleft>50</onleft>
					<onright>50</onright>
					<usecontrolcoords>true</usecontrolcoords>
					<control type="togglebutton" id="4">
						<height>78</height>
						<aligny>center</aligny>
						<textoffsetx>24</textoffsetx>
						<texturenofocus />
						<texturefocus colordiffuse="glass_focus_light" border="14">shapes/round14.png</texturefocus>
						<alttexturenofocus />
						<alttexturefocus colordiffuse="glass_focus_light" border="14">shapes/round14.png</alttexturefocus>
						<textcolor>text_primary</textcolor>
						<focusedcolor>text_primary</focusedcolor>
						<label>$LOCALIZE[31032]: $LOCALIZE[584]</label>
						<altlabel>$LOCALIZE[31032]: $LOCALIZE[585]</altlabel>
					</control>
					<control type="button" id="21">
						<width>100%</width>
						<height>78</height>
						<align>left</align>
						<aligny>center</aligny>
						<textoffsetx>24</textoffsetx>
						<texturenofocus />
						<texturefocus colordiffuse="glass_focus_light" border="14">shapes/round14.png</texturefocus>
						<textcolor>text_primary</textcolor>
						<focusedcolor>text_primary</focusedcolor>
						<label></label>
						<onclick></onclick>
						<selectedcolor>text_primary</selectedcolor>
					</control>
					<control type="radiobutton" id="22">
						<height>78</height>
						<aligny>center</aligny>
						<texturenofocus />
						<texturefocus colordiffuse="glass_focus_light" border="14">shapes/round14.png</texturefocus>
