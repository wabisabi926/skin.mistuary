<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<controls>
		<include>NaraSettingsBackground</include>
		<!-- 内容面板：这三页原本没有自己的底板，文字直接压在背景图上；
		     补一块和文件管理器同款的磨砂玻璃，文字仍是白色 -->
		<control type="image">
			<left>505</left>
			<top>145</top>
			<width>1355</width>
			<height>740</height>
			<texture colordiffuse="$VAR[NaraGlassPageTintVar]" border="20">shapes/glass20.png</texture>
		</control>
		<control type="group" id="9100">
			<include>OpenClose_Right</include>
			<left>0</left>
			<control type="panel" id="2">
				<top>189</top>
				<left>553</left>
				<visible>Container(9000).Hasfocus(2)</visible>
				<width>1259</width>
				<height>652</height>
				<pagecontrol>60</pagecontrol>
				<onleft>9000</onleft>
				<onright>9000</onright>
				<onup>2</onup>
				<ondown>2</ondown>
				<scrolltime>200</scrolltime>
				<itemlayout height="330" width="300">
					<control type="image">
						<top>5</top>
						<width>270</width>
						<height>320</height>
						<texture colordiffuse="surface_raised" border="24">shapes/round24.png</texture>
					</control>
					<control type="image">
						<left>45</left>
						<top>32</top>
						<width>180</width>
						<height>180</height>
						<aspectratio>scale</aspectratio>
						<texture fallback="DefaultUser.png">$INFO[ListItem.Icon]</texture>
					</control>
					<control type="label">
						<left>20</left>
						<top>215</top>
						<width>260</width>
						<height>100</height>
						<align>center</align>
						<aligny>top</aligny>
						<label>$INFO[ListItem.Label]</label>
					</control>
					<control type="label">
						<left>20</left>
						<top>248</top>
						<width>260</width>
						<height>100</height>
						<font>font10</font>
						<align>center</align>
						<aligny>top</aligny>
						<label>$LOCALIZE[31029]:</label>
						<visible>!String.IsEqual(Listitem.Label,$LOCALIZE[20058])</visible>
					</control>
					<control type="label">
						<left>20</left>
						<top>277</top>
						<width>260</width>
						<height>100</height>
						<font>font10</font>
						<align>center</align>
						<aligny>top</aligny>
						<label fallback="13170">$INFO[ListItem.Label2]</label>
						<visible>!String.Contains(Listitem.Label,$LOCALIZE[20058])</visible>
					</control>
				</itemlayout>
				<focusedlayout height="330" width="300">
					<control type="group">
						<animation effect="zoom" start="100" end="105" time="200" tween="sine" easing="inout" center="150,165">Focus</animation>
						<animation effect="zoom" start="105" end="100" time="200" tween="sine" easing="inout" center="150,165">UnFocus</animation>
						<control type="image">
							<top>5</top>
							<width>270</width>
							<height>320</height>
							<texture colordiffuse="surface_raised" border="24">shapes/round24.png</texture>
						</control>
						<control type="image">
							<top>5</top>
							<width>270</width>
							<height>320</height>
							<texture colordiffuse="glass_focus_light" border="14">shapes/round14.png</texture>
							<include>Animation_FocusTextureFade</include>
						</control>
						<control type="image">
							<left>45</left>
							<top>32</top>
							<width>180</width>
							<height>180</height>
							<aspectratio>scale</aspectratio>
							<texture fallback="DefaultUser.png">$INFO[ListItem.Icon]</texture>
						</control>
						<control type="label">
							<left>20</left>
							<top>215</top>
							<width>260</width>
							<height>100</height>
							<align>center</align>
							<aligny>top</aligny>
							<label>$INFO[ListItem.Label]</label>
							<textcolor>text_primary</textcolor>
							<selectedcolor>text_primary</selectedcolor>
						</control>
						<control type="label">
							<left>20</left>
							<top>248</top>
							<width>260</width>
							<height>100</height>
							<font>font10</font>
							<align>center</align>
							<aligny>top</aligny>
							<label>$LOCALIZE[31029]:</label>
							<textcolor>text_primary</textcolor>
							<selectedcolor>text_primary</selectedcolor>
							<visible>!String.Contains(Listitem.Label,$LOCALIZE[20058])</visible>
						</control>
						<control type="label">
							<left>20</left>
							<top>277</top>
							<width>260</width>
							<height>100</height>
							<font>font10</font>
							<align>center</align>
							<aligny>top</aligny>
							<label fallback="13170">$INFO[ListItem.Label2]</label>
							<textcolor>text_primary</textcolor>
							<selectedcolor>text_primary</selectedcolor>
							<visible>!String.Contains(Listitem.Label,$LOCALIZE[20058])</visible>
						</control>
					</control>
				</focusedlayout>
			</control>
			<control type="scrollbar" id="60">
				<left>1874</left>
				<top>165</top>
				<width>8</width>
				<height>700</height>
				<orientation>vertical</orientation>
				<texturesliderbackground />
				<animation effect="slide" end="6,0" time="300" tween="sine" easing="inout" condition="!Control.HasFocus(60)">conditional</animation>
				<onleft>2</onleft>
				<onright>2</onright>
				<visible>Container(9000).Hasfocus(2)</visible>
			</control>
			<control type="grouplist" id="9001">
				<visible>Container(9000).Hasfocus(1)</visible>
				<left>553</left>
				<width>1259</width>
				<height>652</height>
				<top>189</top>
				<onleft>9000</onleft>
				<onright>9000</onright>
				<onup>9001</onup>
				<ondown>9001</ondown>
				<control type="radiobutton" id="4">
					<label>$LOCALIZE[31057]</label>
					<include>NaraSettingsRow</include>
				</control>
				<control type="button" id="5">
					<label>$LOCALIZE[31058]</label>
					<label2>$INFO[System.ProfileAutoLogin]</label2>
					<include>NaraSettingsRow</include>
					<enable>!Window.IsVisible(ProfileSettings) + !System.HasLoginScreen</enable>
				</control>
			</control>
		</control>
		<control type="group">
			<depth>DepthContentPanel</depth>
			<include>OpenClose_Left</include>
			<include>NaraSettingsSidebar</include>
			<control type="list" id="9000">
				<onleft>9100</onleft>
				<onright>9100</onright>
				<onup>9000</onup>
				<ondown>9000</ondown>
				<scrolltime>300</scrolltime>
				<itemlayout height="78" width="368">
					<control type="label">
						<left>24</left>
						<right>24</right>
						<bottom>0</bottom>
						<label>$INFO[ListItem.Label]</label>
						<font>font26</font>
						<aligny>center</aligny>
					</control>
				</itemlayout>
				<focusedlayout height="78" width="368">
					<control type="image">
						<right>0</right>
						<bottom>0</bottom>
						<texture colordiffuse="glass_focus_light" border="14">shapes/round14.png</texture>
						<animation effect="fade" start="100" end="50" time="40" condition="!Control.HasFocus(9000)">Conditional</animation>
					</control>
					<control type="label">
						<left>24</left>
						<right>24</right>
						<bottom>0</bottom>
						<label>$INFO[ListItem.Label]</label>
						<textcolor>text_primary</textcolor>
						<selectedcolor>text_primary</selectedcolor>
						<font>font26</font>
						<aligny>center</aligny>
					</control>
				</focusedlayout>
				<content>
					<item id="1">
						<label>$LOCALIZE[128]</label>
						<onclick>noop</onclick>
						<icon />
					</item>
					<item id="2">
						<label>$LOCALIZE[13200]</label>
						<onclick>noop</onclick>
						<icon />
					</item>
				</content>
				<left>76</left>
				<top>165</top>
				<width>368</width>
				<height>685</height>
			</control>
		</control>
		<include content="TopBar">
			<param name="breadcrumbs_label" value="$LOCALIZE[10034]" />
		</include>
		<include>BottomBar</include>
	</controls>
</window>
