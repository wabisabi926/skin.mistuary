	<include name="InfoWallMovieLayout">
		<param name="focused">false</param>
		<param name="show_caption">true</param>
		<param name="caption_title_color">text_primary</param>
		<param name="caption_year_color">text_secondary</param>
		<param name="progress_height">3</param>
		<param name="progress_visible_condition">true</param>
		<!-- 焦点环：外扩 1px、描边 3px → 内缘压进海报 2px（盖住遮罩羽化，环贴在海报边上）。
		     环外半径 13 = 遮罩半径 12 + 1，圆心与海报圆角同心（12−1+13 = 12+12 = 24）。
		     **不要加 bordersize**：有它控件会变成 CGUIBorderedImage 走九宫格，
		     而描边环必须是 1:1 整图（见 tools/gen_rings.py 的文件头）。 -->
		<param name="focus_border">2</param>
		<param name="focus_left">11</param>
		<param name="focus_top">-1</param>
		<param name="focus_width">238</param>
		<param name="focus_height">342</param>
		<definition>
			<control type="group">
				<visible>String.IsEmpty(ListItem.Art(poster))</visible>
				<control type="image">
					<left>12</left>
					<top>0</top>
					<width>236</width>
					<height>340</height>
					<texture colordiffuse="selection_surface" border="12">shapes/round12.png</texture>
				</control>
				<control type="image">
					<left>$PARAM[focus_left]</left>
					<top>$PARAM[focus_top]</top>
					<width>$PARAM[focus_width]</width>
					<height>$PARAM[focus_height]</height>
					<texture colordiffuse="focus_card_surface">shapes/ring_card_238x342_r13.png</texture>
					<visible>$PARAM[focused]</visible>
					<include condition="$PARAM[focused]">Animation_FocusTextureFade</include>
				</control>
			</control>
			<control type="group">
				<visible>!String.IsEmpty(ListItem.Art(poster))</visible>
				<!-- 真圆角：`diffuse` 是**逐像素相乘（含 alpha）**，给一张"圆角内白、圆角外透明"
				     的遮罩，海报四角就是真透明 —— 背景透出来，不是盖一块深色。
				     遮罩尺寸必须和控件完全一致（244×352），否则会被拉伸、圆角变形。 -->
				<control type="image">
					<left>12</left>
					<top>0</top>
					<width>236</width>
					<height>340</height>
					<texture background="true" diffuse="shapes/mask_236x340_r12.png">$INFO[ListItem.Art(poster)]</texture>
					<aspectratio scalediffuse="false">scale</aspectratio>
				</control>
				<control type="image">
					<left>$PARAM[focus_left]</left>
					<top>$PARAM[focus_top]</top>
					<width>$PARAM[focus_width]</width>
					<height>$PARAM[focus_height]</height>
					<texture colordiffuse="focus_media">shapes/ring_card_238x342_r13.png</texture>
					<visible>$PARAM[focused]</visible>
					<include condition="$PARAM[focused]">Animation_FocusTextureFade</include>
				</control>
			</control>
			<control type="group">
				<visible>String.IsEqual(ListItem.DBtype,tvshow) | String.IsEqual(ListItem.DBType,season) | ListItem.IsRecording | ListItem.HasReminder | ListItem.HasTimer | ListItem.IsCollection | ListItem.HasVideoVersions | ListItem.IsPlaying | ListItem.IsResumable | ListItem.HasVideoExtras | ListItem.HasArchive | Integer.IsGreater(ListItem.Playcount,0)</visible>
				<control type="image">
					<left>58</left>
					<top>301</top>
					<width>28</width>
					<height>28</height>
					<align>left</align>
					<aligny>center</aligny>
					<texture>$VAR[ItemTypeIconVar]</texture>
				</control>
				<control type="image">
					<left>92</left>
					<top>301</top>
					<width>28</width>
					<height>28</height>
					<align>left</align>
					<aligny>center</aligny>
					<texture>overlays/extras.png</texture>
					<visible>ListItem.HasVideoVersions + ListItem.HasVideoExtras + !$EXP[videoasset_true]</visible>
				</control>
				<control type="label">
					<left>96</left>
					<top>302</top>
					<width>140</width>
					<label>$VAR[WatchedStatusVar]</label>
					<font>font20_title</font>
					<align>right</align>
					<visible>String.IsEqual(ListItem.DBtype,tvshow) | String.IsEqual(ListItem.DBtype,set) | String.IsEqual(ListItem.DBType,season)</visible>
				</control>
				<control type="image">
					<left>24</left>
					<top>301</top>
					<width>28</width>
					<height>28</height>
					<texture colordiffuse="$VAR[StatusIconColorVar]">$VAR[ItemStatusIconVar]</texture>
				</control>
			</control>
			<control type="group">
				<left>188</left>
				<top>12</top>
				<include condition="Skin.HasSetting(circle_rating) | Skin.HasSetting(circle_userrating)">RatingCircle</include>
			</control>
			<control type="progress">
				<left>22</left>
				<top>323</top>
				<width>216</width>
				<height>$PARAM[progress_height]</height>
				<reveal>true</reveal>
				<texturebg border="8,0,8,0" colordiffuse="progress_track">progress/card_progress_r8.png</texturebg>
				<midtexture border="8,0,8,0" colordiffuse="progress_playback">progress/card_progress_r8.png</midtexture>
				<info>ListItem.PercentPlayed</info>
				<visible>!Integer.IsEqual(ListItem.PercentPlayed,0) + [$PARAM[progress_visible_condition]]</visible>
			</control>
			<include content="PosterCardCaption" condition="$PARAM[show_caption]">
				<param name="focused" value="$PARAM[focused]" />
				<param name="title_color" value="$PARAM[caption_title_color]" />
				<param name="year_color" value="$PARAM[caption_year_color]" />
			</include>
		</definition>
	</include>
