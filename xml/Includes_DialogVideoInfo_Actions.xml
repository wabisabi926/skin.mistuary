<?xml version="1.0" encoding="utf-8"?>
<includes>
	<include name="VideoInfoActionGlass">
		<param name="button_id">0</param>
		<param name="ring">shapes/ring_btn_70x70_r35.png</param>
		<param name="base">glass_regular</param>
		<param name="focus">glass_focus_medium</param>
		<definition>
			<control type="image">
				<width>100%</width>
				<height>100%</height>
				<texture colordiffuse="$PARAM[base]" border="35">shapes/round35.png</texture>
			</control>
			<!-- 通用版：深色底板在暗背景上会隐形，加一圈 12% 白的描边定义边界 -->
			<control type="image">
				<width>100%</width>
				<height>100%</height>
				<texture colordiffuse="border_subtle">$PARAM[ring]</texture>
			</control>
			<control type="image">
				<width>100%</width>
				<height>100%</height>
				<texture colordiffuse="$PARAM[focus]" border="35">shapes/round35.png</texture>
				<visible>Control.HasFocus($PARAM[button_id])</visible>
				<animation effect="fade" start="0" end="100" time="180" tween="sine" easing="out">VisibleChange</animation>
			</control>
		</definition>
	</include>
	<!-- Action bar: the primary extension point for movie and television variants. -->
	<include name="VideoInfoActionBar">
		<control type="grouplist">
			<left>-16</left>
			<top>541</top>
			<width>1776</width>
			<height>94</height>
			<orientation>horizontal</orientation>
			<itemgap>21</itemgap>
			<!-- Match the movie page's 52 px action-to-shelf breathing room. -->
			<animation effect="slide" start="0,-52" end="0,-52" condition="String.IsEqual(ListItem.DBType,tvshow)">Conditional</animation>
			<control type="group">
				<width>220</width>
				<height>94</height>
				<control type="group">
					<left>16</left>
					<top>12</top>
					<width>220</width>
					<height>70</height>
					<!-- 播放键是整页唯一的主动作：实心浅底 + 深色文字，和右侧四个图标按钮拉开层级 -->
					<include content="VideoInfoActionGlass">
						<param name="button_id" value="5000" />
						<param name="ring" value="shapes/ring_btn_220x70_r35.png" />
						<param name="base" value="E6FFFFFF" />
						<param name="focus" value="33000000" />
					</include>
					<control type="button" id="5000">
						<width>220</width>
						<height>70</height>
						<font>font13</font>
						<align>center</align>
						<aligny>center</aligny>
						<label>$VAR[VideoInfoPlayButtonLabelVar]</label>
						<textcolor>ink_primary</textcolor>
						<focusedcolor>ink_primary</focusedcolor>
						<texturefocus />
						<texturenofocus />
						<onup>138</onup>
						<ondown condition="String.IsEqual(ListItem.DBType,tvshow) + Integer.IsGreater(ListItem.DBID,0)">5100</ondown>
						<ondown>50</ondown>
						<onleft>5003</onleft>
						<onright>5001</onright>
						<onclick condition="String.IsEqual(ListItem.DBType,tvshow)">PlayMedia(videodb://tvshows/titles/$INFO[ListItem.DBID]/,resume,tvshowtarget)</onclick>
						<onclick condition="!String.IsEqual(ListItem.DBType,tvshow)">SendClick(8)</onclick>
					</control>
				</control>
			</control>
			<!-- Favourite -->
			<control type="group">
				<width>70</width>
				<height>94</height>
				<visible>Control.IsEnabled(16)</visible>
				<control type="group">
					<left>16</left>
					<top>12</top>
					<width>70</width>
					<height>70</height>
					<include content="VideoInfoActionGlass">
						<param name="button_id" value="5001" />
					</include>
					<control type="button" id="5001">
						<description>Favourite</description>
						<width>70</width>
						<height>70</height>
						<label />
						<texturefocus />
						<texturenofocus />
						<onup>138</onup>
						<ondown condition="String.IsEqual(ListItem.DBType,tvshow) + Integer.IsGreater(ListItem.DBID,0)">5100</ondown>
						<ondown>50</ondown>
						<onleft>5000</onleft>
						<onright condition="[String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,movie)] + Integer.IsGreater(ListItem.DBID,0)">5006</onright>
						<onright condition="ListItem.HasVideoVersions">5004</onright>
						<onright condition="!ListItem.HasVideoVersions + !String.IsEmpty(ListItem.SetID)">5005</onright>
						<onright>5003</onright>
						<onclick>SendClick(16)</onclick>
					</control>
					<control type="image">
						<left>12</left>
						<top>12</top>
						<width>46</width>
						<height>46</height>
						<texture colordiffuse="text_primary">icons/infodialogs/favourite.png</texture>
						<visible>!String.IsEqual(ListItem.Property(isfavourite),true)</visible>
					</control>
					<control type="image">
						<left>12</left>
						<top>12</top>
						<width>46</width>
						<height>46</height>
						<texture colordiffuse="text_primary">icons/infodialogs/favourite-filled.png</texture>
						<visible>String.IsEqual(ListItem.Property(isfavourite),true)</visible>
					</control>
				</control>
			</control>
			<!-- Standard Kodi watched-state toggle for library movies and entire TV shows. -->
			<control type="group">
				<width>70</width>
				<height>94</height>
				<visible>[String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,movie)] + Integer.IsGreater(ListItem.DBID,0)</visible>
				<control type="group">
					<left>16</left>
					<top>12</top>
					<width>70</width>
					<height>70</height>
					<include content="VideoInfoActionGlass">
						<param name="button_id" value="5006" />
					</include>
					<control type="button" id="5006">
						<description>Toggle watched</description>
						<width>70</width>
						<height>70</height>
						<label />
						<texturefocus />
						<texturenofocus />
						<onup>138</onup>
						<ondown condition="String.IsEqual(ListItem.DBType,tvshow)">5100</ondown>
						<ondown>50</ondown>
						<onleft>5001</onleft>
						<onright condition="String.IsEqual(ListItem.DBType,movie) + ListItem.HasVideoVersions">5004</onright>
						<onright condition="String.IsEqual(ListItem.DBType,movie) + !ListItem.HasVideoVersions + !String.IsEmpty(ListItem.SetID)">5005</onright>
						<onright>5003</onright>
						<onclick>SendClick(17)</onclick>
					</control>
					<control type="image">
						<left>11</left>
						<top>11</top>
						<width>48</width>
						<height>48</height>
						<texture colordiffuse="text_primary">icons/infodialogs/unwatched-outline.png</texture>
						<visible>!Integer.IsGreater(ListItem.PlayCount,0)</visible>
					</control>
					<control type="image">
						<left>11</left>
						<top>11</top>
						<width>48</width>
						<height>48</height>
						<texture colordiffuse="text_primary">icons/infodialogs/watched-filled.png</texture>
						<visible>Integer.IsGreater(ListItem.PlayCount,0)</visible>
					</control>
				</control>
			</control>
			<!-- Versions -->
			<control type="group">
				<width>70</width>
				<height>94</height>
				<visible>ListItem.HasVideoVersions</visible>
				<control type="group">
					<left>16</left>
					<top>12</top>
					<width>70</width>
					<height>70</height>
					<include content="VideoInfoActionGlass">
						<param name="button_id" value="5004" />
					</include>
					<control type="button" id="5004">
						<description>Versions</description>
						<width>70</width>
						<height>70</height>
						<label />
						<texturefocus />
						<texturenofocus />
						<onup>138</onup>
						<ondown condition="String.IsEqual(ListItem.DBType,tvshow) + Integer.IsGreater(ListItem.DBID,0)">5100</ondown>
						<ondown>50</ondown>
						<onleft condition="String.IsEqual(ListItem.DBType,movie) + Integer.IsGreater(ListItem.DBID,0)">5006</onleft>
						<onleft>5001</onleft>
						<onright condition="!String.IsEmpty(ListItem.SetID)">5005</onright>
						<onright condition="String.IsEmpty(ListItem.SetID)">5003</onright>
						<onclick>SendClick(14)</onclick>
					</control>
					<control type="image">
						<left>12</left>
						<top>12</top>
						<width>46</width>
						<height>46</height>
						<texture colordiffuse="text_primary">icons/infodialogs/versions.png</texture>
					</control>
				</control>
			</control>
			<!-- Movie set -->
			<control type="group">
				<width>70</width>
				<height>94</height>
				<visible>!String.IsEmpty(ListItem.SetID)</visible>
				<control type="group">
					<left>16</left>
					<top>12</top>
					<width>70</width>
					<height>70</height>
					<include content="VideoInfoActionGlass">
						<param name="button_id" value="5005" />
					</include>
					<control type="button" id="5005">
						<description>Movie set</description>
						<width>70</width>
						<height>70</height>
						<label />
						<texturefocus />
						<texturenofocus />
						<onup>138</onup>
						<ondown condition="String.IsEqual(ListItem.DBType,tvshow) + Integer.IsGreater(ListItem.DBID,0)">5100</ondown>
						<ondown>50</ondown>
						<onleft condition="ListItem.HasVideoVersions">5004</onleft>
						<onleft condition="String.IsEqual(ListItem.DBType,movie) + Integer.IsGreater(ListItem.DBID,0)">5006</onleft>
						<onleft>5001</onleft>
						<onright>5003</onright>
						<onclick condition="Window.IsActive(1111)">Action(Close)</onclick>
						<onclick condition="!Window.IsActive(1111)">SetProperty(MovieSetDialog.SetId,$INFO[ListItem.SetId],home)</onclick>
						<onclick condition="!Window.IsActive(1111)">SetProperty(MovieSetDialog.SetName,$ESCINFO[ListItem.Set],home)</onclick>
						<onclick condition="!Window.IsActive(1111)">SetProperty(MovieSetDialog.SourceFanart,$ESCINFO[ListItem.Art(fanart)],home)</onclick>
						<onclick condition="!Window.IsActive(1111)">ActivateWindow(1111)</onclick>
					</control>
					<control type="image">
						<left>12</left>
						<top>12</top>
						<width>46</width>
						<height>46</height>
						<texture colordiffuse="text_primary">icons/infodialogs/set.png</texture>
					</control>
				</control>
			</control>
			<!-- More -->
			<control type="group">
				<width>70</width>
				<height>94</height>
				<control type="group">
					<left>16</left>
					<top>12</top>
					<width>70</width>
					<height>70</height>
					<include content="VideoInfoActionGlass">
						<param name="button_id" value="5003" />
					</include>
					<control type="button" id="5003">
						<description>More</description>
						<width>70</width>
						<height>70</height>
						<label />
						<texturefocus />
						<texturenofocus />
						<onup>138</onup>
						<ondown condition="String.IsEqual(ListItem.DBType,tvshow) + Integer.IsGreater(ListItem.DBID,0)">5100</ondown>
						<ondown>50</ondown>
						<onleft condition="!String.IsEmpty(ListItem.SetID)">5005</onleft>
						<onleft condition="String.IsEmpty(ListItem.SetID) + ListItem.HasVideoVersions">5004</onleft>
						<onleft condition="String.IsEmpty(ListItem.SetID) + !ListItem.HasVideoVersions + [String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,movie)] + Integer.IsGreater(ListItem.DBID,0)">5006</onleft>
						<onleft>5001</onleft>
						<onright condition="!String.IsEqual(ListItem.DBType,tvshow) + Integer.IsGreater(Container(50).NumItems,0)">5107</onright>
						<onright>5000</onright>
						<onclick>SetProperty(VideoInfo.More,True,home)</onclick>
						<onclick>AlarmClock(VideoInfoMoreFocus,SetFocus(5199,0,absolute),00:00,silent)</onclick>
					</control>
					<control type="image">
						<left>15</left>
						<top>15</top>
						<width>40</width>
						<height>40</height>
						<texture colordiffuse="text_primary">icons/menu.png</texture>
					</control>
				</control>
			</control>
			<!-- 演员栏默认收起，这里给一个图标开关；电影和电视剧通用 -->
			<control type="group">
				<width>70</width>
				<height>94</height>
				<!-- 电影和电视剧共用同一个开关（电视剧原来只有底部标签） -->
				<visible>Integer.IsGreater(Container(50).NumItems,0)</visible>
				<control type="group">
					<left>16</left>
					<top>12</top>
					<width>70</width>
					<height>70</height>
					<include content="VideoInfoActionGlass">
						<param name="button_id" value="5107" />
						<param name="ring" value="shapes/ring_btn_70x70_r35.png" />
					</include>
					<!-- 已展开：比焦点态更淡的一层底色，提示当前状态 -->
					<control type="image">
						<width>100%</width>
						<height>100%</height>
						<texture colordiffuse="glass_focus_light" border="35">shapes/round35.png</texture>
						<visible>Skin.HasSetting(nara_cast_open)</visible>
						<animation effect="fade" start="0" end="100" time="160" tween="sine">Visible</animation>
						<animation effect="fade" start="100" end="0" time="120">Hidden</animation>
					</control>
					<control type="button" id="5107">
						<description>Cast toggle</description>
						<width>70</width>
						<height>70</height>
						<label />
						<texturefocus />
						<texturenofocus />
						<onup>138</onup>
						<ondown condition="Skin.HasSetting(nara_cast_open)">50</ondown>
						<ondown>5107</ondown>
						<onleft>5003</onleft>
						<onright>5000</onright>
						<!-- 用皮肤设置存状态：Window.Property 在这套皮肤里验证不通，
						     Skin.HasSetting 是确定可用的（透白开关就靠它）。 -->
						<onclick>Skin.ToggleSetting(nara_cast_open)</onclick>
					</control>
					<control type="image">
						<left>12</left>
						<top>12</top>
						<width>46</width>
						<height>46</height>
						<texture colordiffuse="text_primary">icons/infodialogs/cast.png</texture>
					</control>
				</control>
			</control>
		</control>
	</include>
</includes>
