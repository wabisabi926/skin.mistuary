	<include name="NaraMediaMenuViewPill">
		<param name="width">81</param>
		<definition>
			<control type="button" id="$PARAM[control_id]">
				<width>$PARAM[width]</width>
				<height>40</height>
				<font>font_nara_media_menu_view</font>
