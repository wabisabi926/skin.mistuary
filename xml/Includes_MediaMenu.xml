				<radioposy>14</radioposy>
				<radiowidth>24</radiowidth>
				<radioheight>24</radioheight>
				<textcolor>text_primary</textcolor>
				<focusedcolor>text_primary</focusedcolor>
				<texturefocus colordiffuse="glass_focus_light">colors/white.png</texturefocus>
				<texturenofocus />
				<textureradioonfocus colordiffuse="text_primary">$PARAM[icon]</textureradioonfocus>
				<textureradioonnofocus colordiffuse="text_primary">$PARAM[icon]</textureradioonnofocus>
				<textureradioofffocus colordiffuse="text_secondary">$PARAM[icon]</textureradioofffocus>
				<textureradiooffnofocus colordiffuse="text_secondary">$PARAM[icon]</textureradiooffnofocus>
				<label>$PARAM[label]</label>
				<label2>$PARAM[label2]</label2>
				<selected>$PARAM[selected]</selected>
