	<include name="NaraMediaMenuWatchedChoice">
		<definition>
			<control type="radiobutton" id="$PARAM[control_id]">
				<width>384</width>
				<height>48</height>
				<font>font12</font>
				<align>left</align>
				<aligny>center</aligny>
				<textoffsetx>54</textoffsetx>
				<radioposx>20</radioposx>
				<radioposy>17</radioposy>
				<radiowidth>14</radiowidth>
				<radioheight>14</radioheight>
				<textcolor>text_primary</textcolor>
				<focusedcolor>text_primary</focusedcolor>
				<texturefocus colordiffuse="glass_focus_light">colors/white.png</texturefocus>
				<texturenofocus />
				<textureradioonfocus colordiffuse="text_primary" border="7">shapes/round7.png</textureradioonfocus>
				<textureradioonnofocus colordiffuse="text_primary" border="7">shapes/round7.png</textureradioonnofocus>
				<textureradioofffocus colordiffuse="55FFFFFF" border="7">shapes/round7.png</textureradioofffocus>
				<textureradiooffnofocus colordiffuse="28FFFFFF" border="7">shapes/round7.png</textureradiooffnofocus>
				<label>$PARAM[label]</label>
				<selected>String.IsEqual(Control.GetLabel(10),$PARAM[label])</selected>
				<onclick condition="$PARAM[one_click_from]">SendClick(10)</onclick>
				<onclick condition="$PARAM[two_clicks_from]">SendClick(10)</onclick>
				<onclick condition="$PARAM[two_clicks_from]">SendClick(10)</onclick>
				<onright>50</onright>
				<onback>50</onback>
			</control>
			<!-- The negative top offset overlays the count on the preceding choice without
			     changing the scrolling layout. Its unique ID keeps grouplist navigation intact. -->
			<control type="group" id="$PARAM[count_control_id]">
				<left>310</left>
				<top>-48</top>
				<width>54</width>
				<height>48</height>
				<control type="label">
					<width>54</width><height>48</height>
					<font>font10</font><align>right</align><aligny>center</aligny>
					<textcolor>text_secondary</textcolor><label>$PARAM[count_label]</label>
					<visible>!Control.HasFocus($PARAM[control_id])</visible>
				</control>
				<control type="label">
					<width>54</width><height>48</height>
					<font>font10</font><align>right</align><aligny>center</aligny>
					<textcolor>text_primary</textcolor><label>$PARAM[count_label]</label>
					<visible>Control.HasFocus($PARAM[control_id])</visible>
				</control>
			</control>
		</definition>
	</include>
	<include name="NaraVideoLibraryMediaMenuList">
		<definition>
			<left>24</left>
			<top>20</top>
			<width>384</width>
			<height>1040</height>
			<!-- Control 10 is the real Kodi watched-mode controller. It stays
			     off-screen, while the visible three-state group drives it. -->
			<control type="button" id="10">
				<textcolor>text_primary</textcolor>
				<include>HiddenObject</include>
				<visible>true</visible>
			</control>
			<!-- The window uses this hidden message target to restore the root of the blade whenever
			     menucontrol re-enters it after focus previously left from a nested filter list. -->
			<control type="button" id="9160">
				<textcolor>text_primary</textcolor>
				<include>HiddenObject</include>
				<visible>true</visible>
			</control>
			<control type="label">
				<left>18</left><top>8</top><width>300</width><height>44</height>
				<font>font_nara_media_menu_title</font><textcolor>text_primary</textcolor>
				<label>$VAR[BreadcrumbsVideoVar]</label>
			</control>
			<control type="grouplist" id="9120">
				<left>18</left><top>78</top><width>348</width><height>40</height>
				<orientation>horizontal</orientation>
				<align>left</align>
				<itemgap>8</itemgap>
				<onleft>9120</onleft><onright>50</onright><onup>9120</onup>
				<ondown>9111</ondown>
				<include content="NaraMediaMenuViewPill"><param name="control_id" value="9121" /><param name="label" value="$LOCALIZE[31683]" /><param name="onclick" value="Container.SetViewMode(50)" /></include>
				<include content="NaraMediaMenuViewPill"><param name="control_id" value="9122" /><param name="label" value="$LOCALIZE[31685]" /><param name="onclick" value="Container.SetViewMode(51)" /></include>
				<include content="NaraMediaMenuViewPill"><param name="control_id" value="9123" /><param name="label" value="$LOCALIZE[31686]" /><param name="onclick" value="Container.SetViewMode(501)" /></include>
				<include content="NaraMediaMenuViewPill"><param name="control_id" value="9124" /><param name="label" value="$LOCALIZE[31692]" /><param name="onclick" value="Container.SetViewMode(500)" /></include>
			</control>
			<!-- Only this single column scrolls. The header and view switcher remain fixed and
			     are linked into the same focus chain. -->
			<control type="grouplist" id="9110">
				<left>0</left><top>144</top><width>384</width><height>896</height>
				<scrolltime>180</scrolltime>
				<usecontrolcoords>true</usecontrolcoords>
				<!-- Kodi rewrites vertical child navigation when controls are inserted into a
				     grouplist. Every direct child, including non-focusable labels and dividers,
				     therefore needs a unique ID so OnMove can traverse the generated chain.
				     Define only the list exits here on the scrolling parent. -->
				<onup>9120</onup><ondown>9120</ondown>
				<onleft>9110</onleft><onright>50</onright><onback>50</onback>
				<include content="NaraMediaMenuSectionLabel"><param name="control_id" value="9201" /><param name="label" value="$LOCALIZE[31684]" /></include>
				<include content="NaraMediaMenuWatchedChoice"><param name="control_id" value="9111" /><param name="count_control_id" value="9211" /><param name="label" value="$LOCALIZE[16100]" /><param name="count_label" value="$INFO[Window.Property(NaraMediaMenu.AllCount)]" /><param name="one_click_from" value="String.IsEqual(Control.GetLabel(10),$LOCALIZE[16102])" /><param name="two_clicks_from" value="String.IsEqual(Control.GetLabel(10),$LOCALIZE[16101])" /></include>
				<include content="NaraMediaMenuWatchedChoice"><param name="control_id" value="9112" /><param name="count_control_id" value="9212" /><param name="label" value="$LOCALIZE[16101]" /><param name="count_label" value="$INFO[Window.Property(NaraMediaMenu.UnwatchedCount)]" /><param name="one_click_from" value="String.IsEqual(Control.GetLabel(10),$LOCALIZE[16100])" /><param name="two_clicks_from" value="String.IsEqual(Control.GetLabel(10),$LOCALIZE[16102])" /></include>
				<include content="NaraMediaMenuWatchedChoice"><param name="control_id" value="9113" /><param name="count_control_id" value="9213" /><param name="label" value="$LOCALIZE[16102]" /><param name="count_label" value="$INFO[Window.Property(NaraMediaMenu.WatchedCount)]" /><param name="one_click_from" value="String.IsEqual(Control.GetLabel(10),$LOCALIZE[16101])" /><param name="two_clicks_from" value="String.IsEqual(Control.GetLabel(10),$LOCALIZE[16100])" /></include>
				<include content="NaraMediaMenuDivider"><param name="control_id" value="9202" /><param name="visible" value="$EXP[nara_video_library_advanced_filters]" /></include>
				<!-- 筛选交给 Kodi 原生媒体筛选对话框（Action(Filter) → CGUIDialogMediaFilter）。
				     它走 DialogSettings.xml，皮肤底部本来就有 OK(28) / 取消(29) / 清除(30)，
				     所以不用另建对话框 XML。原来那三行「类型 / 年代 / 评分」+ 三个空 list
				     是从 Estuary N 带进来的骨架，数据源和属性写入都没有，已删。 -->
				<include content="NaraMediaMenuNavItem"><param name="control_id" value="9116" /><param name="label" value="$LOCALIZE[31687]" /><param name="label2" /><param name="icon" value="icons/mediamenu/genres.png" /><param name="selected" value="Container.Filtered" /><param name="onclick" value="Action(Filter)" /><param name="close_menu" value="true" /><param name="visible" value="$EXP[nara_video_library_advanced_filters]" /></include>
				<include content="NaraMediaMenuDivider"><param name="control_id" value="9204" /><param name="visible" value="Control.IsEnabled(3)" /></include>
				<include content="NaraMediaMenuSectionLabel"><param name="control_id" value="9205" /><param name="label" value="$LOCALIZE[31688]" /><param name="visible" value="Control.IsEnabled(3)" /></include>
				<include content="NaraMediaMenuChoiceItem"><param name="control_id" value="9131" /><param name="label" value="$LOCALIZE[556]" /><param name="selected" value="$EXP[nara_video_library_title_sort]" /><param name="onclick" value="Container.SetSortMethod(29)" /><param name="onclick_condition" value="!Container.Content(sets)" /><param name="onclick_alt" value="Container.SetSortMethod(1)" /><param name="onclick_alt_condition" value="Container.Content(sets)" /><param name="visible" value="Control.IsEnabled(3)" /></include>
				<include content="NaraMediaMenuChoiceItem"><param name="control_id" value="9132" /><param name="label" value="$LOCALIZE[562]" /><param name="selected" value="Container.SortMethod(16)" /><param name="onclick" value="Container.SetSortMethod(16)" /><param name="visible" value="Control.IsEnabled(3)" /></include>
				<include content="NaraMediaMenuChoiceItem"><param name="control_id" value="9133" /><param name="label" value="$LOCALIZE[563]" /><param name="selected" value="Container.SortMethod(17)" /><param name="onclick" value="Container.SetSortMethod(17)" /><param name="visible" value="Control.IsEnabled(3)" /></include>
				<include content="NaraMediaMenuChoiceItem"><param name="control_id" value="9134" /><param name="label" value="$LOCALIZE[31689]" /><param name="selected" value="Container.SortMethod(40)" /><param name="onclick" value="Container.SetSortMethod(40)" /><param name="visible" value="Control.IsEnabled(3)" /></include>
				<include content="NaraMediaMenuDivider"><param name="control_id" value="9206" /><param name="visible" value="Control.IsEnabled(4)" /></include>
				<include content="NaraMediaMenuSectionLabel"><param name="control_id" value="9207" /><param name="label" value="$LOCALIZE[31032]" /><param name="visible" value="Control.IsEnabled(4)" /></include>
				<include content="NaraMediaMenuChoiceItem"><param name="control_id" value="9141" /><param name="label" value="$LOCALIZE[584]" /><param name="selected" value="Container.SortDirection(ascending)" /><param name="onclick_condition" value="!Container.SortDirection(ascending)" /><param name="onclick" value="Container.SetSortDirection" /><param name="visible" value="Control.IsEnabled(4)" /></include>
				<include content="NaraMediaMenuChoiceItem"><param name="control_id" value="9142" /><param name="label" value="$LOCALIZE[585]" /><param name="selected" value="Container.SortDirection(descending)" /><param name="onclick_condition" value="!Container.SortDirection(descending)" /><param name="onclick" value="Container.SetSortDirection" /><param name="visible" value="Control.IsEnabled(4)" /></include>
			</control>
		</definition>
	</include>
