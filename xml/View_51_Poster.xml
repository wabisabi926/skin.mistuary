<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<!-- Cover Deck owns an opaque detail-style backdrop. Keeping it outside the
	     foreground fade prevents Busy from exposing the shared primary artwork. -->
	<include name="View_51_Poster_Background">
		<control type="group">
			<visible>Control.IsVisible(51) + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | $EXP[videoasset_true]]</visible>
			<animation effect="fade" start="0" end="100" time="260" reversible="false" condition="!Window.Previous(home)">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="180" condition="!Window.Next(home)">WindowClose</animation>
			<animation effect="fade" time="220">VisibleChange</animation>
			<!-- 背景层一律用百分比/外扩尺寸：窗口不是 1920×1080 时（如 1902×991 窗口化）
			     固定 1920 画布会右侧露底 -->
			<control type="image">
				<include>FullScreenDimensions</include>
				<texture>colors/black.png</texture>
			</control>
			<control type="image">
				<include>FullScreenDimensions</include>
				<aspectratio>scale</aspectratio>
				<texture colordiffuse="primary_background">special://skin/extras/backgrounds/primary.jpg</texture>
				<visible>Skin.HasSetting(no_fanart)</visible>
			</control>
			<control type="image">
				<include>FullScreenDimensions</include>
				<aspectratio>scale</aspectratio>
				<texture colordiffuse="primary_dim">special://skin/extras/backgrounds/primary.jpg</texture>
				<visible>!Skin.HasSetting(no_fanart) + String.IsEmpty(Container(51).ListItem.Art(fanart))</visible>
			</control>
			<control type="image">
				<include>FullScreenDimensions</include>
				<aspectratio align="right">scale</aspectratio>
				<fadetime>250</fadetime>
				<texture background="true" colordiffuse="fanart_dim">$INFO[Container(51).ListItem.Art(fanart)]</texture>
				<visible>!Skin.HasSetting(no_fanart) + !String.IsEmpty(Container(51).ListItem.Art(fanart))</visible>
			</control>
			<control type="image">
				<include>FullScreenDimensions</include>
				<texture colordiffuse="33000000">colors/black.png</texture>
				<visible>!Skin.HasSetting(no_fanart) + !String.IsEmpty(Container(51).ListItem.Art(fanart))</visible>
			</control>
			<control type="image">
				<top>400</top>
				<left>-120</left>
				<right>-120</right>
				<height>680</height>
				<aspectratio>stretch</aspectratio>
				<texture colordiffuse="66FFFFFF">overlays/overlayfade.png</texture>
			</control>
		</control>
	</include>

	<!-- Deck card for the focused slot. The original slotlist applied position,
	     scale, opacity and dimming per slot; the fixedlist replacement has no
	     per-slot transforms, so deck_on gates the whole card instead. -->
	<include name="NaraPosterDeckCard">
		<param name="deck_on">true</param>
		<definition>
			<!-- 电影/剧集/合集/季 共用这一套：440×660 @ (-60,210)。
			     卡片可以超出 420 宽的槽位 —— deck_on 闸门让未聚焦槽位整组不画，
			     所以只受屏幕边界约束：top + 高 + 84 ≤ 1080（84 = 刻度 30 + 页码 54）。
			     这套卡片原为魔改内核的 slotlist 设计
			     （逐槽位缩放/变暗），降级成 fixedlist 后没有逐槽位变换，所以用
			     deck_on 闸门控制：itemlayout 传 false → 未聚焦槽位整组不画。
			     「整季」这类虚拟条目没有季海报，不画封面层，只留深色底板。 -->
			<control type="group">
				<visible>$PARAM[deck_on]</visible>
				<left>-60</left>
				<top>210</top>
				<width>440</width>
				<height>660</height>
				<depth>DepthContentPopout</depth>
				<control type="image">
					<left>-20</left>
					<top>-20</top>
					<width>480</width>
					<height>700</height>
					<texture colordiffuse="shadow_hard" border="21">overlays/shadow.png</texture>
				</control>
				<control type="image">
					<width>440</width>
					<height>660</height>
					<texture border="12" colordiffuse="selection_surface">shapes/round12.png</texture>
				</control>
				<control type="image">
					<width>440</width>
					<height>660</height>
					<!-- 真圆角：diffuse 逐像素相乘（含 alpha），四角真透明。
					     遮罩必须和控件同尺寸（440×660），半径与底板 round12 / 细边 r12 一致。 -->
					<texture background="true" diffuse="shapes/mask_440x660_r12.png">$VAR[PosterVar]</texture>
					<aspectratio scalediffuse="false">scale</aspectratio>
					<visible>!String.IsEmpty(ListItem.Art(poster))</visible>
				</control>
				<control type="image">
					<right>12</right>
					<bottom>12</bottom>
					<width>32</width>
					<height>32</height>
					<texture colordiffuse="progress_watched">OverlayWatched.png</texture>
					<visible>Integer.IsGreater(ListItem.PlayCount,0)</visible>
				</control>
				<control type="progress">
					<!-- 左右各缩 12px（= 圆角半径）：角现在是真透明的，
					     进度条压到圆角上两端会露在外面 -->
					<left>12</left>
					<bottom>0</bottom>
					<width>416</width>
					<height>4</height>
					<reveal>true</reveal>
					<texturebg border="8,0,8,0" colordiffuse="progress_track">progress/card_progress_r8.png</texturebg>
					<midtexture border="8,0,8,0" colordiffuse="progress_playback">progress/card_progress_r8.png</midtexture>
					<info>ListItem.PercentPlayed</info>
					<visible>!Integer.IsEqual(ListItem.PercentPlayed,0)</visible>
				</control>
				<control type="image">
					<width>440</width>
					<height>660</height>
					<texture colordiffuse="38FFFFFF">shapes/edge_440x660_r12.png</texture>
				</control>
				<!-- 标题和底部页码画在卡片坐标系里，随卡片一起移动，永远对正居中；
				     卡片与上方标题、下方刻度各留同样的 30px 间距 -->
				<control type="label">
					<left>0</left>
					<top>-74</top>
					<width>440</width>
					<height>44</height>
					<font>font32</font>
					<textcolor>text_primary</textcolor>
					<shadowcolor>black</shadowcolor>
					<align>center</align>
					<aligny>center</aligny>
					<scroll>true</scroll>
					<label>$VAR[NaraPosterDeckTitleVar]</label>
				</control>
				<control type="image"><left>112</left><top>690</top><width>2</width><height>12</height><texture colordiffuse="50FFFFFF">colors/white.png</texture></control>
				<control type="image"><left>130</left><top>690</top><width>2</width><height>12</height><texture colordiffuse="50FFFFFF">colors/white.png</texture></control>
				<control type="image"><left>148</left><top>690</top><width>2</width><height>12</height><texture colordiffuse="50FFFFFF">colors/white.png</texture></control>
				<control type="image"><left>166</left><top>690</top><width>2</width><height>12</height><texture colordiffuse="50FFFFFF">colors/white.png</texture></control>
				<control type="image"><left>184</left><top>690</top><width>2</width><height>12</height><texture colordiffuse="50FFFFFF">colors/white.png</texture></control>
				<control type="image"><left>202</left><top>690</top><width>2</width><height>12</height><texture colordiffuse="50FFFFFF">colors/white.png</texture></control>
				<control type="image"><left>238</left><top>690</top><width>2</width><height>12</height><texture colordiffuse="50FFFFFF">colors/white.png</texture></control>
				<control type="image"><left>256</left><top>690</top><width>2</width><height>12</height><texture colordiffuse="50FFFFFF">colors/white.png</texture></control>
				<control type="image"><left>274</left><top>690</top><width>2</width><height>12</height><texture colordiffuse="50FFFFFF">colors/white.png</texture></control>
				<control type="image"><left>292</left><top>690</top><width>2</width><height>12</height><texture colordiffuse="50FFFFFF">colors/white.png</texture></control>
				<control type="image"><left>310</left><top>690</top><width>2</width><height>12</height><texture colordiffuse="50FFFFFF">colors/white.png</texture></control>
				<control type="image"><left>328</left><top>690</top><width>2</width><height>12</height><texture colordiffuse="50FFFFFF">colors/white.png</texture></control>
				<control type="label">
					<left>0</left>
					<top>714</top>
					<width>440</width>
					<height>30</height>
					<font>font22</font>
					<textcolor>text_secondary</textcolor>
					<align>center</align>
					<aligny>center</aligny>
					<label>$INFO[Container(51).CurrentItem] / $INFO[Container(51).NumItems]</label>
				</control>
			</control>
		</definition>
	</include>

	<!-- Existing Nara hero data and media flags are retained, but reflowed into
	     the narrower detail column used by Cover Deck. -->
	<include name="NaraPosterDeckHero">
		<control type="group">
			<!-- Keep the synopsis anchored; TV-show header rows move up just enough to
			     make room for S01E01 technical data with the movie row spacing intact. -->
			<control type="group">
				<animation effect="slide" start="0,-11" end="0,-11" condition="String.IsEqual(Container(51).ListItem.DBType,tvshow)">Conditional</animation>
				<animation effect="slide" start="0,38" end="0,38" condition="String.IsEqual(Container(51).ListItem.DBType,movie) + String.IsEmpty(Container(51).ListItem.Tagline)">Conditional</animation>
				<control type="image">
					<top>5</top>
					<width>660</width>
					<height>170</height>
					<aspectratio align="left" aligny="center">keep</aspectratio>
					<fadetime>180</fadetime>
					<texture background="true">$VAR[NaraPosterHeroClearLogoVar]</texture>
					<visible>!String.IsEmpty(Container(51).ListItem.Art(clearlogo)) | !String.IsEmpty(Container(51).ListItem.Art(tvshow.clearlogo))</visible>
				</control>
				<control type="label">
					<top>10</top>
					<width>700</width>
					<height>160</height>
					<font>font60</font>
					<aligny>center</aligny>
					<scroll>true</scroll>
					<label>$VAR[NaraPosterHeroTitleVar]</label>
					<visible>String.IsEmpty(Container(51).ListItem.Art(clearlogo)) + String.IsEmpty(Container(51).ListItem.Art(tvshow.clearlogo))</visible>
				</control>
				<control type="label">
					<top>180</top>
					<width>690</width>
					<height>34</height>
					<font>font25</font>
					<textcolor>text_secondary</textcolor>
					<scroll>true</scroll>
					<label>$VAR[NaraPosterHeroEpisodeLabelVar]</label>
					<visible>String.IsEqual(Container(51).ListItem.DBType,season)</visible>
				</control>
				<!-- 不要用 scroll：文字超宽时 Kodi 会把同一段画两份做循环，
				     滚到中段时尾部和开头挤在一起，看起来像两行字重叠。 -->
				<control type="label">
					<top>220</top>
					<width>900</width>
					<height>38</height>
					<font>font13</font>
					<textcolor>text_secondary</textcolor>
					<label>$VAR[NaraPosterHeroMetadataVar]</label>
					<animation effect="slide" start="0,32" end="0,32" condition="String.IsEqual(Container(51).ListItem.DBType,season)">Conditional</animation>
				</control>
			</control>
			<control type="label">
				<top>262</top>
				<width>900</width>
				<height>38</height>
				<font>font25</font>
				<textcolor>text_secondary</textcolor>
				<label>[I]$INFO[Container(51).ListItem.Tagline][/I]</label>
				<visible>!String.IsEqual(Container(51).ListItem.DBType,tvshow) + !String.IsEmpty(Container(51).ListItem.Tagline)</visible>
				<animation effect="slide" start="0,32" end="0,32" condition="String.IsEqual(Container(51).ListItem.DBType,season)">Conditional</animation>
			</control>
			<control type="textbox">
				<left>2</left>
				<top>324</top>
				<width>690</width>
				<height>134</height>
				<font>font13</font>
				<textcolor>text_secondary</textcolor>
				<label fallback="19055">$VAR[NaraPosterHeroSynopsisVar]</label>
				<animation effect="slide" start="0,-57" end="0,-57" condition="String.IsEqual(Container(51).ListItem.DBType,tvshow)">Conditional</animation>
				<animation effect="slide" start="0,-64" end="0,-64" condition="String.IsEqual(Container(51).ListItem.DBType,season)">Conditional</animation>
			</control>
			<!-- 评分 + 技术标识同一行，放在简介下方。
			     位移必须和上面的简介框一致（tvshow -57 / season -64），否则间距会撑大。 -->
			<control type="group">
				<top>482</top>
				<width>725</width>
				<height>36</height>
				<animation effect="slide" start="0,-57" end="0,-57" condition="String.IsEqual(Container(51).ListItem.DBType,tvshow)">Conditional</animation>
				<animation effect="slide" start="0,-64" end="0,-64" condition="String.IsEqual(Container(51).ListItem.DBType,season)">Conditional</animation>
				<include content="NaraOnlineRatingsRow">
					<param name="item_prefix" value="Container(51).ListItem" />
					<param name="width" value="725" />
					<param name="inline_flags" value="true" />
					<param name="technical_item_prefix" value="Container(51).ListItem" />
				</include>
			</control>
		</control>
	</include>

	<include name="View_51_Poster">
		<control type="group">
			<left>-10</left>
			<visible>Control.IsVisible(51) + [Container.Content(movies) | Container.Content(seasons) | Container.Content(sets) | Container.Content(tvshows) | $EXP[videoasset_true]]</visible>
			<animation effect="fade" start="0" end="100" time="260">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="180">WindowClose</animation>
			<animation effect="fade" time="220">VisibleChange</animation>

			<!-- 通用版：slotlist 为魔改控件，降级为 fixedlist -->
			<control type="fixedlist" id="51">
				<width>1160</width>
				<height>1080</height>
				<focusposition>2</focusposition>
				<movement>0</movement>
				<orientation>horizontal</orientation>
				<pagecontrol>5198</pagecontrol>
				<scrolltime tween="sine" easing="inout">500</scrolltime>
				<preloaditems>2</preloaditems>
				<onleft condition="$EXP[nara_tv_hierarchy_sidebar_locked]">51</onleft>
				<onleft condition="!$EXP[nara_tv_hierarchy_sidebar_locked]">9000</onleft>
				<onright>51</onright>
				<!-- 季标签必须是“第1季、第2季…”的升序；原生季列表可能被排成倒序。
				     只在排序不对时修正，避免每次聚焦都重载容器。 -->
				<onfocus condition="Container.Content(seasons) + !Container.SortMethod(24)">Container.SetSortMethod(24)</onfocus>
				<onfocus condition="Container.Content(seasons) + Container.SortDirection(descending)">Container.SetSortDirection</onfocus>
				<!-- 季页：上到播放键，下到本季集卡片；其他内容沿用原导航。 -->
				<onup condition="Container.Content(seasons)">5110</onup>
				<onup condition="$EXP[nara_tv_hierarchy_sidebar_locked]">51</onup>
				<onup condition="!$EXP[nara_tv_hierarchy_sidebar_locked]">9000</onup>
				<ondown condition="Container.Content(seasons)">5101</ondown>
				<ondown>5198</ondown>
				<visible>Container.Content(movies) | Container.Content(seasons) | Container.Content(sets) | Container.Content(tvshows) | $EXP[videoasset_true]</visible>
				<viewtype label="20021">icon</viewtype>
				<itemlayout width="420" height="630" condition="!Container.Content(seasons)">
					<!-- 季列表一次只显示聚焦卡片：未聚焦槽位不画 -->
					<include content="NaraPosterDeckCard">
						<param name="deck_on" value="false" />
					</include>
				</itemlayout>
				<focusedlayout width="420" height="630" condition="!Container.Content(seasons)">
					<include content="NaraPosterDeckCard" />
				</focusedlayout>
				<!-- 季内容改由图 1 版式承载：这里只保留一个透明焦点槽位，
				     可见的季标签由 View_51_Seasons 的 grouplist 绘制。 -->
				<itemlayout width="250" height="58" condition="Container.Content(seasons)">
					<control type="label">
						<width>250</width>
						<height>52</height>
						<textcolor>00FFFFFF</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</itemlayout>
				<focusedlayout width="250" height="58" condition="Container.Content(seasons)">
					<control type="label">
						<width>250</width>
						<height>52</height>
						<textcolor>00FFFFFF</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</focusedlayout>
			</control>


			<!-- 刻度与页码已经画进卡片坐标系（见 NaraPosterDeckCard），
			     这里只剩一个透明的 scrollbar，供 <pagecontrol>5198</pagecontrol> 用。 -->
			<control type="group">
				<left>400</left>
				<top>910</top>
				<width>360</width>
				<height>70</height>
				<visible>!Container.Content(seasons)</visible>
				<animation effect="fade" start="0" end="100" delay="160" time="220">WindowOpen</animation>
				<!-- 滚动条只保留分页导航能力，滑块做成透明（白色竖条会被误读成居中标记） -->
				<control type="scrollbar" id="5198">
					<left>72</left>
					<top>1</top>
					<width>218</width>
					<height>27</height>
					<orientation>horizontal</orientation>
					<showonepage>true</showonepage>
					<texturesliderbackground colordiffuse="00FFFFFF">colors/white.png</texturesliderbackground>
					<texturesliderbar colordiffuse="00FFFFFF">colors/white.png</texturesliderbar>
					<texturesliderbarfocus colordiffuse="00FFFFFF">colors/white.png</texturesliderbarfocus>
					<textureslidernib colordiffuse="00FFFFFF">overlays/deck-scroll-nib.png</textureslidernib>
					<textureslidernibfocus colordiffuse="00FFFFFF">overlays/deck-scroll-nib.png</textureslidernibfocus>
					<onup>51</onup>
					<ondown>51</ondown>
				</control>
			</control>

			<control type="group">
				<left>1155</left>
				<top>260</top>
				<width>725</width>
				<height>620</height>
				<visible>!Container.Content(seasons)</visible>
				<animation effect="slide" start="55,0" end="0,0" time="360" tween="cubic" easing="out">WindowOpen</animation>
				<include>NaraPosterDeckHero</include>
			</control>
		</control>
	</include>

	<!-- 季标签：容器 51 自己承接焦点，grouplist 只负责可见标签；
	     和详情页 5100 的方案一致，最多同时显示 7 个季。 -->
	<include name="View51SeasonTabVisualItem">
		<definition>
			<control type="button">
				<width max="220">auto</width>
				<height>52</height>
				<font>font13</font>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<textcolor>text_secondary</textcolor>
				<focusedcolor>text_secondary</focusedcolor>
				<label>$INFO[Container(51).ListItemPosition($PARAM[position]).Label]</label>
				<texturefocus />
				<texturenofocus />
				<hitrect x="0" y="0" w="0" h="0" />
				<visible>!String.IsEmpty(Container(51).ListItemPosition($PARAM[position]).Label) + !Container(51).Position($PARAM[position])</visible>
			</control>
			<control type="button">
				<width max="220">auto</width>
				<height>52</height>
				<font>font13</font>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<textcolor>text_primary</textcolor>
				<focusedcolor>text_primary</focusedcolor>
				<label>$INFO[Container(51).ListItemPosition($PARAM[position]).Label]</label>
				<texturefocus border="0,0,0,3" infill="false" colordiffuse="80FFFFFF">colors/white.png</texturefocus>
				<texturenofocus border="0,0,0,3" infill="false" colordiffuse="80FFFFFF">colors/white.png</texturenofocus>
				<hitrect x="0" y="0" w="0" h="0" />
				<visible>Container(51).Position($PARAM[position]) + !Control.HasFocus(51)</visible>
			</control>
			<control type="button">
				<width max="220">auto</width>
				<height>52</height>
				<font>font13</font>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<textcolor>text_primary</textcolor>
				<focusedcolor>text_primary</focusedcolor>
				<label>$INFO[Container(51).ListItemPosition($PARAM[position]).Label]</label>
				<texturefocus border="0,0,0,3" infill="false" colordiffuse="focus_media">colors/white.png</texturefocus>
				<texturenofocus border="0,0,0,3" infill="false" colordiffuse="focus_media">colors/white.png</texturenofocus>
				<hitrect x="0" y="0" w="0" h="0" />
				<visible>Container(51).Position($PARAM[position]) + Control.HasFocus(51)</visible>
			</control>
		</definition>
	</include>

	<!-- 季页：点电视剧后进入的那一页，版式取自 12003 剧集详情页。
	     电影/剧/合集仍走上面的封面 deck，本组只在 Container.Content(seasons) 时出现。 -->
	<include name="View_51_Seasons">
		<control type="group">
			<visible>Control.IsVisible(51) + Container.Content(seasons)</visible>
			<animation effect="fade" time="220">VisibleChange</animation>

			<!-- 季页背景与详情页完全同一套参数：
			     primary 兜底 → fanart（右对齐 scale）→ fanart-stage-mask 暗角
			     → detail-left-scrim 左侧阅读压暗 → opacity_medium 底部渐变。
			     View_51 原来的 deck 背景已在季内容时关闭，避免叠两层不同参数。 -->
			<control type="image">
				<left>-120</left>
				<top>-80</top>
				<right>-120</right>
				<bottom>-80</bottom>
				<aspectratio>scale</aspectratio>
				<texture colordiffuse="primary_background_info">special://skin/extras/backgrounds/primary.jpg</texture>
				<visible>Skin.HasSetting(no_fanart)</visible>
			</control>
			<control type="image">
				<left>-120</left>
				<top>-80</top>
				<right>-120</right>
				<bottom>-80</bottom>
				<aspectratio>scale</aspectratio>
				<texture colordiffuse="primary_dim">special://skin/extras/backgrounds/primary.jpg</texture>
