			<control type="image">
				<include>FullScreenDimensions</include>
				<aspectratio scalediffuse="false">scale</aspectratio>
				<fadetime>250</fadetime>
				<texture background="true" diffuse="overlays/flixart-edge-glow.png">$INFO[Window(home).Property(Mistuary.FanartGlow)]</texture>
				<visible>!Skin.HasSetting(no_fanart) + !String.IsEmpty(Container(51).ListItem.Art(fanart)) + !String.IsEmpty(Window(home).Property(Mistuary.FanartGlow))</visible>
			</control>
			<control type="image">
