				<top>-80</top>
				<right>-120</right>
				<bottom>-80</bottom>
				<aspectratio>scale</aspectratio>
				<texture colordiffuse="fanart_void">colors/black.png</texture>
				<visible>!Skin.HasSetting(no_fanart) + !String.IsEmpty(Container(51).ListItem.Art(fanart))</visible>
			</control>
			<!-- 流光溢彩色光底：与 Home / 详情页共用同一属性；季页是 Home 窗口里的 view，
			     所以隐藏 label 用 9097，不能和 Home.xml 的 9099 撞 id。 -->
			<control type="image">
				<include>FullScreenDimensions</include>
				<aspectratio>scale</aspectratio>
				<fadetime>250</fadetime>
				<texture background="true">$INFO[Window(home).Property(Mistuary.FanartGlow)]</texture>
				<visible>!Skin.HasSetting(no_fanart) + !String.IsEmpty(Container(51).ListItem.Art(fanart)) + !String.IsEmpty(Window(home).Property(Mistuary.FanartGlow))</visible>
			</control>
			<control type="label" id="9097">
				<left>-10</left>
				<top>-10</top>
				<width>1</width>
				<height>1</height>
				<textcolor>00FFFFFF</textcolor>
				<label>$INFO[Container(51).ListItem.Art(fanart)]</label>
			</control>
			<control type="image">
				<left>33.33%</left>
				<top>0</top>
				<width>66.67%</width>
				<height>100%</height>
				<aspectratio align="right" aligny="top">keep</aspectratio>
				<fadetime>250</fadetime>
				<texture background="true">$INFO[Container(51).ListItem.Art(fanart)]</texture>
				<visible>!Skin.HasSetting(no_fanart) + !String.IsEmpty(Container(51).ListItem.Art(fanart))</visible>
			</control>
			<!-- 黑色渐隐常驻，不再吃色光属性：色光 jpg 是后台异步加载的，打开详情页 /
			     换剧照那几帧纹理还没到位，若这层跟着隐藏，清晰图左缘会裸出一条硬切线
			     （实机反馈的「一闪」）。有色光时它只负责遮边，色光层叠在它上面负责加色。 -->
			<control type="image">
				<left>33.33%</left>
				<top>0</top>
				<width>20%</width>
				<height>100%</height>
				<aspectratio>stretch</aspectratio>
				<texture>overlays/flixart-shade.png</texture>
				<visible>!Skin.HasSetting(no_fanart) + !String.IsEmpty(Container(51).ListItem.Art(fanart))</visible>
			</control>
			<!-- 色光过渡：对齐 fuse3 的 diffuse，与 Home / DialogVideoInfo 同一套。
