<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<onload condition="!ListItem.Property(addon.isinstalled) + Window.IsActive(addonbrowser)">SetFocus(6)</onload>
	<onload>SetProperty(infobackground,$ESCINFO[ListItem.Art(fanart)],home)</onload>
	<onunload>ClearProperty(infobackground,home)</onunload>
	<depth>DepthDialog</depth>
	<controls>
		<control type="group">
			<width>1920</width>
			<height>1080</height>
			<animation effect="fade" start="0" end="100" time="220">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="180">WindowClose</animation>
			<!-- 通用版：背景现在是随机 fanart，40% 遮罩 + 50% 面板会透出太多，
			     遮罩加到 70%，面板保持玻璃质感 -->
			<!-- 全屏遮罩：用 FullScreenDimensions 而不是写死 1920，
			     否则 17:9 等宽屏分辨率下右侧会漏出一条没压暗的边 -->
			<control type="image">
				<include>FullScreenDimensions</include>
				<texture colordiffuse="B3000000">colors/black.png</texture>
			</control>
			<!-- 通用版：grouplist 无 texturebackground，改为独立背景层 -->
			<control type="image">
				<left>240</left>
				<top>140</top>
				<width>1440</width>
				<height>800</height>
				<texture colordiffuse="$VAR[GlassTint_dialog_strong]" border="32">shapes/round32.png</texture>
			</control>
			<control type="grouplist" id="9001">
				<left>240</left>
				<top>140</top>
				<width>1440</width>
				<height>800</height>
				<orientation>vertical</orientation>
				<align>center</align>
				<itemgap>0</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
				<control type="group">
					<width>1440</width>
					<height>168</height>
					<control type="image">
						<left>40</left>
						<top>24</top>
						<width>128</width>
						<height>128</height>
						<texture background="true" fallback="DefaultAddon.png">$INFO[ListItem.Art(thumb)]</texture>
						<aspectratio>keep</aspectratio>
						<fadetime>200</fadetime>
					</control>
					<control type="label">
						<left>1040</left>
						<top>20</top>
						<width>360</width>
						<height>28</height>
						<font>font12</font>
						<align>right</align>
						<textcolor>text_secondary</textcolor>
						<label>$INFO[ListItem.AddonType]</label>
						<scroll>true</scroll>
					</control>
					<control type="label">
						<left>208</left>
						<top>20</top>
						<width>800</width>
						<height>56</height>
						<font>font40_title</font>
						<textcolor>text_primary</textcolor>
						<label>$INFO[ListItem.AddonName]</label>
						<scroll>true</scroll>
					</control>
					<control type="label">
						<left>208</left>
						<top>80</top>
						<width>1192</width>
						<height>32</height>
						<font>font26</font>
						<textcolor>text_secondary</textcolor>
						<label>$VAR[NaraAddonInfoIdentityVar]</label>
						<scroll>true</scroll>
					</control>
					<control type="grouplist">
						<left>208</left>
						<top>120</top>
						<width>1192</width>
						<height>32</height>
						<orientation>horizontal</orientation>
						<itemgap>24</itemgap>
						<visible>!String.IsEmpty(ListItem.AddonOrigin) | !String.IsEmpty(ListItem.Property(Addon.Status)) | !String.IsEmpty(ListItem.Property(Addon.ValidUpdateVersion)) | !String.IsEmpty(ListItem.AddonSize) | ListItem.Property(Addon.IsBinary)</visible>
						<control type="label">
							<width min="1" max="360">auto</width>
							<height>32</height>
							<font>font12</font>
							<textcolor>text_secondary</textcolor>
							<label>$INFO[ListItem.AddonOrigin]</label>
							<scroll>true</scroll>
							<visible>!String.IsEmpty(ListItem.AddonOrigin)</visible>
						</control>
						<control type="label">
							<width min="1" max="360">auto</width>
							<height>32</height>
							<font>font12</font>
							<textcolor>text_secondary</textcolor>
							<label>$VAR[NaraAddonInfoStatusVar]</label>
							<scroll>true</scroll>
							<visible>!String.IsEmpty(ListItem.Property(Addon.Status)) | !String.IsEmpty(ListItem.Property(Addon.ValidUpdateVersion))</visible>
						</control>
						<control type="label">
							<width min="1" max="180">auto</width>
							<height>32</height>
							<font>font12</font>
							<textcolor>text_secondary</textcolor>
							<label>$INFO[ListItem.AddonSize]</label>
							<scroll>true</scroll>
							<visible>!String.IsEmpty(ListItem.AddonSize)</visible>
						</control>
						<control type="label">
							<width min="1" max="120">auto</width>
							<height>32</height>
							<font>font12</font>
							<textcolor>text_secondary</textcolor>
							<label>$LOCALIZE[31135]</label>
							<scroll>true</scroll>
							<visible>ListItem.Property(Addon.IsBinary)</visible>
						</control>
					</control>
				</control>
				<control type="group">
					<width>1440</width>
					<height>344</height>
					<visible>Integer.IsGreater(Container(50).NumItems,0)</visible>
					<include content="NaraAddonInfoDescription">
						<param name="id" value="61" />
						<param name="scrollbar" value="60" />
						<param name="left" value="40" />
						<param name="top" value="16" />
						<param name="width" value="624" />
						<param name="height" value="304" />
					</include>
					<include content="NaraAddonInfoDescriptionScrollbar">
						<param name="id" value="60" />
						<param name="textbox" value="61" />
						<param name="left" value="680" />
						<param name="top" value="16" />
						<param name="height" value="304" />
						<param name="visible" value="Integer.IsGreater(Container(50).NumItems,0)" />
					</include>
					<control type="panel" id="50">
						<left>728</left>
						<top>8</top>
						<width>672</width>
						<height>328</height>
						<orientation>horizontal</orientation>
						<enable>false</enable>
						<preloaditems>0</preloaditems>
						<itemlayout width="672" height="328">
							<control type="image">
								<left>0</left>
								<top>0</top>
								<width>672</width>
								<height>328</height>
								<texture colordiffuse="66000000" border="24">shapes/round24.png</texture>
							</control>
							<control type="image">
								<left>8</left>
								<top>8</top>
								<width>656</width>
								<height>312</height>
								<texture background="true">$INFO[ListItem.Art(thumb)]</texture>
								<aspectratio>keep</aspectratio>
								<fadetime>200</fadetime>
							</control>
						</itemlayout>
						<focusedlayout width="672" height="328">
							<control type="image">
								<left>0</left>
								<top>0</top>
								<width>672</width>
								<height>328</height>
								<texture colordiffuse="66000000" border="24">shapes/round24.png</texture>
							</control>
							<control type="image">
								<left>8</left>
								<top>8</top>
								<width>656</width>
								<height>312</height>
								<texture background="true">$INFO[ListItem.Art(thumb)]</texture>
								<aspectratio>keep</aspectratio>
								<fadetime>200</fadetime>
							</control>
						</focusedlayout>
					</control>
				</control>
				<control type="group">
					<width>1440</width>
					<height>200</height>
					<visible>Integer.IsEqual(Container(50).NumItems,0)</visible>
					<include content="NaraAddonInfoDescription">
						<param name="id" value="62" />
						<param name="scrollbar" value="63" />
					</include>
					<include content="NaraAddonInfoDescriptionScrollbar">
						<param name="id" value="63" />
						<param name="textbox" value="62" />
						<param name="visible" value="Integer.IsEqual(Container(50).NumItems,0)" />
					</include>
				</control>
				<control type="textbox">
					<left>40</left>
					<top>0</top>
					<width>1360</width>
					<height>56</height>
					<font>font12</font>
					<textcolor>text_muted</textcolor>
					<label>$VAR[NaraAddonInfoNoticeVar]</label>
					<visible>!String.IsEmpty(ListItem.AddonDisclaimer) | String.IsEqual(ListItem.AddonLifecycleType,$LOCALIZE[24170]) | String.IsEqual(ListItem.AddonLifecycleType,$LOCALIZE[24171])</visible>
					<autoscroll delay="5000" repeat="7500" time="5000">true</autoscroll>
				</control>
				<control type="group">
					<width>1440</width>
					<height>28</height>
					<control type="image">
						<left>40</left>
						<top>14</top>
						<width>1360</width>
						<height>1</height>
						<texture colordiffuse="border_subtle">colors/white.png</texture>
					</control>
				</control>
				<control type="group">
					<width>1440</width>
					<height>120</height>
					<control type="grouplist" id="9000">
						<left>40</left>
						<top>0</top>
						<width>1360</width>
						<height>120</height>
						<orientation>horizontal</orientation>
						<align>center</align>
						<itemgap>8</itemgap>
						<onleft>9000</onleft>
						<onright>9000</onright>
						<onup condition="Control.IsVisible(60)">60</onup>
						<onup condition="Control.IsVisible(63)">63</onup>
						<onup condition="!Control.IsVisible(60) + !Control.IsVisible(63)">9000</onup>
						<ondown>9000</ondown>
						<include content="NaraAddonInfoAction">
							<param name="id" value="12" />
							<param name="label" value="$LOCALIZE[518]" />
							<param name="icon_off" value="icons/infodialogs/launch.png" />
							<param name="icon_on" value="icons/infodialogs/launch.png" />
							<param name="selected" value="false" />
						</include>
						<include content="NaraAddonInfoAction">
							<param name="id" value="9" />
							<param name="label" value="$LOCALIZE[24020]" />
							<param name="icon_off" value="icons/infodialogs/configure.png" />
							<param name="icon_on" value="icons/infodialogs/configure.png" />
							<param name="selected" value="false" />
						</include>
						<include content="NaraAddonInfoAction">
							<param name="id" value="8" />
							<param name="label" value="$LOCALIZE[24138]" />
							<param name="icon_off" value="icons/infodialogs/update.png" />
							<param name="icon_on" value="icons/infodialogs/update.png" />
							<param name="selected" value="false" />
						</include>
						<include content="NaraAddonInfoAction">
							<param name="id" value="14" />
							<param name="label" value="$LOCALIZE[24069]" />
							<param name="icon_off" value="icons/infodialogs/versions.png" />
							<param name="icon_on" value="icons/infodialogs/versions.png" />
							<param name="selected" value="false" />
						</include>
						<include content="NaraAddonInfoAction">
							<param name="id" value="7" />
							<param name="label" value="" />
							<param name="icon_off" value="icons/infodialogs/enabled.png" />
							<param name="icon_on" value="icons/infodialogs/disable.png" />
							<param name="selected" value="!String.StartsWith(Control.GetLabel(7),$LOCALIZE[24022]) | !Window.IsActive(addonbrowser)" />
						</include>
						<control type="radiobutton" id="13">
							<radioposx>35</radioposx>
							<radioposy>12</radioposy>
							<radiowidth>92</radiowidth>
							<radioheight>58</radioheight>
							<visible>Control.IsEnabled(13)</visible>
							<include>NaraAddonInfoActionStyle</include>
							<textureradioonfocus colordiffuse="text_primary">buttons/radio-button-on.png</textureradioonfocus>
							<textureradioofffocus colordiffuse="text_primary">buttons/radio-button-off.png</textureradioofffocus>
							<textureradioonnofocus colordiffuse="text_secondary">buttons/radio-button-on.png</textureradioonnofocus>
							<textureradiooffnofocus colordiffuse="text_secondary">buttons/radio-button-off.png</textureradiooffnofocus>
							<textureradioondisabled colordiffuse="text_disabled">buttons/radio-button-on.png</textureradioondisabled>
							<textureradiooffdisabled colordiffuse="text_disabled">buttons/radio-button-off.png</textureradiooffdisabled>
						</control>
						<include content="NaraAddonInfoAction">
							<param name="id" value="10" />
							<param name="label" value="$LOCALIZE[39024]" />
							<param name="icon_off" value="icons/infodialogs/info.png" />
							<param name="icon_on" value="icons/infodialogs/info.png" />
							<param name="selected" value="false" />
						</include>
						<control type="radiobutton" id="5000">
							<label>$LOCALIZE[31141]</label>
							<visible>!String.IsEmpty(ListItem.AddonNews)</visible>
							<enable>!String.IsEmpty(ListItem.AddonNews)</enable>
							<include>NaraAddonInfoActionStyle</include>
							<onclick>SetProperty(TextViewer_Header,$LOCALIZE[31141] $INFO[ListItem.AddonVersion],home)</onclick>
							<onclick>SetProperty(TextViewer_Text,$ESCINFO[ListItem.AddonNews],home)</onclick>
							<onclick>ActivateWindow(1102)</onclick>
							<radioposx>63</radioposx>
							<radioposy>24</radioposy>
							<radiowidth>36</radiowidth>
							<radioheight>36</radioheight>
							<selected>false</selected>
							<textureradioonfocus colordiffuse="text_primary">icons/infodialogs/play_record.png</textureradioonfocus>
							<textureradioofffocus colordiffuse="text_primary">icons/infodialogs/play_record.png</textureradioofffocus>
							<textureradioonnofocus colordiffuse="text_secondary">icons/infodialogs/play_record.png</textureradioonnofocus>
							<textureradiooffnofocus colordiffuse="text_secondary">icons/infodialogs/play_record.png</textureradiooffnofocus>
							<textureradioondisabled colordiffuse="text_disabled">icons/infodialogs/play_record.png</textureradioondisabled>
							<textureradiooffdisabled colordiffuse="text_disabled">icons/infodialogs/play_record.png</textureradiooffdisabled>
						</control>
						<include content="NaraAddonInfoAction">
							<param name="id" value="6" />
							<param name="label" value="" />
							<param name="icon_off" value="icons/infodialogs/install.png" />
							<param name="icon_on" value="icons/infodialogs/uninstall.png" />
							<param name="selected" value="ListItem.Property(addon.isinstalled) | !Window.IsActive(addonbrowser)" />
						</include>
					</control>
				</control>
				<control type="group">
					<width>1440</width>
					<height>28</height>
				</control>
			</control>
		</control>
	</controls>
</window>
