<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol>5</defaultcontrol>
	<controls>
		<!-- 插件设置叠在详情页 / 插件浏览器上，两层半透明会互相透成鬼影。
		     这里在窗口最底下铺一层不透明的随机剧照（与设置页 / 文件管理同一张、
		     同一个乘法压暗系数），把下层整个盖住；玻璃面板照旧跟弹窗透明度走，
		     透出来的是「一张图」，不是另一个窗口的行和文字。
		     原来铺的是 primary.jpg 兜底图，2026-11-05 改成真剧照。 -->
		<!-- 与设置页/文件管理同一张随机剧照：没有锁定图、首页也没有传递时，
		     在这里自取一张，避免从插件浏览器直接打开时只剩下层窗口。 -->
		<control type="list" id="16090">
			<left>-2</left>
			<top>-2</top>
			<width>1</width>
			<height>1</height>
			<itemlayout width="1" height="1" />
			<focusedlayout width="1" height="1" />
			<content sortby="random" sortorder="ascending" limit="1" target="videos" browse="never">videodb://movies/titles/</content>
			<visible>String.IsEmpty(Skin.String(Nara.SharedRandomFanart.LockedPath)) + String.IsEmpty(Window(home).Property(Home.SharedRandomFanart)) + String.IsEmpty(Window(home).Property(Home.SharedRandomFanart.SessionPath))</visible>
		</control>
		<control type="image">
			<include>FullScreenDimensions</include>
			<aspectratio align="right">scale</aspectratio>
			<texture background="true" colordiffuse="FFA8A8A8">$VAR[NaraFileManagerRandomFanartVar]</texture>
			<visible>$EXP[nara_page_shared_fanart_visible]</visible>
		</control>
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>1640</width>
			<height>890</height>
			<include content="NaraSettingsDialogFrame">
				<param name="tint" value="$VAR[NaraGlassFloatTintVar]" />
				<param name="width" value="1640" />
				<param name="height" value="890" />
				<param name="header_id" value="2" />
			</include>
			<control type="grouplist" id="3">
				<left>32</left>
				<top>115</top>
				<width>350</width>
				<height>580</height>
				<itemgap>4</itemgap>
				<onleft>9000</onleft>
				<onright>5</onright>
				<onup>20</onup>
				<ondown>20</ondown>
			</control>
			<control type="togglebutton" id="10">
				<textcolor>text_primary</textcolor>
				<include content="NaraSettingsCategoryButton">
					<param name="width" value="350" />
					<param name="focuscolor" value="glass_focus_medium" />
					<param name="selectedfocuscolor" value="glass_focus_medium" />
					<param name="text" value="text_primary" />
				</include>
			</control>
			<!-- 设置级别（基础 / 标准 / 高级 / 专家）：沉到窗口底部，
			     和右侧「确定 / 取消 / 默认」同一水平线（都在 top 797、h 65）。
			     textoffsetx 32 而不是 24：button 自身有 8px 内边距，实测 24 会让
			     文字比上面分类列表左 8px；补到 32 才和列表条目左边缘对齐。 -->
			<control type="button" id="20">
				<left>32</left>
				<top>797</top>
				<width>350</width>
				<height>65</height>
				<font>font26</font>
				<align>left</align>
				<textoffsetx>32</textoffsetx>
				<onclick>SettingsLevelChange</onclick>
				<onleft>5</onleft>
				<onright>9000</onright>
				<onup>3</onup>
				<ondown>3</ondown>
				<texturefocus colordiffuse="glass_focus_medium" border="14">shapes/round14.png</texturefocus>
				<texturenofocus />
				<focusedcolor>text_primary</focusedcolor>
				<textcolor>text_primary</textcolor>
				<selectedcolor>text_primary</selectedcolor>
			</control>
			<control type="image">
				<left>398</left>
				<top>120</top>
				<width>1</width>
				<height>625</height>
				<texture colordiffuse="25FFFFFF">colors/white.png</texture>
			</control>
			<control type="grouplist" id="5">
				<left>420</left>
				<top>110</top>
				<width>1170</width>
				<height>590</height>
				<itemgap>2</itemgap>
				<pagecontrol>60</pagecontrol>
				<onleft>3</onleft>
				<onright>60</onright>
				<onup>5</onup>
				<ondown>9000</ondown>
			</control>
			<control type="button" id="7">
				<textcolor>text_primary</textcolor>
				<include content="NaraSettingsRow">
					<param name="height" value="72" />
					<param name="focuscolor" value="glass_focus_medium" />
					<param name="text" value="text_primary" />
				</include>
			</control>
			<control type="radiobutton" id="8">
				<textcolor>text_primary</textcolor>
				<include content="NaraSettingsRow">
					<param name="height" value="72" />
					<param name="focuscolor" value="glass_focus_medium" />
					<param name="text" value="text_primary" />
				</include>
			</control>
			<control type="spincontrolex" id="9">
				<include content="NaraSettingsRow">
					<param name="height" value="72" />
					<param name="focuscolor" value="glass_focus_medium" />
					<param name="text" value="text_primary" />
				</include>
			</control>
			<control type="edit" id="12">
				<include content="NaraSettingsRow">
					<param name="height" value="72" />
					<param name="focuscolor" value="glass_focus_medium" />
					<param name="text" value="text_primary" />
				</include>
			</control>
			<control type="sliderex" id="13">
				<include content="NaraSettingsRow">
					<param name="height" value="72" />
					<param name="focuscolor" value="glass_focus_medium" />
					<param name="text" value="text_primary" />
				</include>
			</control>
			<control type="colorbutton" id="15">
				<include content="NaraSettingsRow">
					<param name="height" value="72" />
					<param name="focuscolor" value="glass_focus_medium" />
					<param name="text" value="text_primary" />
				</include>
			</control>
			<control type="image" id="11">
				<height>18</height>
				<texture />
			</control>
			<control type="label" id="14">
				<height>56</height>
				<font>font24</font>
				<textcolor>text_secondary</textcolor>
				<align>left</align>
				<aligny>center</aligny>
				<textoffsetx>28</textoffsetx>
			</control>
			<control type="scrollbar" id="60">
				<left>1602</left>
				<top>118</top>
				<width>6</width>
				<height>580</height>
				<orientation>vertical</orientation>
				<onleft>5</onleft>
				<onright>9000</onright>
			</control>
			<control type="textbox" id="6">
				<left>440</left>
				<top>708</top>
				<width>1130</width>
				<height>64</height>
				<font>font24</font>
				<textcolor>text_secondary</textcolor>
				<autoscroll time="3000" delay="5000" repeat="5000">true</autoscroll>
			</control>
			<control type="grouplist" id="9000">
				<left>420</left>
				<top>797</top>
				<width>1170</width>
				<height>65</height>
				<itemgap>16</itemgap>
				<orientation>horizontal</orientation>
				<align>right</align>
				<onup>5</onup>
				<onleft>5</onleft>
				<onright>3</onright>
				<include content="NaraSettingsActionButton">
					<param name="id" value="28" />
					<param name="focuscolor" value="glass_focus_medium" />
					<param name="text" value="text_primary" />
				</include>
				<include content="NaraSettingsActionButton">
					<param name="id" value="29" />
					<param name="focuscolor" value="glass_focus_medium" />
					<param name="text" value="text_primary" />
				</include>
				<include content="NaraSettingsActionButton">
					<param name="id" value="30" />
					<param name="focuscolor" value="glass_focus_medium" />
					<param name="text" value="text_primary" />
				</include>
			</control>
		</control>
	</controls>
	<include>Animation_DialogPopupOpenClose</include>
</window>
