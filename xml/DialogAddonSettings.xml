<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol>5</defaultcontrol>
	<controls>
		<!-- 从插件详情点「设置」时 Kodi 不会关掉详情页，两个对话框叠着：
		     详情页 71% 透 × 设置页 71% 透 = 详情页的标题 / 图标 / 按钮会变成鬼影
		     压在设置行上（2026-10-30）。
		     这里在窗口最底下铺一张和详情页同一张兜底背景
		     （extras/backgrounds/primary.jpg，1920×1080，详情页也用它），
		     把下层整个盖住 —— 设置面板照旧跟浮窗透明度走，
		     透过面板看到的是「一张图」，不是另一个对话框的内容。
		     只在详情页还开着时出现；从插件浏览器直接进设置时照旧看页面背景。 -->
		<control type="image">
			<visible>Window.IsVisible(10146)</visible>
			<include>FullScreenDimensions</include>
			<aspectratio>scale</aspectratio>
			<texture>special://skin/extras/backgrounds/primary.jpg</texture>
		</control>
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>1640</width>
			<height>890</height>
			<include content="NaraSettingsDialogFrame">
				<param name="tint" value="$VAR[NaraGlassFloatTintVar]" />
				<param name="width" value="1640" />
				<param name="height" value="890" />
				<param name="header_id" value="2" />
			</include>
			<control type="grouplist" id="3">
				<left>32</left>
				<top>115</top>
				<width>350</width>
				<height>580</height>
				<itemgap>4</itemgap>
				<onleft>9000</onleft>
				<onright>5</onright>
				<onup>20</onup>
				<ondown>20</ondown>
			</control>
			<control type="togglebutton" id="10">
				<textcolor>text_primary</textcolor>
				<include content="NaraSettingsCategoryButton">
					<param name="width" value="350" />
					<param name="focuscolor" value="glass_focus_medium" />
					<param name="selectedfocuscolor" value="glass_focus_medium" />
					<param name="text" value="text_primary" />
				</include>
			</control>
			<!-- 设置级别（基础 / 标准 / 高级 / 专家）：沉到窗口底部，
			     和右侧「确定 / 取消 / 默认」同一水平线（都在 top 797、h 65）。
			     文字左对齐 + textoffsetx 24，和上面分类列表的条目对齐
			     （NaraSettingsCategoryButton 也是 24）；居中会显得比列表右一截。 -->
			<control type="button" id="20">
				<left>32</left>
				<top>797</top>
				<width>350</width>
				<height>65</height>
				<font>font26</font>
				<align>left</align>
				<textoffsetx>24</textoffsetx>
				<onclick>SettingsLevelChange</onclick>
				<onleft>5</onleft>
				<onright>9000</onright>
				<onup>3</onup>
				<ondown>3</ondown>
				<texturefocus colordiffuse="glass_focus_medium" border="14">shapes/round14.png</texturefocus>
				<texturenofocus />
				<focusedcolor>text_primary</focusedcolor>
				<textcolor>text_primary</textcolor>
				<selectedcolor>text_primary</selectedcolor>
			</control>
			<control type="image">
				<left>398</left>
				<top>120</top>
				<width>1</width>
				<height>625</height>
				<texture colordiffuse="25FFFFFF">colors/white.png</texture>
			</control>
			<control type="grouplist" id="5">
				<left>420</left>
				<top>110</top>
				<width>1170</width>
				<height>590</height>
				<itemgap>2</itemgap>
				<pagecontrol>60</pagecontrol>
				<onleft>3</onleft>
				<onright>60</onright>
				<onup>5</onup>
				<ondown>9000</ondown>
			</control>
			<control type="button" id="7">
				<textcolor>text_primary</textcolor>
				<include content="NaraSettingsRow">
					<param name="height" value="72" />
					<param name="focuscolor" value="glass_focus_medium" />
					<param name="text" value="text_primary" />
				</include>
			</control>
			<control type="radiobutton" id="8">
				<textcolor>text_primary</textcolor>
				<include content="NaraSettingsRow">
					<param name="height" value="72" />
					<param name="focuscolor" value="glass_focus_medium" />
					<param name="text" value="text_primary" />
				</include>
			</control>
			<control type="spincontrolex" id="9">
				<include content="NaraSettingsRow">
					<param name="height" value="72" />
					<param name="focuscolor" value="glass_focus_medium" />
					<param name="text" value="text_primary" />
				</include>
			</control>
			<control type="edit" id="12">
				<include content="NaraSettingsRow">
					<param name="height" value="72" />
					<param name="focuscolor" value="glass_focus_medium" />
					<param name="text" value="text_primary" />
				</include>
			</control>
			<control type="sliderex" id="13">
				<include content="NaraSettingsRow">
					<param name="height" value="72" />
					<param name="focuscolor" value="glass_focus_medium" />
					<param name="text" value="text_primary" />
				</include>
			</control>
			<control type="colorbutton" id="15">
				<include content="NaraSettingsRow">
					<param name="height" value="72" />
					<param name="focuscolor" value="glass_focus_medium" />
					<param name="text" value="text_primary" />
				</include>
			</control>
			<control type="image" id="11">
				<height>18</height>
				<texture />
			</control>
			<control type="label" id="14">
				<height>56</height>
				<font>font24</font>
				<textcolor>text_secondary</textcolor>
				<align>left</align>
				<aligny>center</aligny>
				<textoffsetx>28</textoffsetx>
			</control>
			<control type="scrollbar" id="60">
				<left>1602</left>
				<top>118</top>
				<width>6</width>
				<height>580</height>
				<orientation>vertical</orientation>
				<onleft>5</onleft>
				<onright>9000</onright>
			</control>
			<control type="textbox" id="6">
				<left>440</left>
				<top>708</top>
				<width>1130</width>
				<height>64</height>
				<font>font24</font>
				<textcolor>text_secondary</textcolor>
				<autoscroll time="3000" delay="5000" repeat="5000">true</autoscroll>
			</control>
			<control type="grouplist" id="9000">
				<left>420</left>
				<top>797</top>
				<width>1170</width>
				<height>65</height>
				<itemgap>16</itemgap>
				<orientation>horizontal</orientation>
				<align>right</align>
				<onup>5</onup>
				<onleft>5</onleft>
				<onright>3</onright>
				<include content="NaraSettingsActionButton">
					<param name="id" value="28" />
					<param name="focuscolor" value="glass_focus_medium" />
					<param name="text" value="text_primary" />
				</include>
				<include content="NaraSettingsActionButton">
					<param name="id" value="29" />
					<param name="focuscolor" value="glass_focus_medium" />
					<param name="text" value="text_primary" />
				</include>
				<include content="NaraSettingsActionButton">
					<param name="id" value="30" />
					<param name="focuscolor" value="glass_focus_medium" />
					<param name="text" value="text_primary" />
				</include>
			</control>
		</control>
	</controls>
	<include>Animation_DialogPopupOpenClose</include>
</window>
