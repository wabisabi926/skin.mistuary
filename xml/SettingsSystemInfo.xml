<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">95</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<controls>
		<include>NaraSettingsBackground</include>
		<!-- 内容面板：这三页原本没有自己的底板，文字直接压在背景图上；
		     补一块和文件管理器同款的磨砂玻璃，文字仍是白色 -->
		<control type="image">
			<left>505</left>
			<top>145</top>
			<width>1355</width>
			<height>740</height>
			<texture colordiffuse="$VAR[NaraGlassPageTintVar]" border="20">shapes/glass20.png</texture>
		</control>
		<control type="group">
			<left>0</left>
			<top>0</top>
			<include>OpenClose_Right</include>
			<control type="grouplist">
				<!-- 纯 label 页没有 NaraSettingsRow，容器直接放 553 / 1259（不用减 28） -->
				<left>553</left>
				<top>193</top>
				<width>1259</width>
				<height>644</height>
				<orientation>vertical</orientation>
				<control type="label" id="2">
					<height>47</height>
					<width>1259</width>
					<font>Mono26</font>
				</control>
				<control type="label" id="3">
					<height>47</height>
					<width>1259</width>
					<font>Mono26</font>
				</control>
				<control type="label" id="4">
					<height>47</height>
					<width>1259</width>
					<font>Mono26</font>
				</control>
				<!-- id 5 在「摘要」是操作系统，在「网络」是子网掩码、在「存储」是第 4 个磁盘 ——
				     这 12 个 label 所有分区共用，Kodi 按 id 顺序填，所以只能按分区隐藏，不能删。
				     摘要在 id 5 那格是「操作系统」，Linux 上会连带塞进内核版本 / Build / 编译时间，
				     跟下面「版本信息」块重复；电池那格（id 8）在电视盒子上也没有意义。 -->
				<control type="label" id="5">
					<height>47</height>
					<width>1259</width>
					<font>Mono26</font>
					<visible>!Control.HasFocus(95)</visible>
				</control>
				<control type="label" id="6">
					<height>47</height>
					<width>1259</width>
					<font>Mono26</font>
				</control>
				<control type="label" id="7">
					<height>47</height>
					<width>1259</width>
					<font>Mono26</font>
				</control>
				<control type="label" id="8">
					<height>47</height>
					<width>1259</width>
					<font>Mono26</font>
					<visible>!Control.HasFocus(95)</visible>
				</control>
				<control type="label" id="9">
					<height>47</height>
					<width>1259</width>
					<font>Mono26</font>
				</control>
				<control type="label" id="10">
					<height>47</height>
					<width>1259</width>
					<font>Mono26</font>
				</control>
				<control type="label" id="11">
					<height>47</height>
					<width>1259</width>
					<font>Mono26</font>
				</control>
				<control type="label" id="12">
					<height>47</height>
					<width>1259</width>
					<font>Mono26</font>
				</control>
				<control type="label" id="13">
					<height>47</height>
					<width>1259</width>
					<font>Mono26</font>
				</control>
			</control>
			<control type="textbox" id="30">
				<left>553</left>
				<top>193</top>
				<width>1259</width>
				<bottom>530</bottom>
				<pagecontrol>60</pagecontrol>
				<autoscroll delay="5000" repeat="7500" time="5000">!Control.HasFocus(60)</autoscroll>
			</control>
			<!-- 轨道只跟「捐赠页」那个 textbox（id=30，193→550，高 357）同高。
			     写 644 会让滑块比例偏小：内容只有 357 高，滑块却按 644 算。 -->
			<control type="scrollbar" id="60">
				<left>1874</left>
				<top>193</top>
				<width>8</width>
				<height>357</height>
				<orientation>vertical</orientation>
				<texturesliderbackground />
				<animation effect="slide" end="6,0" time="300" tween="sine" easing="inout" condition="!Control.HasFocus(60)">conditional</animation>
				<onleft>9000</onleft>
				<onright>9000</onright>
				<visible>Control.IsVisible(30)</visible>
				<animation effect="fade" start="0" end="100" time="200" delay="300">Visible</animation>
				<animation effect="fade" start="100" end="0" time="200">Hidden</animation>
				<animation effect="fade" start="0" end="100" delay="300" time="320">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="150">WindowClose</animation>
			</control>
			<control type="group" id="102">
				<description>System Info page that shows a QR code linking to https://kodi.tv/donate/</description>
				<left>553</left>
				<width>1259</width>
				<top>193</top>
				<bottom>243</bottom>
				<control type="textbox">
					<height>110</height>
					<label>$LOCALIZE[12397]</label>
				</control>
				<control type="multiimage" id="103">
					<top>110</top>
					<height>372</height>
					<imagepath>special://xbmc/media/qr/kodilove/</imagepath>
					<aspectratio>keep</aspectratio>
					<timeperimage>5000</timeperimage>
					<fadetime>1000</fadetime>
					<randomize>false</randomize>
				</control>
				<control type="label">
					<top>505</top>
					<align>center</align>
					<label>$LOCALIZE[12398]</label>
				</control>
			</control>
		</control>
		<control type="group">
			<left>0</left>
			<top>0</top>
			<depth>DepthContentPanel</depth>
			<include>OpenClose_Left</include>
			<include>NaraSettingsSidebar</include>
			<control type="grouplist" id="9000">
				<onup>9000</onup>
				<ondown>9000</ondown>
				<onright>60</onright>
				<itemgap>4</itemgap>
				<control type="button" id="95">
					<description>Button Summary Values</description>
					<include content="NaraSettingsRow">
						<param name="height" value="78" />
						<param name="textoffsetx" value="24" />
						<param name="text" value="text_primary" />
					</include>
					<label>$LOCALIZE[20037]</label>
					<width>368</width>
				</control>
				<control type="button" id="94">
					<description>Button Storage</description>
					<include content="NaraSettingsRow">
						<param name="height" value="78" />
						<param name="textoffsetx" value="24" />
						<param name="text" value="text_primary" />
					</include>
					<label>$LOCALIZE[13277]</label>
					<width>368</width>
				</control>
				<control type="button" id="96">
					<description>Button Network</description>
					<include content="NaraSettingsRow">
						<param name="height" value="78" />
						<param name="textoffsetx" value="24" />
						<param name="text" value="text_primary" />
					</include>
					<label>$LOCALIZE[13279]</label>
					<width>368</width>
				</control>
				<control type="button" id="97">
					<description>Button Video</description>
					<include content="NaraSettingsRow">
						<param name="height" value="78" />
						<param name="textoffsetx" value="24" />
						<param name="text" value="text_primary" />
					</include>
					<label>$LOCALIZE[13280]</label>
					<width>368</width>
				</control>
				<control type="button" id="98">
					<description>Button Hardware</description>
					<include content="NaraSettingsRow">
						<param name="height" value="78" />
						<param name="textoffsetx" value="24" />
						<param name="text" value="text_primary" />
					</include>
					<label>$LOCALIZE[13281]</label>
					<width>368</width>
				</control>
				<control type="button" id="99">
					<description>Button PVR</description>
					<include content="NaraSettingsRow">
						<param name="height" value="78" />
						<param name="textoffsetx" value="24" />
						<param name="text" value="text_primary" />
					</include>
					<label>$LOCALIZE[19191]</label>
					<width>368</width>
				</control>
				<control type="button" id="100">
					<description>Button Privacy policy</description>
					<include content="NaraSettingsRow">
						<param name="height" value="78" />
						<param name="textoffsetx" value="24" />
						<param name="text" value="text_primary" />
					</include>
					<label>$LOCALIZE[12389]</label>
					<width>368</width>
				</control>
				<control type="button" id="101">
					<description>Button "Thank you!"</description>
					<include content="NaraSettingsRow">
						<param name="height" value="78" />
						<param name="textoffsetx" value="24" />
						<param name="text" value="text_primary" />
					</include>
					<label>$LOCALIZE[12396]</label>
					<width>368</width>
				</control>
				<left>76</left>
				<top>165</top>
				<width>368</width>
				<height>685</height>
			</control>
		</control>
		<include content="TopBar">
			<param name="breadcrumbs_label" value="$LOCALIZE[130]" />
			<param name="sublabel" value="" />
		</include>
		<include>BottomBar</include>
		<control type="group" id="104">
			<bottom>180</bottom>
			<left>0</left>
			<height>350</height>
			<include>OpenClose_Right</include>
			<control type="image">
				<left>553</left>
				<top>30</top>
				<width>1259</width>
				<height>3</height>
				<texture colordiffuse="border_subtle" border="2">dialogs/separator-grey.png</texture>
			</control>
			<control type="grouplist">
				<left>553</left>
				<orientation>vertical</orientation>
				<control type="label">
					<description>Memory Text</description>
					<width>auto</width>
					<height>80</height>
					<label>$LOCALIZE[31030]: $INFO[system.memory(used)] / $INFO[system.memory(total)] - $INFO[system.memory(used.percent)]</label>
					<aligny>top</aligny>
					<textoffsety>40</textoffsety>
					<font>font12</font>
				</control>
				<control type="progress">
					<description>Memory BAR</description>
					<width>1259</width>
					<height>16</height>
					<info>system.memory(used)</info>
				</control>
				<control type="label">
					<description>CPU Text</description>
					<width>auto</width>
					<height>40</height>
					<label>$LOCALIZE[13271] $INFO[System.CPUUsage]</label>
					<aligny>center</aligny>
					<font>font12</font>
					<visible>System.SupportsCPUUsage</visible>
				</control>
				<control type="progress">
					<description>CPU BAR</description>
					<width>1259</width>
					<height>16</height>
					<info>System.CPUUsage</info>
					<visible>System.SupportsCPUUsage</visible>
				</control>
			</control>
			<control type="group">
				<animation effect="slide" end="0,-55" time="0" condition="!System.SupportsCPUUsage">Conditional</animation>
				<control type="label">
					<top>155</top>
					<left>553</left>
					<width>auto</width>
					<height>50</height>
					<aligny>bottom</aligny>
					<textoffsety>10</textoffsety>
					<label>$LOCALIZE[31031]:</label>
					<font>font25_title</font>
				</control>
				<control type="grouplist">
					<description>Kodi build version</description>
					<itemgap>10</itemgap>
					<top>200</top>
					<left>553</left>
					<width>1259</width>
					<orientation>horizontal</orientation>
					<control type="label">
						<description>Build label</description>
						<width>auto</width>
						<height>40</height>
						<font>font12</font>
						<label>$LOCALIZE[144]</label>
					</control>
					<control type="label">
						<description>Kodi Build Version</description>
						<width>auto</width>
						<height>40</height>
						<font>font12</font>
						<label>$INFO[System.BuildVersionShort]$INFO[System.BuildVersionCode, (,)]</label>
						<textcolor>text_primary</textcolor>
					</control>
				</control>
				<control type="grouplist">
					<description>Git version</description>
					<itemgap>10</itemgap>
					<top>235</top>
					<left>553</left>
					<width>1259</width>
					<orientation>horizontal</orientation>
					<control type="label">
						<description>Git label</description>
						<width>auto</width>
						<height>40</height>
						<font>font12</font>
						<label>Git:</label>
					</control>
					<control type="label">
						<description>Git version</description>
						<width>auto</width>
						<height>40</height>
						<font>font12</font>
						<label>$INFO[System.BuildVersionGit]</label>
						<textcolor>text_primary</textcolor>
					</control>
				</control>
				<control type="grouplist">
					<description>Build date</description>
					<itemgap>10</itemgap>
					<top>270</top>
					<left>553</left>
					<width>1259</width>
					<orientation>horizontal</orientation>
					<control type="label">
						<description>kodi Compiled Text</description>
						<width>auto</width>
						<height>40</height>
						<font>font12</font>
						<label>$LOCALIZE[174]</label>
					</control>
					<control type="label" id="53">
						<description>Kodi Build Date</description>
						<width>auto</width>
						<height>40</height>
						<font>font12</font>
						<textcolor>text_primary</textcolor>
					</control>
				</control>
			</control>
		</control>
	</controls>
</window>
