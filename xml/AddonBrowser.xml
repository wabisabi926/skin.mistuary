<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>background</backgroundcolor>
	<views>50</views>
	<controls>
		<include>NaraSettingsBackground</include>
		<include>NaraSettingsSidebar</include>
		<control type="image">
				<left>505</left>
				<top>145</top>
				<width>1355</width>
				<height>830</height>
				<texture colordiffuse="18FFFFFF" border="28">shapes/round28.png</texture>
			</control>
		<!-- Focused addon detail in left sidebar: icon / version / description -->
			<control type="group">
				<left>76</left>
				<top>195</top>
				<width>368</width>
				<height>600</height>
				<visible>Control.HasFocus(50)</visible>
				<control type="image">
					<left>94</left>
					<top>0</top>
					<width>180</width>
					<height>180</height>
					<texture>$INFO[Container(50).ListItem.Icon]</texture>
					<fallback>DefaultAddon.png</fallback>
					<aspectratio>keep</aspectratio>
				</control>
				<control type="label">
					<left>0</left>
					<top>192</top>
					<width>368</width>
					<height>30</height>
					<align>center</align>
					<aligny>center</aligny>
					<font>font13</font>
					<textcolor>text_secondary</textcolor>
					<label>$INFO[Container(50).ListItem.AddonVersion]</label>
				</control>
				<control type="textbox">
					<left>10</left>
					<top>270</top>
					<width>348</width>
					<height>300</height>
					<font>font12</font>
					<textcolor>text_secondary</textcolor>
					<align>left</align>
					<label>$INFO[Container(50).ListItem.AddonDescription]</label>
				</control>
			</control>
			<!-- Filter switches at sidebar bottom -->
			<control type="grouplist" id="9000">
				<left>76</left>
				<top>800</top>
				<width>368</width>
				<height>165</height>
				<itemgap>4</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
				<onleft>50</onleft>
				<onright>50</onright>
				<onup>9000</onup>
				<ondown>9000</ondown>
				<control type="radiobutton" id="7">
					<description>Hide foreign</description>
					<visible>Control.IsEnabled(7)</visible>
					<include>NaraSettingsCategoryButton</include>
					<radiowidth>60</radiowidth>
					<radioheight>34</radioheight>
					<textureradioonfocus colordiffuse="white">settings/switch-on.png</textureradioonfocus>
					<textureradioonnofocus colordiffuse="white">settings/switch-on.png</textureradioonnofocus>
					<textureradioondisabled colordiffuse="text_disabled">settings/switch-on.png</textureradioondisabled>
					<textureradioofffocus colordiffuse="white">settings/switch-off.png</textureradioofffocus>
					<textureradiooffnofocus colordiffuse="white">settings/switch-off.png</textureradiooffnofocus>
					<textureradiooffdisabled colordiffuse="text_disabled">settings/switch-off.png</textureradiooffdisabled>
					<label>$LOCALIZE[25001]</label>
				</control>
				<control type="radiobutton" id="8">
					<description>Hide incompatible</description>
					<visible>Control.IsEnabled(8)</visible>
					<include>NaraSettingsCategoryButton</include>
					<radiowidth>60</radiowidth>
					<radioheight>34</radioheight>
					<textureradioonfocus colordiffuse="white">settings/switch-on.png</textureradioonfocus>
					<textureradioonnofocus colordiffuse="white">settings/switch-on.png</textureradioonnofocus>
					<textureradioondisabled colordiffuse="text_disabled">settings/switch-on.png</textureradioondisabled>
					<textureradioofffocus colordiffuse="white">settings/switch-off.png</textureradioofffocus>
					<textureradiooffnofocus colordiffuse="white">settings/switch-off.png</textureradiooffnofocus>
					<textureradiooffdisabled colordiffuse="text_disabled">settings/switch-off.png</textureradiooffdisabled>
					<label>$LOCALIZE[24999]</label>
				</control>
			</control>
			<control type="panel" id="50">
			<left>525</left>
			<top>165</top>
			<width>1315</width>
			<height>740</height>
			<onleft>9000</onleft>
			<onright>60</onright>
			<onup>50</onup>
			<ondown>50</ondown>
			<pagecontrol>60</pagecontrol>
			<scrolltime>200</scrolltime>
			<itemlayout height="74" width="1315">
				<control type="image">
					<left>12</left>
					<top>11</top>
					<width>52</width>
					<height>52</height>
					<texture>$INFO[ListItem.Icon]</texture>
					<fallback>DefaultAddon.png</fallback>
					<aspectratio>keep</aspectratio>
				</control>
				<control type="label">
					<left>80</left>
					<top>0</top>
					<right>140</right>
					<height>74</height>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<right>16</right>
					<top>0</top>
					<width>120</width>
					<height>74</height>
					<align>right</align>
					<aligny>center</aligny>
					<font>font12</font>
					<textcolor>text_secondary</textcolor>
					<label>$INFO[ListItem.AddonLifecycleType]</label>
				</control>
			</itemlayout>
			<focusedlayout height="74" width="1315">
				<control type="image">
					<left>0</left>
					<top>0</top>
					<right>0</right>
					<height>74</height>
					<visible>Control.HasFocus(50)</visible>
					<include content="NaraDialogFocusTexture" />
				</control>
				<control type="image">
					<left>12</left>
					<top>11</top>
					<width>52</width>
					<height>52</height>
					<texture>$INFO[ListItem.Icon]</texture>
					<fallback>DefaultAddon.png</fallback>
					<colordiffuse>$VAR[NaraDialogFocusLayoutTextColor50Var]</colordiffuse>
					<aspectratio>keep</aspectratio>
				</control>
				<control type="label">
					<left>80</left>
					<top>0</top>
					<right>140</right>
					<height>74</height>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
					<textcolor>$VAR[NaraDialogFocusLayoutTextColor50Var]</textcolor>
					<selectedcolor>$VAR[NaraDialogFocusLayoutTextColor50Var]</selectedcolor>
				</control>
				<control type="label">
					<right>16</right>
					<top>0</top>
					<width>120</width>
					<height>74</height>
					<align>right</align>
					<aligny>center</aligny>
					<font>font12</font>
					<textcolor>text_secondary</textcolor>
					<label>$INFO[ListItem.AddonLifecycleType]</label>
				</control>
			</focusedlayout>
		</control>
		<control type="scrollbar" id="60">
			<left>1874</left>
			<top>165</top>
			<width>8</width>
			<height>740</height>
			<onleft>50</onleft>
			<onright>9000</onright>
			<orientation>vertical</orientation>
		</control>
		<control type="label" id="412">
			<description>Path label</description>
			<left>545</left>
			<bottom>18</bottom>
			<width>700</width>
			<height>30</height>
			<haspath>true</haspath>
			<font>font12</font>
			<aligny>bottom</aligny>
			<textcolor>grey</textcolor>
		</control>
		<control type="label">
			<left>900</left>
			<bottom>18</bottom>
			<width>900</width>
			<height>30</height>
			<align>right</align>
			<aligny>bottom</aligny>
			<textcolor>grey</textcolor>
			<font>font12</font>
			<label>$INFO[Container.NumItems]</label>
		</control>
		<include content="TopBar">
			<param name="breadcrumbs_label" value="$LOCALIZE[24001]" />
		</include>
	</controls>
</window>