<?xml version="1.0" encoding="utf-8"?>
<includes>
	<!-- Cast and collection shelf: isolated for alternate people and media layouts. -->
	<include name="VideoInfoCastShelf">
		<control type="group">
			<left>80</left>
			<top>846</top>
			<width>1760</width>
			<height>200</height>
			<!-- 电影和电视剧统一由动作栏「演员」图标控制：默认收起，点图标展开 -->
			<visible>Integer.IsGreater(Container(50).NumItems,0) + Skin.HasSetting(nara_cast_open)</visible>
			<animation effect="slide" start="0,70" end="0,0" time="400" delay="100" tween="cubic" easing="out">WindowOpen</animation>
			<!-- 通用版：演员栏原本完全没有底板，与动作栏（GlassTint_regular）不一致 -->
			<control type="image">
				<width>1760</width>
				<height>200</height>
				<texture colordiffuse="$VAR[NaraGlassFloatTintVar]" border="28">shapes/round28.png</texture>
			</control>
			<control type="image">
				<width>1760</width>
				<height>200</height>
				<texture colordiffuse="border_subtle">shapes/ring_card_1760x200_r28.png</texture>
			</control>
			<control type="label">
				<width>500</width>
				<height>28</height>
				<font>font20_title</font>
				<label>$LOCALIZE[20457]</label>
				<visible>Container.Content(Sets)</visible>
			</control>
			<control type="panel" id="50">
				<top>24</top>
				<width>1760</width>
				<height>176</height>
				<orientation>horizontal</orientation>
				<scrolltime>220</scrolltime>
				<preloaditems>2</preloaditems>
				<onleft>50</onleft>
				<onright>50</onright>
				<!-- 展开时标签行/剧集面板均隐藏，向上一律回到「演员」图标开关 -->
				<onup>5107</onup>
				<ondown>50</ondown>
				<onclick condition="System.AddonIsEnabled(script.embuary.info) + !String.IsEqual(ListItem.DBType,set)">RunScript(script.embuary.info,call=person,query='$ESCINFO[Container(50).ListItem.Label]')</onclick>
				<onclick condition="System.HasAddon(script.embuary.info) + !System.AddonIsEnabled(script.embuary.info) + !String.IsEqual(ListItem.DBType,set)">EnableAddon(script.embuary.info)</onclick>
				<onclick condition="!System.HasAddon(script.embuary.info) + !String.IsEqual(ListItem.DBType,set)">InstallAddon(script.embuary.info)</onclick>
				<!-- 每项 176 宽，1760 正好 10 个；头像 104，剩下的空间全部留给留白 -->
				<itemlayout height="152" width="176" condition="!Container.Content(Sets)">
					<control type="group">
						<left>0</left>
						<top>0</top>
						<control type="image">
							<left>36</left>
							<width>104</width>
							<height>104</height>
							<aspectratio>stretch</aspectratio>
							<texture colordiffuse="28FFFFFF">masks/circle.png</texture>
						</control>
						<control type="image">
							<left>39</left>
							<top>3</top>
							<width>98</width>
							<height>98</height>
							<aspectratio scalediffuse="false">scale</aspectratio>
							<texture diffuse="masks/circle.png" background="true">$VAR[NaraImgListItemThumbDefDefaultActorSolid]</texture>
						</control>
						<control type="label">
							<top>108</top>
							<width>176</width>
							<height>22</height>
							<font>font12</font>
							<align>center</align>
							<aligny>center</aligny>
							<label>$INFO[ListItem.Label]</label>
						</control>
						<control type="label">
							<top>130</top>
							<width>176</width>
							<height>20</height>
							<font>font10</font>
							<align>center</align>
							<textcolor>text_secondary</textcolor>
							<label>$INFO[ListItem.Label2]</label>
						</control>
					</control>
				</itemlayout>
				<focusedlayout height="152" width="176" condition="!Container.Content(Sets)">
					<control type="group">
						<left>0</left>
						<top>0</top>
						<animation center="88,52" effect="zoom" start="100" end="104" time="150" tween="sine">Focus</animation>
						<control type="image">
							<left>36</left>
							<width>104</width>
							<height>104</height>
							<aspectratio>stretch</aspectratio>
							<texture colordiffuse="focus_media">masks/circle.png</texture>
						</control>
						<control type="image">
							<left>39</left>
							<top>3</top>
							<width>98</width>
							<height>98</height>
							<aspectratio scalediffuse="false">scale</aspectratio>
							<texture diffuse="masks/circle.png" background="true">$VAR[NaraImgListItemThumbDefDefaultActorSolid]</texture>
						</control>
						<control type="label">
							<top>108</top>
							<width>176</width>
							<height>22</height>
							<font>font12</font>
							<align>center</align>
							<aligny>center</aligny>
							<scroll>true</scroll>
							<label>$INFO[ListItem.Label]</label>
						</control>
						<control type="label">
							<top>130</top>
							<width>176</width>
							<height>20</height>
							<font>font10</font>
							<align>center</align>
							<textcolor>text_secondary</textcolor>
							<scroll>true</scroll>
							<label>$INFO[ListItem.Label2]</label>
						</control>
					</control>
				</focusedlayout>
				<itemlayout height="174" width="120" condition="Container.Content(Sets)">
					<control type="group">
						<left>5</left>
						<top>0</top>
						<control type="image">
							<width>110</width>
							<height>150</height>
							<aspectratio>scale</aspectratio>
							<texture background="true">$VAR[NaraImgListItemArtPosterDefDefaultVideo]</texture>
						</control>
						<control type="image">
							<top>105</top>
							<width>110</width>
							<height>45</height>
							<aspectratio>stretch</aspectratio>
							<texture>overlays/overlayfade.png</texture>
						</control>
						<control type="label">
							<left>6</left>
							<top>126</top>
							<width>98</width>
							<height>24</height>
							<font>font10</font>
							<align>center</align>
							<label>$INFO[ListItem.Label]</label>
						</control>
					</control>
				</itemlayout>
				<focusedlayout height="174" width="120" condition="Container.Content(Sets)">
					<control type="group">
						<left>5</left>
						<top>0</top>
						<animation center="55,75" effect="zoom" start="100" end="104" time="160" tween="sine">Focus</animation>
						<control type="image">
							<width>110</width>
							<height>150</height>
							<aspectratio>scale</aspectratio>
							<texture background="true">$VAR[NaraImgListItemArtPosterDefDefaultVideo]</texture>
						</control>
						<control type="image">
							<left>-2.2</left>
							<top>-2.2</top>
							<width>114.4</width>
							<height>154.4</height>
							<texture border="3" infill="false" colordiffuse="focus_media">colors/white.png</texture>
						</control>
						<control type="image">
							<top>105</top>
							<width>110</width>
							<height>45</height>
							<aspectratio>stretch</aspectratio>
							<texture>overlays/overlayfade.png</texture>
						</control>
						<control type="label">
							<left>6</left>
							<top>126</top>
							<width>98</width>
							<height>24</height>
							<font>font10</font>
							<align>center</align>
							<scroll>true</scroll>
							<label>$INFO[ListItem.Label]</label>
						</control>
					</control>
				</focusedlayout>
			</control>
		</control>
	</include>
</includes>
